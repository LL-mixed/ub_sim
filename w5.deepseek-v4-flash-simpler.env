# DeepSeek V4 Flash W5 execution through sim-uapi and the simpler C API.
#
# This profile runs the fixed no-think DeepSeek oracle prompt through all 43
# layers without hiding work behind the DS4 dynamic library. The expected first
# token is 108149 ("Ada").
#
# Run with:
#   ./guest-linux/aarch64/scripts/run_w5_in_container.sh \
#     w5.deepseek-v4-flash-simpler.env
SIM_UAPI_W5_PROFILE=deepseek_v4_flash_decode
SIM_UAPI_W4_CHIPBACKEND_PROFILE=deepseek-v4-flash-simpler
SIM_DEEPSEEK_V4_FLASH=${SIM_DEEPSEEK_V4_FLASH:-../ds4/gguf/DeepSeek-V4-Flash-IQ2XXS-w2Q2K-AProjQ8-SExpQ8-OutQ8-chat-v2-imatrix.gguf}
SIM_QWEN3_GUEST_DECODE_STEPS=1
SIM_LLM_INFER_PROMPT='Rispondi in italiano con una frase: chi era Ada Lovelace?'
SIM_QWEN3_GUEST_ENGRAM=0
SIM_W5_MEMORY_SERVICE=lingqu_memory_service
QEMU_MEM=8G
QEMU_SMP=2
SIM_W5_PROGRESS_INTERVAL_SECS=60
