[submodule "vendor/qemu_8.2.0_ub"]
	path = vendor/qemu_8.2.0_ub
	url = ../qemu.git
	branch = ub_sim
	ignore = all
[submodule "guest-linux/kernel_ub"]
	path = guest-linux/kernel_ub
	url = ../kernel.git
	branch = ub_sim
	ignore = all
[submodule "vendor/simpler"]
	path = vendor/simpler
	url = ../simpler.git
	branch = ub_sim
	ignore = all
[submodule "vendor/pto-isa"]
	path = vendor/pto-isa
	url = ../pto-isa.git
	branch = ub_sim
	ignore = all
[submodule "vendor/pypto"]
	path = vendor/pypto
	url = https://github.com/hw-native-sys/pypto.git
	branch = main
	ignore = all
[submodule "vendor/pypto-lib"]
	path = vendor/pypto-lib
	url = https://github.com/hw-native-sys/pypto-lib.git
	branch = main
	ignore = all
[submodule "mem_service"]
	path = mem_service
	url = https://github.com/LL-mixed/mem_service
