# DeepSeek V4 Flash W5 readiness config.
#
# Host-side readiness without launching QEMU:
#   ./guest-linux/aarch64/scripts/run_w5_cluster_config.sh --readiness-only w5.deepseek-v4-flash.env
#
# Readiness also performs an ARM64 guest link check for llm_infer,
# serving_control, and mem_service_qwen3. It uses AARCH64_LINUX_CC when set,
# otherwise it auto-detects aarch64-*-gnu-gcc from PATH.
#
# Optional measured readiness inputs:
# - Leaving these unset uses checked-in fixture data and requires
#   source_kind=fixture.
# - Setting SIM_W5_TEST_FLASH_ROUTE_TRACE_MANIFEST requires the manifest to
#   declare source_kind=ds4-measured. This prevents a measured-readiness run
#   from silently accepting fixture routing.
# - SIM_W5_TEST_FLASH_WEIGHT_PROVIDER should point at the matching file-backed
#   provider spec for the measured trace.
# - SIM_W5_FLASH_WEIGHT_CATALOG points at a complete 43 x 256 expert weight
#   catalog. When set, readiness and the guest MoE dispatch use the same
#   catalog instead of the compact provider fixture.
#   The run fails if any (layer, expert) tile metadata is missing.
#   When unset, readiness generates a temporary complete catalog from the
#   provider spec and still validates the manifest through --weight-catalog.
#   For real payload files, either let readiness build the temporary catalog:
#     ./guest-linux/aarch64/scripts/run_w5_cluster_config.sh --readiness-only \
#       --flash-payload-dir /path/to/ds4/expert_tiles w5.deepseek-v4-flash.env
#   or build a reusable catalog explicitly with:
#     cargo run --release -p sim-cli -- deepseek-v4-flash-weight-catalog \
#       --payload-dir /path/to/ds4/expert_tiles \
#       --payload-template 'layer{layer}/expert{expert}.{quant}.bin' \
#       --output /path/to/ds4.weight.catalog
#
# SIM_W5_TEST_FLASH_ROUTE_TRACE_MANIFEST=/path/to/ds4.route.manifest
# SIM_W5_TEST_FLASH_WEIGHT_PROVIDER=/path/to/ds4.weight.provider
# SIM_W5_FLASH_WEIGHT_CATALOG=/path/to/ds4.weight.catalog
#
# Full W5 run entrypoint, when QEMU/guest execution is intentionally enabled:
#   ./guest-linux/aarch64/scripts/run_w5_in_container.sh w5.deepseek-v4-flash.env
SIM_UAPI_W5_PROFILE=deepseek_v4_flash_decode
SIM_UAPI_W4_CHIPBACKEND_PROFILE=deepseek-v4-flash
SIM_QWEN3_GUEST_DECODE_STEPS=16
SIM_LLM_INFER_PROMPT_TOKEN_IDS=0,128803,42,5207,24063,344,128804,128822
SIM_QWEN3_GUEST_ENGRAM=0
SIM_W5_MEMORY_SERVICE=lingqu_memory_service
QEMU_MEM=8G
QEMU_SMP=2
SIM_W5_PROGRESS_INTERVAL_SECS=60
