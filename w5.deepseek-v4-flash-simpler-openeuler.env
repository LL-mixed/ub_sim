# DeepSeek V4 Flash 2-bit GGUF validation on openEuler W5 guests.
#
# Run the 8-node, 2-step GSVA KV validation through the stable container
# entrypoint:
#   ./guest-linux/aarch64/scripts/run_w5_in_container.sh -- \
#     --nodes 8 --steps 2 --gsva-kv \
#     w5.deepseek-v4-flash-simpler-openeuler.env
#
# Guest OBMM/GSVA references are run-scoped. Cross-request reuse belongs in a
# live-cluster serving run, not in post-run promotion after QEMU teardown.
SIM_UAPI_W5_PROFILE=deepseek_v4_flash_decode
SIM_UAPI_W4_CHIPBACKEND_PROFILE=deepseek-v4-flash-simpler
SIM_DEEPSEEK_V4_FLASH=${SIM_DEEPSEEK_V4_FLASH:-/models/DeepSeek-V4-Flash/DeepSeek-V4-Flash-IQ2XXS-w2Q2K-AProjQ8-SExpQ8-OutQ8-chat-v2-imatrix.gguf}
SIM_LLM_INFER_PROMPT_TOKEN_IDS=42
SIM_W5_MEMORY_SERVICE=lingqu_memory_service
SIM_W5_GUEST_ENGINE=openEuler
SIM_W5_OE_DISK_IMAGE=${SIM_W5_OE_DISK_IMAGE:-/models/openEuler-2403/rootfs.qcow2}
QEMU_MEM=8G
QEMU_SMP=2
SIM_W5_PROGRESS_INTERVAL_SECS=60
