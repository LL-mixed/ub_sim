# DeepSeek V4 Flash official Safetensors execution through W5 and simpler.
#
# The official profile fails closed unless SIM_DEEPSEEK_V4_FLASH resolves to a
# Safetensors checkpoint directory. It never falls back to GGUF or DS4.
#
# Examples:
#   ./guest-linux/aarch64/scripts/run_w5_cluster_config.sh --nodes 2 --steps 4 \
#     w5.deepseek-v4-flash-official.env
#   ./guest-linux/aarch64/scripts/run_w5_cluster_config.sh --nodes 8 --steps 8 \
#     --model /path/to/DeepSeek-V4-Flash w5.deepseek-v4-flash-official.env
SIM_UAPI_W5_PROFILE=deepseek_v4_flash_decode
SIM_UAPI_W4_CHIPBACKEND_PROFILE=deepseek-v4-flash-official
SIM_DEEPSEEK_V4_FLASH=${SIM_DEEPSEEK_V4_FLASH:-${HOME}/repos/models/ds4_flash}
SIM_QWEN3_GUEST_DECODE_STEPS=4
SIM_LLM_INFER_PROMPT_TOKEN_IDS=1
SIM_QWEN3_GUEST_ENGRAM=0
SIM_W5_MEMORY_SERVICE=lingqu_memory_service
QEMU_MEM=8G
QEMU_SMP=2
SIM_W5_PROGRESS_INTERVAL_SECS=60
