# macOS local W5 smoke config.
#
# This config is intended for:
#   ./guest-linux/aarch64/scripts/run_w5_in_container.sh w5.macos.env
#
# The container entrypoint auto-mounts /Volumes/repos/qwen3_mlx_run when it
# exists on the host, so this host path is also visible inside the container.
SIM_UAPI_W5_PROFILE=qwen3_0_6b_decode
SIM_QWEN3_DENSE_WEIGHTS_PATH=/Volumes/repos/qwen3_mlx_run/Qwen3-0.6B
SIM_QWEN3_GUEST_DECODE_STEPS=8
SIM_QWEN3_SAMPLER_TOP_K=1
SIM_QWEN3_SAMPLER_TOP_P_MILLI=1000
SIM_QWEN3_SAMPLER_TEMPERATURE_MILLI=1000
SIM_QWEN3_SAMPLER_SEED=0
SIM_W5_MEMORY_SERVICE=lingqu_memory_service
QEMU_MEM=8G
QEMU_SMP=2
SIM_W5_PROGRESS_INTERVAL_SECS=60
