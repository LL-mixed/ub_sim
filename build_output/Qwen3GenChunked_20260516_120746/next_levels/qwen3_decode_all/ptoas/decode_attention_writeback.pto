module attributes {pto.target_arch = "a2a3"} {
  func.func @decode_attention_writeback(%arg0: !pto.ptr<bf16>, %arg1: !pto.ptr<bf16>) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
  %c0_i64 = arith.constant 0 : i64
  %c1_index = arith.constant 1 : index
  %c2048_index = arith.constant 2048 : index
  %c16384_index = arith.constant 16384 : index
  %c0_index = arith.constant 0 : index
  %c8_index = arith.constant 8 : index
  %c2_index = arith.constant 2 : index
  %c256_index = arith.constant 256 : index
  %c128_index = arith.constant 128 : index
  %attn_row__ssa_v0_view = pto.make_tensor_view %arg0, shape = [%c1_index, %c2048_index], strides = [%c2048_index, %c1_index] {layout = #pto.layout<nd>}: !pto.tensor_view<?x?xbf16>
  %attn_row_padded__rv_v2_view = pto.make_tensor_view %arg1, shape = [%c1_index, %c16384_index], strides = [%c16384_index, %c1_index] {layout = #pto.layout<nd>}: !pto.tensor_view<?x?xbf16>
  scf.for %gi__idx_v0 = %c0_index to %c8_index step %c1_index {
    %0 = arith.subi %gi__idx_v0, %gi__idx_v0 : index
    %1 = arith.addi %gi__idx_v0, %0 : index
    %2 = arith.muli %1, %c2_index : index
    %ctx_flat_bf16__tile = pto.alloc_tile addr = %c0_i64 valid_row = %c1_index valid_col = %c256_index : !pto.tile_buf<loc=vec, dtype=bf16, rows=1, cols=256, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %3 = arith.muli %gi__idx_v0, %c2048_index : index
    %attn_row_padded__rv_v2_pview = pto.partition_view %attn_row_padded__rv_v2_view, offsets = [%c0_index, %3], sizes = [%c1_index, %c256_index] : !pto.tensor_view<?x?xbf16> -> !pto.partition_tensor_view<1x256xbf16>
    pto.tload ins(%attn_row_padded__rv_v2_pview : !pto.partition_tensor_view<1x256xbf16>) outs(%ctx_flat_bf16__tile : !pto.tile_buf<loc=vec, dtype=bf16, rows=1, cols=256, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    %4 = arith.muli %2, %c128_index : index
    %attn_row__iter_v1_pview = pto.partition_view %attn_row__ssa_v0_view, offsets = [%c0_index, %4], sizes = [%c1_index, %c256_index] : !pto.tensor_view<?x?xbf16> -> !pto.partition_tensor_view<1x256xbf16>
    pto.tstore ins(%ctx_flat_bf16__tile : !pto.tile_buf<loc=vec, dtype=bf16, rows=1, cols=256, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%attn_row__iter_v1_pview : !pto.partition_tensor_view<1x256xbf16>)
  }
  return
  }
}
