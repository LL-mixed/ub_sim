module attributes {pto.target_arch = "a2a3"} {
  func.func @copy_hidden(%arg0: !pto.ptr<bf16>, %arg1: !pto.ptr<bf16>, %arg2: index, %arg3: index, %arg4: index) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
  %c0_i64 = arith.constant 0 : i64
  %c16_index = arith.constant 16 : index
  %c5120_index = arith.constant 5120 : index
  %c1_index = arith.constant 1 : index
  %c0_index = arith.constant 0 : index
  %c40_index = arith.constant 40 : index
  %c128_index = arith.constant 128 : index
  %current_hidden__iter_v1_view = pto.make_tensor_view %arg0, shape = [%c16_index, %c5120_index], strides = [%c5120_index, %c1_index] {layout = #pto.layout<nd>}: !pto.tensor_view<?x?xbf16>
  %hidden_states__ssa_v0_view = pto.make_tensor_view %arg1, shape = [%arg4, %c5120_index], strides = [%c5120_index, %c1_index] {layout = #pto.layout<nd>}: !pto.tensor_view<?x?xbf16>
  scf.for %kb__idx_v0 = %c0_index to %c40_index step %c1_index {
    %0 = arith.muli %kb__idx_v0, %c128_index : index
    %hidden_chunk__tile = pto.alloc_tile addr = %c0_i64 valid_row = %arg3 valid_col = %c128_index : !pto.tile_buf<loc=vec, dtype=bf16, rows=16, cols=128, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %hidden_states__ssa_v0_pview = pto.partition_view %hidden_states__ssa_v0_view, offsets = [%arg2, %0], sizes = [%arg3, %c128_index] : !pto.tensor_view<?x?xbf16> -> !pto.partition_tensor_view<?x128xbf16>
    pto.tload ins(%hidden_states__ssa_v0_pview : !pto.partition_tensor_view<?x128xbf16>) outs(%hidden_chunk__tile : !pto.tile_buf<loc=vec, dtype=bf16, rows=16, cols=128, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    %current_hidden__iter_v3_pview = pto.partition_view %current_hidden__iter_v1_view, offsets = [%arg2, %0], sizes = [%arg3, %c128_index] : !pto.tensor_view<?x?xbf16> -> !pto.partition_tensor_view<?x128xbf16>
    pto.tstore ins(%hidden_chunk__tile : !pto.tile_buf<loc=vec, dtype=bf16, rows=16, cols=128, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%current_hidden__iter_v3_pview : !pto.partition_tensor_view<?x128xbf16>)
  }
  return
  }
}
