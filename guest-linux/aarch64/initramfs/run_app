# T-share object share (M1.2 cross-guest managed object lifecycle). nodeA
# (linqu_node_idx=0) runs the control-plane daemon on the trusted guest
# network plus concurrent producer/provider object-sessions; nodeB
# (linqu_node_idx=1) runs the consumer object-session with data-plane
# map/write/read through the selected provider backend. backend=loopback
# exercises the full deterministic choreography with an in-process fixed
# address mapping; backend=obmm maps the real exported GSVA region and
# requires a descriptor published via mem_service_object_share_descriptor_hex.
mem_service_object_share_wait_daemon() {
  local connect="$1"
  local daemon_pid="$2"
  local i=0
  local health_out=""
  local uptime=""
  local ignored=""
  local deadline=0

  read -r uptime ignored </proc/uptime
  deadline=$((${uptime%%.*} + 60))

  while true; do
    health_out="$(/bin/linqu_mem_service health --connect "$connect" \
      --timeout-ms 1000 --max-attempts 1 2>&1)"
    case "$health_out" in
      *status=ok*) return 0 ;;
    esac
    if [ -n "$daemon_pid" ] && ! kill -0 "$daemon_pid" >/dev/null 2>&1; then
      return 1
    fi
    i=$((i + 1))
    read -r uptime ignored </proc/uptime
    if [ "${uptime%%.*}" -ge "$deadline" ] || [ "$i" -ge 1200 ]; then
      log "managed daemon readiness timed out: $health_out"
      return 1
    fi
    sleep 0.05
  done
}

mem_service_object_share_run_provider() {
  local backend="$1"
  local size="$2"
  local iterations="$3"
  local port="$4"
  local incarnation="$5"
  local address="$6"
  local descriptor_hex="$7"
  local connect="$8"
  local daemon_conf="/tmp/mem_service_object_share.daemon.conf"
  local store="/tmp/mem_service_object_share.store"
  local daemon_pid=""
  local i=1
  local key=""
  local barrier_key=""
  local gen_obj=0
  local gen_barrier=0
  local desc="$descriptor_hex"
  local producer_conf=""
  local provider_conf=""
  local producer_log=""
  local provider_log=""
  local producer_pid=""
  local provider_pid=""
  local producer_rc=0
  local provider_rc=0

  if [ -z "$desc" ]; then
    # The loopback provider maps the published fixed address in-process and
    # never decodes descriptor bytes, so a placeholder descriptor is fine.
    desc="deadbeef"
  fi

  {
    echo "listen=tcp:10.0.0.1:$port"
    echo "store=$store"
    echo "node_id=guest-node-0"
    echo "cluster_id=linqu-object-share"
    echo "auth_mode=trusted-guest-network"
    echo "network_peer=guest-node-0@10.0.0.1"
    echo "network_peer=guest-node-1@10.0.0.2"
    echo "required_provider=guest-node-0"
    echo "provider_lease_ms=120000"
    echo "allocation_home_provider=guest-node-0"
  } > "$daemon_conf"

  /bin/busybox rm -f "$store" "$store.journal"
  log "start linqu_mem_service daemon for mem_service object share"
  /bin/linqu_mem_service serve --config "$daemon_conf" \
    >/tmp/mem_service_object_share.daemon.stdout \
    2>/tmp/mem_service_object_share.daemon.stderr &
  daemon_pid=$!

  if ! mem_service_object_share_wait_daemon "$connect" "$daemon_pid"; then
    /bin/busybox cat /tmp/mem_service_object_share.daemon.stderr >&2 || true
    kill "$daemon_pid" >/dev/null 2>&1 || true
    wait "$daemon_pid" >/dev/null 2>&1 || true
    log "mem_service object-share: status=fail node=0 role=provider backend=$backend reason=daemon_ready"
    return 1
  fi

  if ! /bin/linqu_mem_service provider-register --connect "$connect" \
      --node-id guest-node-0 --incarnation "$incarnation" \
      --readiness-generation 1 --capabilities 1; then
    kill "$daemon_pid" >/dev/null 2>&1 || true
    wait "$daemon_pid" >/dev/null 2>&1 || true
    log "mem_service object-share: status=fail node=0 role=provider backend=$backend reason=provider_register"
    return 1
  fi
  if ! /bin/linqu_mem_service status --connect "$connect"; then
    kill "$daemon_pid" >/dev/null 2>&1 || true
    wait "$daemon_pid" >/dev/null 2>&1 || true
    log "mem_service object-share: status=fail node=0 role=provider backend=$backend reason=status"
    return 1
  fi

  while [ "$i" -le "$iterations" ]; do
    key="obj-share-$i"
    barrier_key="barrier-share-$i"
    # Allocation generations come from the daemon table-level counter: the
    # shared object is allocated first, the consumer barrier second.
    gen_obj=$((2 * i - 1))
    gen_barrier=$((2 * i))
    producer_conf="/tmp/mem_service_object_share.producer.$i.conf"
    provider_conf="/tmp/mem_service_object_share.provider.$i.conf"
    producer_log="/tmp/mem_service_object_share.producer.$i.log"
    provider_log="/tmp/mem_service_object_share.provider.$i.log"

    {
      echo "session_id=producer"
      echo "connect=$connect"
      echo "op=allocate key=$key idempotency_key=p-alloc-$i size_bytes=$size capabilities=map"
      echo "op=wait_state key=$key state=active timeout_ms=60000 poll_ms=100"
      echo "op=wait_state key=$barrier_key state=allocating timeout_ms=60000 poll_ms=100"
      echo "op=retire key=$key idempotency_key=p-ret-$i expected_generation=$gen_obj"
      echo "op=wait_state key=$key state=retired timeout_ms=60000 poll_ms=100"
      echo "op=wait_state key=$barrier_key state=retired timeout_ms=60000 poll_ms=100"
      echo "op=stats"
    } > "$producer_conf"

    {
      echo "session_id=provider"
      echo "connect=$connect"
      echo "op=wait_state key=$key state=allocating timeout_ms=60000 poll_ms=100"
      echo "op=publish key=$key node_id=guest-node-0 incarnation=$incarnation generation=$gen_obj descriptor_hex=$desc address=$address address_len=$size"
      echo "op=wait_state key=$key state=retiring timeout_ms=60000 poll_ms=100"
      echo "op=wait_state key=$barrier_key state=retired timeout_ms=60000 poll_ms=100"
      echo "op=reclaim key=$key node_id=guest-node-0 incarnation=$incarnation generation=$gen_obj confirmed=1"
    } > "$provider_conf"

    /bin/linqu_mem_service object-session --config "$producer_conf" \
      >"$producer_log" 2>&1 &
    producer_pid=$!
    /bin/linqu_mem_service object-session --config "$provider_conf" \
      >"$provider_log" 2>&1 &
    provider_pid=$!
    wait "$producer_pid"
    producer_rc=$?
    wait "$provider_pid"
    provider_rc=$?
    /bin/busybox cat "$producer_log"
    /bin/busybox cat "$provider_log"
    if [ "$producer_rc" -ne 0 ] || [ "$provider_rc" -ne 0 ]; then
      kill "$daemon_pid" >/dev/null 2>&1 || true
      wait "$daemon_pid" >/dev/null 2>&1 || true
      log "mem_service object-share: status=fail node=0 role=provider backend=$backend reason=session iteration=$i"
      return 1
    fi
    i=$((i + 1))
  done

  kill "$daemon_pid" >/dev/null 2>&1 || true
  wait "$daemon_pid" >/dev/null 2>&1 || true
  log "mem_service object-share: status=ok node=0 role=provider backend=$backend"
  return 0
}

mem_service_object_share_run_consumer() {
  local backend="$1"
  local size="$2"
  local fault="$3"
  local iterations="$4"
  local seed="$5"
  local connect="$6"
  local provider_line="provider=session-loopback"
  local i=1
  local key=""
  local barrier_key=""
  local gen_obj=0
  local gen_barrier=0
  local consumer_conf=""
  local consumer_log=""
  local consumer_rc=0

  if [ "$backend" = "obmm" ]; then
    provider_line="provider=obmm"
  fi

  if ! mem_service_object_share_wait_daemon "$connect" ""; then
    log "mem_service object-share: status=fail node=1 role=consumer backend=$backend reason=daemon_reachable"
    return 1
  fi

  while [ "$i" -le "$iterations" ]; do
    key="obj-share-$i"
    barrier_key="barrier-share-$i"
    gen_obj=$((2 * i - 1))
    gen_barrier=$((2 * i))
    consumer_conf="/tmp/mem_service_object_share.consumer.$i.conf"
    consumer_log="/tmp/mem_service_object_share.consumer.$i.log"

    {
      echo "session_id=consumer"
      echo "connect=$connect"
      echo "$provider_line"
      echo "op=wait_state key=$key state=active timeout_ms=60000 poll_ms=100"
      echo "op=acquire key=$key idempotency_key=c-acq-$i expected_generation=$gen_obj"
      echo "op=inspect key=$key expect_state=active expect_generation=$gen_obj expect_holder_count=1"
      echo "op=map key=$key flags=readwrite"
      echo "op=write key=$key offset=0 len=$size seed=$seed"
      echo "op=read key=$key offset=0 len=$size seed=$seed"
      if [ "$fault" = "read_mismatch" ]; then
        echo "op=read key=$key offset=0 len=$size seed=$((seed + 1)) expect_status=checksum_mismatch"
      fi
      echo "op=unmap key=$key"
      echo "op=allocate key=$barrier_key idempotency_key=c-bar-$i size_bytes=$size capabilities=map"
      echo "op=wait_state key=$key state=retiring timeout_ms=60000 poll_ms=100"
      echo "op=release key=$key idempotency_key=c-rel-$i expected_generation=$gen_obj"
      echo "op=retire key=$barrier_key idempotency_key=c-bar-ret-$i expected_generation=$gen_barrier"
    } > "$consumer_conf"

    /bin/linqu_mem_service object-session --config "$consumer_conf" \
      >"$consumer_log" 2>&1
    consumer_rc=$?
    /bin/busybox cat "$consumer_log"
    if [ "$consumer_rc" -ne 0 ]; then
      log "mem_service object-share: status=fail node=1 role=consumer backend=$backend reason=session iteration=$i"
      return 1
    fi
    i=$((i + 1))
  done

  log "mem_service object-share: status=ok node=1 role=consumer backend=$backend"
  return 0
}

mem_service_object_share_contract_ops() (
  if [ "$1" = "descriptor_contract" ]; then
    case "$2" in
      acquired)
        for byte in 0 4 8 12 16 24 32 40 44 48 56 64 68 72 76 80 84 88 92 95; do
          echo "op=map key=$3 flags=read fault=descriptor fault_byte=$byte expect_status=stale_ref"
        done
        for field in descriptor_length descriptor_oversize address address_len size alignment capabilities home incarnation; do
          echo "op=map key=$3 flags=read fault=$field expect_status=stale_ref"
        done
        ;;
      readonly) echo "op=probe_descriptor key=$3" ;;
      writable|written|released) ;;
      *) exit 2 ;;
    esac
    exit 0
  fi
  if [ "$1" = "map_conflict" ]; then
    case "$2" in
      readonly) echo "op=probe_conflict key=$3" ;;
      acquired|writable|written|released) ;;
      *) exit 2 ;;
    esac
    exit 0
  fi
  [ "$1" = "sdk_contract" ] || exit 0
  stage="$2"
  key="$3"
  size="$4"
  seed="$5"
  identity="$6"
  case "$stage" in
    acquired)
      echo "op=acquire key=absent-$key idempotency_key=absent-$identity expect_status=not_found"
      echo "op=acquire key=$key idempotency_key=stale-$identity expected_generation=18446744073709551615 expect_status=stale_ref"
      echo "op=acquire key=$key idempotency_key=$identity"
      ;;
    readonly)
      echo "op=write key=$key offset=0 len=1 seed=$seed expect_status=unsupported"
      ;;
    writable)
      for action in read write publish_data wait_visible; do
        echo "op=$action key=$key offset=$size len=1 seed=$seed expect_status=capacity_exceeded"
      done
      echo "op=release key=$key idempotency_key=early-$identity expect_status=internal"
      ;;
    written)
      echo "op=read key=$key offset=0 len=1 seed=$((seed ^ 1)) expect_status=checksum_mismatch"
      ;;
    released)
      echo "op=release key=$key idempotency_key=$identity"
      ;;
    *) exit 2 ;;
  esac
)

mem_service_object_share_capacity_pressure() (
  connect="$1"
  attempt=0
  while [ "$attempt" -lt 120 ]; do
    if /bin/linqu_mem_service inspect-allocation --connect "$connect" \
        --key obj-returned-1 --timeout-ms 2000 >/tmp/capacity-barrier.log 2>&1 &&
        grep -q '^state=active$' /tmp/capacity-barrier.log; then
      break
    fi
    attempt=$((attempt + 1))
    sleep 1
  done
  [ "$attempt" -lt 120 ] || exit 1
  attempt=0
  while [ "$attempt" -lt 80 ]; do
    attempt=$((attempt + 1))
    if /bin/linqu_mem_service retire-object --connect "$connect" \
        --key capacity-probe-missing --idempotency-key "capacity-pressure-$attempt" \
        --timeout-ms 2000 >/tmp/capacity-pressure.log 2>&1; then
      exit 1
    fi
    if grep -q '^status=capacity_exceeded$' /tmp/capacity-pressure.log; then
      echo "mem_service capacity-pressure: phase=saturated attempts=$attempt"
      /bin/linqu_mem_service allocation-stats --connect "$connect" || exit 1
      /bin/linqu_mem_service retire-object --connect "$connect" \
        --key obj-returned-1 --idempotency-key capacity-barrier-release || exit 1
      echo "mem_service capacity-pressure: phase=released status=ok"
      exit 0
    fi
    grep -q '^status=not_found$' /tmp/capacity-pressure.log || exit 1
  done
  exit 1
)

mem_service_object_share_address_pressure() (
  connect="$1"
  {
    echo "session_id=address-pressure"
    echo "connect=$connect"
    echo "request_timeout_ms=30000"
    echo "op=wait_state key=obj-returned-1 state=active timeout_ms=60000 poll_ms=50"
    echo "op=allocate key=address-overflow idempotency_key=address-overflow size_bytes=18446744073709551615 capabilities=map"
    echo "op=wait_state key=address-overflow state=retired timeout_ms=60000 poll_ms=50"
    echo "op=allocate key=address-alignment idempotency_key=address-alignment size_bytes=1 alignment_bytes=9223372036854775808 capabilities=map"
    echo "op=wait_state key=address-alignment state=retired timeout_ms=60000 poll_ms=50"
    echo "op=allocate key=address-fill idempotency_key=address-fill size_bytes=8388608 alignment_bytes=8388608 capabilities=map"
    echo "op=wait_state key=address-fill state=active timeout_ms=60000 poll_ms=50"
  } >/tmp/address-pressure-fill.conf
  /bin/linqu_mem_service object-session --config /tmp/address-pressure-fill.conf || exit 1
  echo "mem_service address-pressure: phase=filled"
  for key in obj-share-1 obj-sent-1 obj-returned-1 address-fill address-overflow address-alignment; do
    /bin/linqu_mem_service inspect-allocation --connect "$connect" --key "$key" || exit 1
  done
  /bin/linqu_mem_service allocation-stats --connect "$connect" || exit 1
  {
    echo "session_id=address-pressure"
    echo "connect=$connect"
    echo "request_timeout_ms=30000"
    echo "op=allocate key=address-exhausted idempotency_key=address-exhausted size_bytes=1 capabilities=map"
    echo "op=wait_state key=address-exhausted state=retired timeout_ms=60000 poll_ms=50"
    echo "op=retire key=address-fill idempotency_key=address-fill-retire"
    echo "op=wait_state key=address-fill state=retired timeout_ms=60000 poll_ms=50"
    echo "op=allocate key=address-no-reuse idempotency_key=address-no-reuse size_bytes=1 capabilities=map"
    echo "op=wait_state key=address-no-reuse state=retired timeout_ms=60000 poll_ms=50"
  } >/tmp/address-pressure-drain.conf
  /bin/linqu_mem_service object-session --config /tmp/address-pressure-drain.conf || exit 1
  echo "mem_service address-pressure: phase=rejected"
  for key in address-fill address-exhausted address-no-reuse; do
    /bin/linqu_mem_service inspect-allocation --connect "$connect" --key "$key" || exit 1
  done
  /bin/linqu_mem_service allocation-stats --connect "$connect" || exit 1
  /bin/linqu_mem_service retire-object --connect "$connect" --key obj-returned-1 \
    --idempotency-key address-barrier-release || exit 1
