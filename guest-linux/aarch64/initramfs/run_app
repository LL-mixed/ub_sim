)

mem_service_object_share_backing_snapshot() (
  echo "mem_service backing-pressure: phase=$2"
  /bin/linqu_mem_service allocation-stats --connect "$1" || exit 1
  pool=/sys/kernel/obmm_mempool/obmm-0
  read -r total <"$pool/total" || exit 1
  read -r used <"$pool/used" || exit 1
  read -r ready <"$pool/available_cleared" || exit 1
  echo "mem_service backing-pool: phase=$2 total=$((total)) used=$((used)) ready=$((ready)) consistency=non_atomic"
)

mem_service_object_share_backing_pressure() (
  connect="$1"
  {
    echo "session_id=backing-pressure"
    echo "connect=$connect"
    echo "request_timeout_ms=30000"
    echo "op=wait_state key=obj-returned-1 state=active timeout_ms=60000 poll_ms=50"
  } >/tmp/backing-pressure-begin.conf
  /bin/linqu_mem_service object-session --config /tmp/backing-pressure-begin.conf || exit 1
  /bin/linqu_mem_service inspect-allocation --connect "$connect" --key obj-share-1 \
    >/tmp/backing-pressure-active.log || exit 1
  address=$(/bin/busybox sed -n 's/^address=//p' /tmp/backing-pressure-active.log)
  /bin/linqu_gva_manager --query --home-va "$address" >/tmp/backing-pressure-query.log 2>&1 || exit 1
  segment=$(/bin/busybox sed -n 's/.*result=done action=gsva-segment-query segment_id=\([^ ]*\).*/\1/p' /tmp/backing-pressure-query.log)
  epoch=$(/bin/busybox sed -n 's/.*result=done action=gsva-segment-query .* epoch=\([^ ]*\).*/\1/p' /tmp/backing-pressure-query.log)
  if /bin/linqu_gva_manager --retire --segment-id "$segment" --epoch "$epoch" \
      >/tmp/backing-pressure-retire.log 2>&1; then
    exit 1
  fi
  grep -q 'result=fail action=gsva-segment-retire errno=16' /tmp/backing-pressure-retire.log || exit 1
  /bin/linqu_gva_manager --check-export-identity --segment-id "$segment" || exit 1
  /bin/linqu_gva_manager --query --segment-id "$segment" || exit 1
  echo "mem_service backing-pin: segment=$segment epoch=$epoch errno=16"
  mem_service_object_share_backing_snapshot "$connect" before || exit 1
  {
    echo "session_id=backing-pressure"
    echo "connect=$connect"
    echo "request_timeout_ms=30000"
    echo "op=allocate key=backing-empty idempotency_key=backing-empty size_bytes=2147483648 capabilities=map"
    echo "op=wait_state key=backing-empty state=retired timeout_ms=60000 poll_ms=50"
  } >/tmp/backing-pressure-empty.conf
  /bin/linqu_mem_service object-session --config /tmp/backing-pressure-empty.conf || exit 1
  mem_service_object_share_backing_snapshot "$connect" rejected || exit 1
  /bin/linqu_mem_service inspect-allocation --connect "$connect" --key backing-empty || exit 1
  # FAST uses cleared cached pages only. Wait for background clearing after rollback.
  attempt=0
  while [ "$attempt" -lt 30 ]; do
    read -r ready </sys/kernel/obmm_mempool/obmm-0/available_cleared || exit 1
    [ "$((ready))" -lt 2097152 ] || break
    attempt=$((attempt + 1))
    sleep 1
  done
  [ "$attempt" -lt 30 ] || exit 1
  {
    echo "session_id=backing-pressure"
    echo "connect=$connect"
    echo "request_timeout_ms=30000"
    echo "op=allocate key=backing-recovered idempotency_key=backing-recovered size_bytes=65536 capabilities=map"
    echo "op=wait_state key=backing-recovered state=active timeout_ms=60000 poll_ms=50"
  } >/tmp/backing-pressure-recover.conf
  /bin/linqu_mem_service object-session --config /tmp/backing-pressure-recover.conf || exit 1
  mem_service_object_share_backing_snapshot "$connect" recovered || exit 1
  /bin/linqu_mem_service inspect-allocation --connect "$connect" --key backing-recovered || exit 1
  {
    echo "session_id=backing-pressure"
    echo "connect=$connect"
    echo "request_timeout_ms=30000"
    echo "op=retire key=backing-recovered idempotency_key=backing-recovered-retire"
    echo "op=wait_state key=backing-recovered state=retired timeout_ms=60000 poll_ms=50"
  } >/tmp/backing-pressure-drain.conf
  /bin/linqu_mem_service object-session --config /tmp/backing-pressure-drain.conf || exit 1
  mem_service_object_share_backing_snapshot "$connect" drained || exit 1
  /bin/linqu_mem_service retire-object --connect "$connect" --key obj-returned-1 \
    --idempotency-key backing-barrier-release || exit 1
  echo "mem_service backing-pressure: phase=complete"
)

mem_service_object_share_allocation_snapshot() (
  connect="$1"
  phase="$2"
  shift 2
  echo "mem_service allocation-pressure: phase=$phase"
  /bin/linqu_mem_service allocation-stats --connect "$connect" || exit 1
  read -r used </sys/kernel/obmm_mempool/obmm-0/used || exit 1
  echo "mem_service allocation-pool: phase=$phase used=$((used)) consistency=non_atomic"
  for key in "$@"; do
    view="/tmp/allocation-view-$key.log"
    /bin/linqu_mem_service inspect-allocation --connect "$connect" --key "$key" >"$view" || exit 1
    cat "$view"
    address=$(/bin/busybox sed -n 's/^address=//p' "$view")
    [ -n "$address" ] || exit 1
    [ "$address" != "0" ] || continue
    /bin/linqu_gva_manager --query --home-va "$address" >/tmp/allocation-query.log 2>&1 || exit 1
    # Retain identity/geometry without printing the query's token value.
    /bin/busybox sed -n "s/.*gsva descriptor action=query version=1 flags=[^ ]* segment_id=\\([^ ]*\\) home_va=\\([^ ]*\\) size=\\([^ ]*\\) epoch=\\([^ ]*\\) .*/mem_service allocation-segment: key=$key segment=\\1 address=\\2 size=\\3 epoch=\\4/p" /tmp/allocation-query.log
  done
)

mem_service_object_share_allocation_pressure() (
  connect="$1"
  pids=""
  cleanup_allocation_pressure() {
    [ -n "$pids" ] || return 0
    for pid in $pids; do kill "$pid" 2>/dev/null || true; done
    for pid in $pids; do wait "$pid" 2>/dev/null || true; done
    for index in 1 2 3; do
      [ ! -f "/tmp/allocation-client-$index.log" ] || cat "/tmp/allocation-client-$index.log"
    done
  }
  trap cleanup_allocation_pressure EXIT
  trap 'exit 1' INT TERM
  {
    echo "session_id=allocation-pressure"
    echo "connect=$connect"
    echo "request_timeout_ms=30000"
    echo "op=wait_state key=obj-returned-1 state=active timeout_ms=60000 poll_ms=50"
  } >/tmp/allocation-pressure-begin.conf
  /bin/linqu_mem_service object-session --config /tmp/allocation-pressure-begin.conf || exit 1
  mem_service_object_share_allocation_snapshot "$connect" before \
    obj-share-1 obj-sent-1 obj-returned-1 || exit 1
  for index in 1 2 3; do
    case "$index" in
      1) bytes=1; alignment=2097152 ;;
      2) bytes=2097153; alignment=4194304 ;;
      3) bytes=4194305; alignment=8388608 ;;
    esac
    {
      echo "session_id=allocation-client-$index"
      echo "connect=$connect"
      echo "request_timeout_ms=30000"
      echo "op=allocate key=allocation-$index idempotency_key=allocation-$index size_bytes=$bytes alignment_bytes=$alignment capabilities=map"
      echo "op=wait_state key=allocation-$index state=active timeout_ms=60000 poll_ms=50"
      echo "op=allocate key=allocation-$index idempotency_key=allocation-$index size_bytes=$bytes alignment_bytes=$alignment capabilities=map"
      echo "op=wait_state key=allocation-$index state=retired timeout_ms=60000 poll_ms=50"
    } >"/tmp/allocation-client-$index.conf"
    /bin/linqu_mem_service object-session --config "/tmp/allocation-client-$index.conf" \
      >"/tmp/allocation-client-$index.log" 2>&1 &
    pids="${pids:+$pids }$!"
  done
  attempt=0
  while [ "$attempt" -lt 30 ]; do
    complete=0
    for index in 1 2 3; do
      count=$(grep -c "action=allocate key=allocation-$index status=ok " "/tmp/allocation-client-$index.log")
      [ "$count" != "2" ] || complete=$((complete + 1))
    done
    [ "$complete" != "3" ] || break
    for pid in $pids; do kill -0 "$pid" 2>/dev/null || exit 1; done
    sleep 1
    attempt=$((attempt + 1))
  done
  [ "$complete" = "3" ] || exit 1
  mem_service_object_share_allocation_snapshot "$connect" live \
    allocation-1 allocation-2 allocation-3 || exit 1
  index=1
  for pid in $pids; do
    kill -0 "$pid" 2>/dev/null || exit 1
    echo "mem_service allocation-client: index=$index pid=$pid phase=waiting"
    index=$((index + 1))
  done
  /bin/linqu_mem_service retire-object --connect "$connect" --key allocation-2 \
    --idempotency-key allocation-retire-2 || exit 1
  {
    echo "session_id=allocation-pressure"
    echo "connect=$connect"
    echo "request_timeout_ms=30000"
    echo "op=wait_state key=allocation-2 state=retired timeout_ms=60000 poll_ms=50"
  } >/tmp/allocation-pressure-hole.conf
  /bin/linqu_mem_service object-session --config /tmp/allocation-pressure-hole.conf || exit 1
  mem_service_object_share_allocation_snapshot "$connect" hole allocation-2 || exit 1
  {
    echo "session_id=allocation-pressure"
    echo "connect=$connect"
    echo "request_timeout_ms=30000"
    echo "op=allocate key=allocation-4 idempotency_key=allocation-4 size_bytes=3145728 alignment_bytes=4194304 capabilities=map"
    echo "op=wait_state key=allocation-4 state=active timeout_ms=60000 poll_ms=50"
  } >/tmp/allocation-pressure-replace.conf
  /bin/linqu_mem_service object-session --config /tmp/allocation-pressure-replace.conf || exit 1
  mem_service_object_share_allocation_snapshot "$connect" replaced allocation-4 || exit 1
  {
    echo "session_id=allocation-pressure"
    echo "connect=$connect"
    echo "request_timeout_ms=30000"
    for index in 1 3 4; do
      echo "op=retire key=allocation-$index idempotency_key=allocation-retire-$index"
      echo "op=wait_state key=allocation-$index state=retired timeout_ms=60000 poll_ms=50"
    done
  } >/tmp/allocation-pressure-drain.conf
  /bin/linqu_mem_service object-session --config /tmp/allocation-pressure-drain.conf || exit 1
  mem_service_object_share_allocation_snapshot "$connect" drained \
    allocation-1 allocation-2 allocation-3 allocation-4 || exit 1
  index=1
  for pid in $pids; do
    wait "$pid"
    code=$?
    pids=${pids#"$pid"}
    pids=${pids# }
    cat "/tmp/allocation-client-$index.log"
    echo "mem_service allocation-client: index=$index pid=$pid phase=exited code=$code"
    [ "$code" = "0" ] || exit 1
    index=$((index + 1))
  done
  /bin/linqu_mem_service retire-object --connect "$connect" --key obj-returned-1 \
    --idempotency-key allocation-barrier-release || exit 1
  echo "mem_service allocation-pressure: phase=complete"
)

mem_service_object_share_managed() (
  node="$1"
  size="$2"
  iterations="$3"
  seed="$4"
  port="$5"
  incarnation="$6"
  fault="$7"
  connect="tcp:10.0.0.1:$port"
  daemon_pid=""
  worker_pid=""
  capacity_pid=""
  pressure_barrier=0
  aperture_size=0x1000000
  case "$fault" in
    capacity|address_capacity|backing_capacity|allocation_pressure) pressure_barrier=1 ;;
  esac
  [ "$fault" != "backing_capacity" ] || aperture_size=0x100000000
  [ "$fault" != "allocation_pressure" ] || aperture_size=0x4000000
  cleanup_managed_share() {
    if [ -n "$capacity_pid" ]; then
      kill "$capacity_pid" 2>/dev/null || true
      wait "$capacity_pid" 2>/dev/null || true
    fi
    if [ -n "$worker_pid" ]; then
      kill "$worker_pid" 2>/dev/null || true
      wait "$worker_pid" 2>/dev/null || true
    fi
    if [ -n "$daemon_pid" ]; then
      kill "$daemon_pid" 2>/dev/null || true
      wait "$daemon_pid" 2>/dev/null || true
    fi
  }
  trap cleanup_managed_share EXIT
  # Self-connections to the node's configured address use the local route.
  # BusyBox initramfs does not bring loopback up automatically.
  /bin/busybox ip link set lo up || exit 1
  if [ "$node" = "0" ]; then
    {
      echo "listen=$connect"
      echo "store=/tmp/managed-share.store"
      echo "node_id=guest-node-0"
      echo "cluster_id=managed-share"
      echo "auth_mode=trusted-guest-network"
      echo "network_peer=guest-node-0@10.0.0.1"
      echo "network_peer=guest-node-1@10.0.0.2"
      echo "required_provider=guest-node-0"
      echo "required_provider=guest-node-1"
      echo "allocation_home_provider=guest-node-0"
      echo "provider_lease_ms=30000"
    } >/tmp/managed-share.daemon.conf
    /bin/linqu_mem_service serve --config /tmp/managed-share.daemon.conf &
    daemon_pid=$!
  fi
  /bin/linqu_gva_manager --bootstrap --node-id "$node" --node-count 2 \
    --generation "$incarnation" --aperture-base 0x700000000000 \
    --aperture-size "$aperture_size" || exit 1
  /bin/linqu_mem_service_obmm_provider_conformance --node-id "$node" \
    --node-count 2 --generation "$incarnation" || exit 1
  echo "mem_service kernel-regions: phase=baseline"
  /bin/linqu_gva_manager --dump-obmm-regions || exit 1
  mem_service_object_share_wait_daemon "$connect" "$daemon_pid" || exit 1
  /bin/linqu_mem_service provider-register --connect "$connect" \
    --node-id "guest-node-$node" --incarnation "$incarnation" \
    --readiness-generation "$incarnation" --capabilities 1 || exit 1
  {
    echo "connect=$connect"
    echo "node_id=guest-node-$node"
    echo "incarnation=$incarnation"
    echo "readiness_generation=$incarnation"
    echo "state_file=/tmp/managed-share.worker.state"
    echo "allocation_granularity_bytes=2097152"
    [ "$fault" != "backing_capacity" ] || echo "fast_allocation=1"
  } >/tmp/managed-share.worker.conf
  /bin/linqu_mem_service_provider_obmm serve-allocations \
    --config /tmp/managed-share.worker.conf &
  worker_pid=$!
  if [ "$node" = "0" ] && [ "$fault" = "capacity" ]; then
    mem_service_object_share_capacity_pressure "$connect" &
    capacity_pid=$!
  fi
  if [ "$node" = "0" ] && [ "$fault" = "address_capacity" ]; then
    mem_service_object_share_address_pressure "$connect" &
    capacity_pid=$!
  fi
  if [ "$node" = "0" ] && [ "$fault" = "backing_capacity" ]; then
    mem_service_object_share_backing_pressure "$connect" &
    capacity_pid=$!
  fi
  if [ "$node" = "0" ] && [ "$fault" = "allocation_pressure" ]; then
    mem_service_object_share_allocation_pressure "$connect" &
    capacity_pid=$!
  fi
  i=1
  while [ "$i" -le "$iterations" ]; do
    config="/tmp/managed-share.session.$i.conf"
    key="obj-share-$i"
    sent="obj-sent-$i"
    returned="obj-returned-$i"
    {
      echo "session_id=client-$node"
      echo "connect=$connect"
      echo "request_timeout_ms=30000"
      echo "provider=obmm"
      echo "provider_node_id=$node"
      echo "provider_node_count=2"
      echo "provider_generation=$((incarnation + i))"
      echo "provider_import_region_bytes=2097152"
      if [ "$node" = "0" ]; then
        alignment=0
        [ "$fault" != "address_capacity" ] || alignment=4194304
        echo "op=allocate key=$key idempotency_key=alloc-$i size_bytes=$size alignment_bytes=$alignment capabilities=map"
        echo "op=wait_state key=$key state=active timeout_ms=60000 poll_ms=50"
        echo "op=acquire key=$key idempotency_key=acq-a-$i"
        mem_service_object_share_contract_ops "$fault" acquired "$key" "$size" "$seed" "acq-a-$i"
        echo "op=stats"
        echo "op=map key=$key flags=read"
        echo "op=stats"
        echo "op=probe_readonly key=$key"
        mem_service_object_share_contract_ops "$fault" readonly "$key" "$size" "$seed" "acq-a-$i"
        echo "op=unmap key=$key"
        echo "op=map key=$key flags=readwrite"
        mem_service_object_share_contract_ops "$fault" writable "$key" "$size" "$seed" "acq-a-$i"
        echo "op=stats"
        # Leave at least one full page even on a 64 KiB-page deployment.
        if [ "$size" -le 2031616 ]; then
          echo "op=probe_guard key=$key"
        fi
        echo "op=write key=$key offset=0 len=$size seed=$seed"
        mem_service_object_share_contract_ops "$fault" written "$key" "$size" "$seed" "acq-a-$i"
        echo "op=publish_data key=$key offset=0 len=$size seed=$seed"
        echo "op=allocate key=$sent idempotency_key=sent-$i size_bytes=65536 capabilities=map"
        if [ "$pressure_barrier" = "1" ]; then
          echo "op=wait_state key=$returned state=retired timeout_ms=60000 poll_ms=50"
        else
          echo "op=wait_state key=$returned state=active timeout_ms=60000 poll_ms=50"
        fi
        echo "op=wait_visible key=$key offset=0 len=$size seed=$((seed + 1))"
        echo "op=read key=$key offset=0 len=$size seed=$((seed + 1))"
        echo "op=unmap key=$key"
        echo "op=stats"
        echo "op=release key=$key idempotency_key=rel-a-$i"
        mem_service_object_share_contract_ops "$fault" released "$key" "$size" "$seed" "rel-a-$i"
        echo "op=retire key=$key idempotency_key=retire-$i"
        echo "op=wait_state key=$key state=retired timeout_ms=60000 poll_ms=50"
        echo "op=retire key=$sent idempotency_key=retire-sent-$i"
        echo "op=wait_state key=$sent state=retired timeout_ms=60000 poll_ms=50"
        if [ "$pressure_barrier" = "0" ]; then
          echo "op=retire key=$returned idempotency_key=retire-returned-$i"
        fi
        echo "op=wait_state key=$returned state=retired timeout_ms=60000 poll_ms=50"
        echo "op=stats"
      else
        echo "op=wait_state key=$sent state=active timeout_ms=60000 poll_ms=50"
        echo "op=acquire key=$key idempotency_key=acq-b-$i"
        mem_service_object_share_contract_ops "$fault" acquired "$key" "$size" "$((seed + 1))" "acq-b-$i"
        echo "op=stats"
        echo "op=map key=$key flags=read"
        echo "op=stats"
        echo "op=probe_readonly key=$key"
        mem_service_object_share_contract_ops "$fault" readonly "$key" "$size" "$((seed + 1))" "acq-b-$i"
        echo "op=unmap key=$key"
        echo "op=map key=$key flags=readwrite"
        mem_service_object_share_contract_ops "$fault" writable "$key" "$size" "$((seed + 1))" "acq-b-$i"
        echo "op=stats"
        if [ "$size" -le 2031616 ]; then
          echo "op=probe_guard key=$key"
        fi
        echo "op=wait_visible key=$key offset=0 len=$size seed=$seed"
        echo "op=read key=$key offset=0 len=$size seed=$seed"
        echo "op=write key=$key offset=0 len=$size seed=$((seed + 1))"
        mem_service_object_share_contract_ops "$fault" written "$key" "$size" "$((seed + 1))" "acq-b-$i"
        echo "op=publish_data key=$key offset=0 len=$size seed=$((seed + 1))"
        if [ "$pressure_barrier" = "1" ]; then
          echo "op=allocate key=$returned idempotency_key=returned-$i size_bytes=65536 capabilities=map"
          echo "op=wait_state key=$returned state=retired timeout_ms=60000 poll_ms=50"
        fi
        echo "op=unmap key=$key"
        echo "op=stats"
        echo "op=release key=$key idempotency_key=rel-b-$i"
        mem_service_object_share_contract_ops "$fault" released "$key" "$size" "$((seed + 1))" "rel-b-$i"
        if [ "$pressure_barrier" = "0" ]; then
          echo "op=allocate key=$returned idempotency_key=returned-$i size_bytes=65536 capabilities=map"
        fi
        echo "op=wait_state key=$returned state=retired timeout_ms=60000 poll_ms=50"
      fi
    } >"$config"
    /bin/linqu_mem_service object-session --config "$config" || exit 1
    i=$((i + 1))
  done
  if [ -n "$capacity_pid" ]; then
    wait "$capacity_pid" || exit 1
    capacity_pid=""
  fi
  /bin/linqu_mem_service health --connect "$connect" || exit 1
  /bin/linqu_mem_service allocation-stats --connect "$connect" || exit 1
  echo "mem_service kernel-regions: phase=drained"
  /bin/linqu_gva_manager --dump-obmm-regions || exit 1
  role=provider
  [ "$node" = "0" ] || role=consumer
  log "mem_service object-share: status=ok node=$node role=$role backend=obmm"
  # The headless runner owns infrastructure shutdown after both clients pass.
  # Keep home exports and the daemon alive independently of client sessions.
  wait "$worker_pid"
)

run_mem_service_object_share() {
  local node_idx=""
  local node_count=""
  local backend=""
  local size=""
  local fault=""
  local iterations=""
  local seed=""
  local port=""
  local incarnation=""
  local address=""
  local descriptor_hex=""
  local connect=""

  node_idx="$(cmdline_value linqu_node_idx 0)"
  node_count="$(cmdline_value linqu_node_count 2)"
  backend="$(cmdline_value mem_service_object_share_backend loopback)"
  size="$(cmdline_value mem_service_object_share_size 4096)"
  fault="$(cmdline_value mem_service_object_share_fault none)"
  iterations="$(cmdline_value mem_service_object_share_iterations 1)"
  seed="$(cmdline_value mem_service_object_share_seed 41)"
  port="$(cmdline_value mem_service_object_share_port 12347)"
  incarnation="$(cmdline_value mem_service_object_share_incarnation 7)"
  address="$(cmdline_value mem_service_object_share_address 17179869184)"
  descriptor_hex="$(cmdline_value mem_service_object_share_descriptor_hex '')"
  connect="tcp:10.0.0.1:$port"

  if [ ! -x /bin/linqu_mem_service ]; then
    log "mem_service object-share: status=fail node=$node_idx role=unknown backend=$backend reason=cli_missing"
    return 2
  fi
  if [ "$node_count" != "2" ]; then
    log "mem_service object-share: status=fail node=$node_idx role=unknown backend=$backend reason=node_count"
    return 2
  fi
  if [ "$backend" != "loopback" ] && [ "$backend" != "obmm" ]; then
    log "mem_service object-share: status=fail node=$node_idx role=unknown backend=$backend reason=backend"
    return 2
  fi
  if [ "$backend" = "obmm" ]; then
    if [ -n "$descriptor_hex" ] ||
        { [ "$fault" != "none" ] && [ "$fault" != "sdk_contract" ] &&
          [ "$fault" != "map_conflict" ] && [ "$fault" != "descriptor_contract" ] &&
          [ "$fault" != "capacity" ] && [ "$fault" != "address_capacity" ] &&
          [ "$fault" != "backing_capacity" ] && [ "$fault" != "allocation_pressure" ]; } ||
        { { [ "$fault" = "capacity" ] || [ "$fault" = "address_capacity" ] ||
            [ "$fault" = "backing_capacity" ] || [ "$fault" = "allocation_pressure" ]; } &&
          [ "$iterations" != "1" ]; }; then
      log "mem_service object-share: status=fail node=$node_idx backend=obmm reason=unsupported_config"
      return 2
    fi
    if ! mem_service_object_share_managed "$node_idx" "$size" "$iterations" \
        "$seed" "$port" "$incarnation" "$fault"; then
      log "mem_service object-share: status=fail node=$node_idx backend=obmm reason=managed_session"
      return 1
    fi
    return 0
  fi

  case "$node_idx" in
    0)
      mem_service_object_share_run_provider "$backend" "$size" "$iterations" \
        "$port" "$incarnation" "$address" "$descriptor_hex" "$connect"
      return $?
      ;;
    1)
      mem_service_object_share_run_consumer "$backend" "$size" "$fault" \
        "$iterations" "$seed" "$connect"
      return $?
      ;;
    *)
      log "mem_service object-share: status=fail node=$node_idx role=unknown backend=$backend reason=node_index"
      return 2
      ;;
  esac
}

