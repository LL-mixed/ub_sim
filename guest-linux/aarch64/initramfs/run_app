#!/bin/busybox sh
set -u

log() {
  echo "[run_app] $*"
}

mount_fs() {
  local fstype="$1"
  local target="$2"
  /bin/busybox mkdir -p "$target" >/dev/null 2>&1 || true
  /bin/busybox mount -t "$fstype" none "$target" >/dev/null 2>&1 || true
}

bootstrap_fs() {
  mount_fs proc /proc
  mount_fs sysfs /sys
  mount_fs devtmpfs /dev
  mount_fs devpts /dev/pts
}

read_cmdline() {
if [ -r /proc/cmdline ]; then
    cmdline="$(/bin/busybox cat /proc/cmdline)"
  else
    cmdline=""
  fi
}

has_flag() {
  local key="$1"
  read_cmdline
  case " $cmdline " in
    *" $key "*) return 0 ;;
    *) return 1 ;;
  esac
}

cmdline_value() {
  local key="$1"
  local default_value="$2"
  local token=""

  read_cmdline
  for token in $cmdline; do
    case "$token" in
      "$key"=*)
        echo "${token#*=}"
        return 0
        ;;
    esac
  done
  echo "$default_value"
}

run_llm_infer() {
  local role=""
  local local_ip=""
  local node_count=""
  local all_ips=""
  local chipbackend_profile=""
  local decode_steps=""

  role="$(cmdline_value linqu_w4_role "$(cmdline_value linqu_urma_dp_role nodeA)")"
  local_ip="$(cmdline_value linqu_w4_local_ip "$(cmdline_value linqu_ipourma_ipv4 "")")"
  node_count="$(cmdline_value linqu_w4_node_count "$(cmdline_value linqu_node_count 2)")"
  all_ips="$(cmdline_value linqu_w4_all_ips 10.0.0.1,10.0.0.2)"
  chipbackend_profile="$(cmdline_value sim_uapi_w4_chipbackend_profile host_matmul)"
  decode_steps="$(cmdline_value sim_qwen3_guest_decode_steps 1)"

  export LINQU_UB_ROLE="$role"
  export LINQU_UB_LOCAL_IP="$local_ip"
  export LINQU_UB_NODE_COUNT="$node_count"
  export LINQU_UB_ALL_IPS="$all_ips"
