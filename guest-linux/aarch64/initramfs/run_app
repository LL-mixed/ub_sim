# T-share object share (M1.2 cross-guest managed object lifecycle). nodeA
# (linqu_node_idx=0) runs the control-plane daemon on the trusted guest
# network plus concurrent producer/provider object-sessions; nodeB
# (linqu_node_idx=1) runs the consumer object-session with data-plane
# map/write/read through the selected provider backend. backend=loopback
# exercises the full deterministic choreography with an in-process fixed
# address mapping; backend=obmm maps the real exported GSVA region and
# requires a descriptor published via mem_service_object_share_descriptor_hex.
mem_service_object_share_wait_daemon() {
  local connect="$1"
  local daemon_pid="$2"
  local i=0
  local health_out=""
  local uptime=""
  local ignored=""
  local deadline=0

  read -r uptime ignored </proc/uptime
  deadline=$((${uptime%%.*} + 60))

  while true; do
    health_out="$(/bin/linqu_mem_service health --connect "$connect" \
      --timeout-ms 1000 --max-attempts 1 2>&1)"
    case "$health_out" in
      *status=ok*) return 0 ;;
    esac
    if [ -n "$daemon_pid" ] && ! kill -0 "$daemon_pid" >/dev/null 2>&1; then
      return 1
    fi
    i=$((i + 1))
    read -r uptime ignored </proc/uptime
    if [ "${uptime%%.*}" -ge "$deadline" ] || [ "$i" -ge 1200 ]; then
      log "managed daemon readiness timed out: $health_out"
      return 1
    fi
    sleep 0.05
  done
}

mem_service_object_share_wait_control_plane_state() {
  local connect="$1"
  local expected="$2"
  local attempt=0
  local current=""

  case "$expected" in up|down) ;; *) return 2 ;; esac
  while [ "$attempt" -lt 1200 ]; do
    if /bin/linqu_mem_service health --connect "$connect" \
        --timeout-ms 100 --max-attempts 1 >/dev/null 2>&1; then
      current=up
    else
      current=down
    fi
    [ "$current" != "$expected" ] || return 0
    attempt=$((attempt + 1))
    /bin/busybox sleep 0.05
  done
  return 1
}

mem_service_object_share_run_provider() {
  local backend="$1"
  local size="$2"
  local iterations="$3"
  local port="$4"
  local incarnation="$5"
  local address="$6"
  local descriptor_hex="$7"
  local connect="$8"
  local daemon_conf="/tmp/mem_service_object_share.daemon.conf"
  local store="/tmp/mem_service_object_share.store"
  local daemon_pid=""
  local i=1
  local key=""
  local barrier_key=""
  local gen_obj=0
  local gen_barrier=0
  local desc="$descriptor_hex"
  local producer_conf=""
  local provider_conf=""
  local producer_log=""
  local provider_log=""
  local producer_pid=""
  local provider_pid=""
  local producer_rc=0
  local provider_rc=0

  if [ -z "$desc" ]; then
    # The loopback provider maps the published fixed address in-process and
    # never decodes descriptor bytes, so a placeholder descriptor is fine.
    desc="deadbeef"
  fi

  {
    echo "listen=tcp:10.0.0.1:$port"
    echo "store=$store"
    echo "node_id=guest-node-0"
    echo "cluster_id=linqu-object-share"
    echo "auth_mode=trusted-guest-network"
    echo "network_peer=guest-node-0@10.0.0.1"
    echo "network_peer=guest-node-1@10.0.0.2"
    echo "required_provider=guest-node-0"
    echo "provider_lease_ms=120000"
    echo "allocation_home_provider=guest-node-0"
  } > "$daemon_conf"

  /bin/busybox rm -f "$store" "$store.journal"
  log "start linqu_mem_service daemon for mem_service object share"
  /bin/linqu_mem_service serve --config "$daemon_conf" \
    >/tmp/mem_service_object_share.daemon.stdout \
    2>/tmp/mem_service_object_share.daemon.stderr &
  daemon_pid=$!

  if ! mem_service_object_share_wait_daemon "$connect" "$daemon_pid"; then
    /bin/busybox cat /tmp/mem_service_object_share.daemon.stderr >&2 || true
    kill "$daemon_pid" >/dev/null 2>&1 || true
    wait "$daemon_pid" >/dev/null 2>&1 || true
    log "mem_service object-share: status=fail node=0 role=provider backend=$backend reason=daemon_ready"
    return 1
  fi

  if ! /bin/linqu_mem_service provider-register --connect "$connect" \
      --node-id guest-node-0 --incarnation "$incarnation" \
      --readiness-generation 1 --capabilities 1; then
    kill "$daemon_pid" >/dev/null 2>&1 || true
    wait "$daemon_pid" >/dev/null 2>&1 || true
    log "mem_service object-share: status=fail node=0 role=provider backend=$backend reason=provider_register"
    return 1
  fi
  if ! /bin/linqu_mem_service status --connect "$connect"; then
    kill "$daemon_pid" >/dev/null 2>&1 || true
    wait "$daemon_pid" >/dev/null 2>&1 || true
    log "mem_service object-share: status=fail node=0 role=provider backend=$backend reason=status"
    return 1
  fi

  while [ "$i" -le "$iterations" ]; do
    key="obj-share-$i"
    barrier_key="barrier-share-$i"
    # Allocation generations come from the daemon table-level counter: the
    # shared object is allocated first, the consumer barrier second.
    gen_obj=$((2 * i - 1))
    gen_barrier=$((2 * i))
    producer_conf="/tmp/mem_service_object_share.producer.$i.conf"
    provider_conf="/tmp/mem_service_object_share.provider.$i.conf"
    producer_log="/tmp/mem_service_object_share.producer.$i.log"
    provider_log="/tmp/mem_service_object_share.provider.$i.log"

    {
      echo "session_id=producer"
      echo "connect=$connect"
      echo "op=allocate key=$key idempotency_key=p-alloc-$i size_bytes=$size capabilities=map"
      echo "op=wait_state key=$key state=active timeout_ms=60000 poll_ms=100"
      echo "op=wait_state key=$barrier_key state=allocating timeout_ms=60000 poll_ms=100"
      echo "op=retire key=$key idempotency_key=p-ret-$i expected_generation=$gen_obj"
      echo "op=wait_state key=$key state=retired timeout_ms=60000 poll_ms=100"
      echo "op=wait_state key=$barrier_key state=retired timeout_ms=60000 poll_ms=100"
      echo "op=stats"
    } > "$producer_conf"

    {
      echo "session_id=provider"
      echo "connect=$connect"
      echo "op=wait_state key=$key state=allocating timeout_ms=60000 poll_ms=100"
      echo "op=publish key=$key node_id=guest-node-0 incarnation=$incarnation generation=$gen_obj descriptor_hex=$desc address=$address address_len=$size"
      echo "op=wait_state key=$key state=retiring timeout_ms=60000 poll_ms=100"
      echo "op=wait_state key=$barrier_key state=retired timeout_ms=60000 poll_ms=100"
      echo "op=reclaim key=$key node_id=guest-node-0 incarnation=$incarnation generation=$gen_obj confirmed=1"
    } > "$provider_conf"

    /bin/linqu_mem_service object-session --config "$producer_conf" \
      >"$producer_log" 2>&1 &
    producer_pid=$!
    /bin/linqu_mem_service object-session --config "$provider_conf" \
      >"$provider_log" 2>&1 &
    provider_pid=$!
    wait "$producer_pid"
    producer_rc=$?
    wait "$provider_pid"
    provider_rc=$?
    /bin/busybox cat "$producer_log"
    /bin/busybox cat "$provider_log"
    if [ "$producer_rc" -ne 0 ] || [ "$provider_rc" -ne 0 ]; then
      kill "$daemon_pid" >/dev/null 2>&1 || true
      wait "$daemon_pid" >/dev/null 2>&1 || true
      log "mem_service object-share: status=fail node=0 role=provider backend=$backend reason=session iteration=$i"
      return 1
    fi
    i=$((i + 1))
  done

  kill "$daemon_pid" >/dev/null 2>&1 || true
  wait "$daemon_pid" >/dev/null 2>&1 || true
  log "mem_service object-share: status=ok node=0 role=provider backend=$backend"
  return 0
}

mem_service_object_share_run_consumer() {
  local backend="$1"
  local size="$2"
  local fault="$3"
  local iterations="$4"
  local seed="$5"
  local connect="$6"
  local provider_line="provider=session-loopback"
  local i=1
  local key=""
  local barrier_key=""
  local gen_obj=0
  local gen_barrier=0
  local consumer_conf=""
  local consumer_log=""
  local consumer_rc=0

  if [ "$backend" = "obmm" ]; then
    provider_line="provider=obmm"
  fi

  if ! mem_service_object_share_wait_daemon "$connect" ""; then
    log "mem_service object-share: status=fail node=1 role=consumer backend=$backend reason=daemon_reachable"
    return 1
  fi

  while [ "$i" -le "$iterations" ]; do
    key="obj-share-$i"
    barrier_key="barrier-share-$i"
    gen_obj=$((2 * i - 1))
    gen_barrier=$((2 * i))
    consumer_conf="/tmp/mem_service_object_share.consumer.$i.conf"
    consumer_log="/tmp/mem_service_object_share.consumer.$i.log"

    {
      echo "session_id=consumer"
      echo "connect=$connect"
      echo "$provider_line"
      echo "op=wait_state key=$key state=active timeout_ms=60000 poll_ms=100"
      echo "op=acquire key=$key idempotency_key=c-acq-$i expected_generation=$gen_obj"
      echo "op=inspect key=$key expect_state=active expect_generation=$gen_obj expect_holder_count=1"
      echo "op=map key=$key flags=readwrite"
      echo "op=write key=$key offset=0 len=$size seed=$seed"
      echo "op=read key=$key offset=0 len=$size seed=$seed"
      if [ "$fault" = "read_mismatch" ]; then
        echo "op=read key=$key offset=0 len=$size seed=$((seed + 1)) expect_status=checksum_mismatch"
      fi
      echo "op=unmap key=$key"
      echo "op=allocate key=$barrier_key idempotency_key=c-bar-$i size_bytes=$size capabilities=map"
      echo "op=wait_state key=$key state=retiring timeout_ms=60000 poll_ms=100"
      echo "op=release key=$key idempotency_key=c-rel-$i expected_generation=$gen_obj"
      echo "op=retire key=$barrier_key idempotency_key=c-bar-ret-$i expected_generation=$gen_barrier"
    } > "$consumer_conf"

    /bin/linqu_mem_service object-session --config "$consumer_conf" \
      >"$consumer_log" 2>&1
    consumer_rc=$?
    /bin/busybox cat "$consumer_log"
    if [ "$consumer_rc" -ne 0 ]; then
      log "mem_service object-share: status=fail node=1 role=consumer backend=$backend reason=session iteration=$i"
      return 1
    fi
    i=$((i + 1))
  done

  log "mem_service object-share: status=ok node=1 role=consumer backend=$backend"
  return 0
}

mem_service_object_share_contract_ops() (
  if [ "$1" = "descriptor_contract" ]; then
    case "$2" in
      acquired)
        for byte in 0 4 8 12 16 24 32 40 44 48 56 64 68 72 76 80 84 88 92 95; do
          echo "op=map key=$3 flags=read fault=descriptor fault_byte=$byte expect_status=stale_ref"
        done
        for field in descriptor_length descriptor_oversize address address_len size alignment capabilities home incarnation; do
          echo "op=map key=$3 flags=read fault=$field expect_status=stale_ref"
        done
        ;;
      readonly) echo "op=probe_descriptor key=$3" ;;
      writable|written|released) ;;
      *) exit 2 ;;
    esac
    exit 0
  fi
  if [ "$1" = "map_conflict" ]; then
    case "$2" in
      readonly) echo "op=probe_conflict key=$3" ;;
      acquired|writable|written|released) ;;
      *) exit 2 ;;
    esac
    exit 0
  fi
  [ "$1" = "sdk_contract" ] || exit 0
  stage="$2"
  key="$3"
  size="$4"
  seed="$5"
  identity="$6"
  case "$stage" in
    acquired)
      echo "op=acquire key=absent-$key idempotency_key=absent-$identity expect_status=not_found"
      echo "op=acquire key=$key idempotency_key=stale-$identity expected_generation=18446744073709551615 expect_status=stale_ref"
      echo "op=acquire key=$key idempotency_key=$identity"
      ;;
    readonly)
      echo "op=write key=$key offset=0 len=1 seed=$seed expect_status=unsupported"
      ;;
    writable)
      for action in read write publish_data wait_visible; do
        echo "op=$action key=$key offset=$size len=1 seed=$seed expect_status=capacity_exceeded"
      done
      echo "op=release key=$key idempotency_key=early-$identity expect_status=internal"
      ;;
    written)
      echo "op=read key=$key offset=0 len=1 seed=$((seed ^ 1)) expect_status=checksum_mismatch"
      ;;
    released)
      echo "op=release key=$key idempotency_key=$identity"
      ;;
    *) exit 2 ;;
  esac
)

mem_service_object_share_capacity_pressure() (
  connect="$1"
  attempt=0
  while [ "$attempt" -lt 120 ]; do
    if /bin/linqu_mem_service inspect-allocation --connect "$connect" \
        --key obj-returned-1 --timeout-ms 2000 >/tmp/capacity-barrier.log 2>&1 &&
        grep -q '^state=active$' /tmp/capacity-barrier.log; then
      break
    fi
    attempt=$((attempt + 1))
    sleep 1
  done
  [ "$attempt" -lt 120 ] || exit 1
  attempt=0
  while [ "$attempt" -lt 80 ]; do
    attempt=$((attempt + 1))
    if /bin/linqu_mem_service retire-object --connect "$connect" \
        --key capacity-probe-missing --idempotency-key "capacity-pressure-$attempt" \
        --timeout-ms 2000 >/tmp/capacity-pressure.log 2>&1; then
      exit 1
    fi
    if grep -q '^status=capacity_exceeded$' /tmp/capacity-pressure.log; then
      echo "mem_service capacity-pressure: phase=saturated attempts=$attempt"
      /bin/linqu_mem_service allocation-stats --connect "$connect" || exit 1
      /bin/linqu_mem_service retire-object --connect "$connect" \
        --key obj-returned-1 --idempotency-key capacity-barrier-release || exit 1
      echo "mem_service capacity-pressure: phase=released status=ok"
      exit 0
    fi
    grep -q '^status=not_found$' /tmp/capacity-pressure.log || exit 1
  done
  exit 1
)

mem_service_object_share_address_pressure() (
  connect="$1"
  {
    echo "session_id=address-pressure"
    echo "connect=$connect"
    echo "request_timeout_ms=30000"
    echo "op=wait_state key=obj-returned-1 state=active timeout_ms=60000 poll_ms=50"
    echo "op=allocate key=address-overflow idempotency_key=address-overflow size_bytes=18446744073709551615 capabilities=map"
    echo "op=wait_state key=address-overflow state=retired timeout_ms=60000 poll_ms=50"
    echo "op=allocate key=address-alignment idempotency_key=address-alignment size_bytes=1 alignment_bytes=9223372036854775808 capabilities=map"
    echo "op=wait_state key=address-alignment state=retired timeout_ms=60000 poll_ms=50"
    echo "op=allocate key=address-fill idempotency_key=address-fill size_bytes=8388608 alignment_bytes=8388608 capabilities=map"
    echo "op=wait_state key=address-fill state=active timeout_ms=60000 poll_ms=50"
    echo "op=allocate key=address-gap idempotency_key=address-gap size_bytes=2097152 capabilities=map"
    echo "op=wait_state key=address-gap state=active timeout_ms=60000 poll_ms=50"
  } >/tmp/address-pressure-fill.conf
  /bin/linqu_mem_service object-session --config /tmp/address-pressure-fill.conf || exit 1
  echo "mem_service address-pressure: phase=filled"
  for key in obj-share-1 obj-sent-1 obj-returned-1 address-fill address-gap address-overflow address-alignment; do
    /bin/linqu_mem_service inspect-allocation --connect "$connect" --key "$key" || exit 1
  done
  /bin/linqu_mem_service allocation-stats --connect "$connect" || exit 1
  {
    echo "session_id=address-pressure"
    echo "connect=$connect"
    echo "request_timeout_ms=30000"
    echo "op=allocate key=address-exhausted idempotency_key=address-exhausted size_bytes=1 capabilities=map"
    echo "op=wait_state key=address-exhausted state=retired timeout_ms=60000 poll_ms=50"
    echo "op=retire key=address-fill idempotency_key=address-fill-retire"
    echo "op=wait_state key=address-fill state=retired timeout_ms=60000 poll_ms=50"
    echo "op=allocate key=address-reused idempotency_key=address-reused size_bytes=8388608 alignment_bytes=8388608 capabilities=map"
    echo "op=wait_state key=address-reused state=active timeout_ms=60000 poll_ms=50"
  } >/tmp/address-pressure-drain.conf
  /bin/linqu_mem_service object-session --config /tmp/address-pressure-drain.conf || exit 1
  echo "mem_service address-pressure: phase=reused"
  for key in address-fill address-exhausted address-reused; do
    /bin/linqu_mem_service inspect-allocation --connect "$connect" --key "$key" || exit 1
  done
  /bin/linqu_mem_service allocation-stats --connect "$connect" || exit 1
  for key in address-gap address-reused; do
    /bin/linqu_mem_service retire-object --connect "$connect" --key "$key" \
      --idempotency-key "$key-retire" || exit 1
  done
  {
    echo "session_id=address-pressure"
    echo "connect=$connect"
    echo "request_timeout_ms=30000"
    echo "op=wait_state key=address-gap state=retired timeout_ms=60000 poll_ms=50"
    echo "op=wait_state key=address-reused state=retired timeout_ms=60000 poll_ms=50"
  } >/tmp/address-pressure-reclaimed.conf
  /bin/linqu_mem_service object-session --config /tmp/address-pressure-reclaimed.conf || exit 1
  echo "mem_service address-pressure: phase=rejected"
  for key in address-gap address-reused; do
    /bin/linqu_mem_service inspect-allocation --connect "$connect" --key "$key" || exit 1
  done
  /bin/linqu_mem_service allocation-stats --connect "$connect" || exit 1
  /bin/linqu_mem_service retire-object --connect "$connect" --key obj-returned-1 \
    --idempotency-key address-barrier-release || exit 1
  echo "mem_service address-pressure: phase=released"
)

mem_service_object_share_backing_snapshot() (
  echo "mem_service backing-pressure: phase=$2"
  /bin/linqu_mem_service allocation-stats --connect "$1" || exit 1
  pool=/sys/kernel/obmm_mempool/obmm-0
  read -r total <"$pool/total" || exit 1
  read -r used <"$pool/used" || exit 1
  read -r ready <"$pool/available_cleared" || exit 1
  echo "mem_service backing-pool: phase=$2 total=$((total)) used=$((used)) ready=$((ready)) consistency=non_atomic"
)

mem_service_object_share_backing_pressure() (
  connect="$1"
  {
    echo "session_id=backing-pressure"
    echo "connect=$connect"
    echo "request_timeout_ms=30000"
    echo "op=wait_state key=obj-returned-1 state=active timeout_ms=60000 poll_ms=50"
  } >/tmp/backing-pressure-begin.conf
  /bin/linqu_mem_service object-session --config /tmp/backing-pressure-begin.conf || exit 1
  /bin/linqu_mem_service inspect-allocation --connect "$connect" --key obj-share-1 \
    >/tmp/backing-pressure-active.log || exit 1
  address=$(/bin/busybox sed -n 's/^address=//p' /tmp/backing-pressure-active.log)
  /bin/linqu_gva_manager --query --home-va "$address" >/tmp/backing-pressure-query.log 2>&1 || exit 1
  segment=$(/bin/busybox sed -n 's/.*result=done action=gsva-segment-query segment_id=\([^ ]*\).*/\1/p' /tmp/backing-pressure-query.log)
  epoch=$(/bin/busybox sed -n 's/.*result=done action=gsva-segment-query .* epoch=\([^ ]*\).*/\1/p' /tmp/backing-pressure-query.log)
  if /bin/linqu_gva_manager --retire --segment-id "$segment" --epoch "$epoch" \
      >/tmp/backing-pressure-retire.log 2>&1; then
    exit 1
  fi
  grep -q 'result=fail action=gsva-segment-retire errno=16' /tmp/backing-pressure-retire.log || exit 1
  /bin/linqu_gva_manager --check-export-identity --segment-id "$segment" || exit 1
  /bin/linqu_gva_manager --query --segment-id "$segment" || exit 1
  echo "mem_service backing-pin: segment=$segment epoch=$epoch errno=16"
  mem_service_object_share_backing_snapshot "$connect" before || exit 1
  {
    echo "session_id=backing-pressure"
    echo "connect=$connect"
    echo "request_timeout_ms=30000"
    echo "op=allocate key=backing-empty idempotency_key=backing-empty size_bytes=2147483648 capabilities=map"
    echo "op=wait_state key=backing-empty state=retired timeout_ms=60000 poll_ms=50"
  } >/tmp/backing-pressure-empty.conf
  /bin/linqu_mem_service object-session --config /tmp/backing-pressure-empty.conf || exit 1
  mem_service_object_share_backing_snapshot "$connect" rejected || exit 1
  /bin/linqu_mem_service inspect-allocation --connect "$connect" --key backing-empty || exit 1
  # FAST uses cleared cached pages only. Wait for background clearing after rollback.
  attempt=0
  while [ "$attempt" -lt 30 ]; do
    read -r ready </sys/kernel/obmm_mempool/obmm-0/available_cleared || exit 1
    [ "$((ready))" -lt 2097152 ] || break
    attempt=$((attempt + 1))
    sleep 1
  done
  [ "$attempt" -lt 30 ] || exit 1
  {
    echo "session_id=backing-pressure"
    echo "connect=$connect"
    echo "request_timeout_ms=30000"
    echo "op=allocate key=backing-recovered idempotency_key=backing-recovered size_bytes=65536 capabilities=map"
    echo "op=wait_state key=backing-recovered state=active timeout_ms=60000 poll_ms=50"
  } >/tmp/backing-pressure-recover.conf
  /bin/linqu_mem_service object-session --config /tmp/backing-pressure-recover.conf || exit 1
  mem_service_object_share_backing_snapshot "$connect" recovered || exit 1
  /bin/linqu_mem_service inspect-allocation --connect "$connect" --key backing-recovered || exit 1
  {
    echo "session_id=backing-pressure"
    echo "connect=$connect"
    echo "request_timeout_ms=30000"
    echo "op=retire key=backing-recovered idempotency_key=backing-recovered-retire"
    echo "op=wait_state key=backing-recovered state=retired timeout_ms=60000 poll_ms=50"
  } >/tmp/backing-pressure-drain.conf
  /bin/linqu_mem_service object-session --config /tmp/backing-pressure-drain.conf || exit 1
  mem_service_object_share_backing_snapshot "$connect" drained || exit 1
  /bin/linqu_mem_service retire-object --connect "$connect" --key obj-returned-1 \
    --idempotency-key backing-barrier-release || exit 1
  echo "mem_service backing-pressure: phase=complete"
)

mem_service_object_share_allocation_snapshot() (
  connect="$1"
  phase="$2"
  shift 2
  echo "mem_service allocation-pressure: phase=$phase"
  /bin/linqu_mem_service allocation-stats --connect "$connect" || exit 1
  read -r used </sys/kernel/obmm_mempool/obmm-0/used || exit 1
  echo "mem_service allocation-pool: phase=$phase used=$((used)) consistency=non_atomic"
  for key in "$@"; do
    view="/tmp/allocation-view-$key.log"
    /bin/linqu_mem_service inspect-allocation --connect "$connect" --key "$key" >"$view" || exit 1
    cat "$view"
    address=$(/bin/busybox sed -n 's/^address=//p' "$view")
    [ -n "$address" ] || exit 1
    [ "$address" != "0" ] || continue
    /bin/linqu_gva_manager --query --home-va "$address" >/tmp/allocation-query.log 2>&1 || exit 1
    # Retain identity/geometry without printing the query's token value.
    /bin/busybox sed -n "s/.*gsva descriptor action=query version=1 flags=[^ ]* segment_id=\\([^ ]*\\) home_va=\\([^ ]*\\) size=\\([^ ]*\\) epoch=\\([^ ]*\\) .*/mem_service allocation-segment: key=$key segment=\\1 address=\\2 size=\\3 epoch=\\4/p" /tmp/allocation-query.log
  done
)

mem_service_object_share_allocation_pressure() (
  connect="$1"
  pids=""
  cleanup_allocation_pressure() {
    [ -n "$pids" ] || return 0
    for pid in $pids; do kill "$pid" 2>/dev/null || true; done
    for pid in $pids; do wait "$pid" 2>/dev/null || true; done
    for index in 1 2 3; do
      [ ! -f "/tmp/allocation-client-$index.log" ] || cat "/tmp/allocation-client-$index.log"
    done
  }
  trap cleanup_allocation_pressure EXIT
  trap 'exit 1' INT TERM
  {
    echo "session_id=allocation-pressure"
    echo "connect=$connect"
    echo "request_timeout_ms=30000"
    echo "op=wait_state key=obj-returned-1 state=active timeout_ms=60000 poll_ms=50"
  } >/tmp/allocation-pressure-begin.conf
  /bin/linqu_mem_service object-session --config /tmp/allocation-pressure-begin.conf || exit 1
  mem_service_object_share_allocation_snapshot "$connect" before \
    obj-share-1 obj-sent-1 obj-returned-1 || exit 1
  for index in 1 2 3; do
    case "$index" in
      1) bytes=1; alignment=2097152 ;;
      2) bytes=2097153; alignment=4194304 ;;
      3) bytes=4194305; alignment=8388608 ;;
    esac
    {
      echo "session_id=allocation-client-$index"
      echo "connect=$connect"
      echo "request_timeout_ms=30000"
      echo "op=allocate key=allocation-$index idempotency_key=allocation-$index size_bytes=$bytes alignment_bytes=$alignment capabilities=map"
      echo "op=wait_state key=allocation-$index state=active timeout_ms=60000 poll_ms=50"
      echo "op=allocate key=allocation-$index idempotency_key=allocation-$index size_bytes=$bytes alignment_bytes=$alignment capabilities=map"
      echo "op=wait_state key=allocation-$index state=retired timeout_ms=60000 poll_ms=50"
    } >"/tmp/allocation-client-$index.conf"
    /bin/linqu_mem_service object-session --config "/tmp/allocation-client-$index.conf" \
      >"/tmp/allocation-client-$index.log" 2>&1 &
    pids="${pids:+$pids }$!"
  done
  attempt=0
  while [ "$attempt" -lt 30 ]; do
    complete=0
    for index in 1 2 3; do
      count=$(grep -c "action=allocate key=allocation-$index status=ok " "/tmp/allocation-client-$index.log")
      [ "$count" != "2" ] || complete=$((complete + 1))
    done
    [ "$complete" != "3" ] || break
    for pid in $pids; do kill -0 "$pid" 2>/dev/null || exit 1; done
    sleep 1
    attempt=$((attempt + 1))
  done
  [ "$complete" = "3" ] || exit 1
  mem_service_object_share_allocation_snapshot "$connect" live \
    allocation-1 allocation-2 allocation-3 || exit 1
  index=1
  for pid in $pids; do
    kill -0 "$pid" 2>/dev/null || exit 1
    echo "mem_service allocation-client: index=$index pid=$pid phase=waiting"
    index=$((index + 1))
  done
  /bin/linqu_mem_service retire-object --connect "$connect" --key allocation-2 \
    --idempotency-key allocation-retire-2 || exit 1
  {
    echo "session_id=allocation-pressure"
    echo "connect=$connect"
    echo "request_timeout_ms=30000"
    echo "op=wait_state key=allocation-2 state=retired timeout_ms=60000 poll_ms=50"
  } >/tmp/allocation-pressure-hole.conf
  /bin/linqu_mem_service object-session --config /tmp/allocation-pressure-hole.conf || exit 1
  mem_service_object_share_allocation_snapshot "$connect" hole allocation-2 || exit 1
  {
    echo "session_id=allocation-pressure"
    echo "connect=$connect"
    echo "request_timeout_ms=30000"
    echo "op=allocate key=allocation-4 idempotency_key=allocation-4 size_bytes=3145728 alignment_bytes=4194304 capabilities=map"
    echo "op=wait_state key=allocation-4 state=active timeout_ms=60000 poll_ms=50"
  } >/tmp/allocation-pressure-replace.conf
  /bin/linqu_mem_service object-session --config /tmp/allocation-pressure-replace.conf || exit 1
  mem_service_object_share_allocation_snapshot "$connect" replaced allocation-4 || exit 1
  {
    echo "session_id=allocation-pressure"
    echo "connect=$connect"
    echo "request_timeout_ms=30000"
    for index in 1 3 4; do
      echo "op=retire key=allocation-$index idempotency_key=allocation-retire-$index"
      echo "op=wait_state key=allocation-$index state=retired timeout_ms=60000 poll_ms=50"
    done
  } >/tmp/allocation-pressure-drain.conf
  /bin/linqu_mem_service object-session --config /tmp/allocation-pressure-drain.conf || exit 1
  mem_service_object_share_allocation_snapshot "$connect" drained \
    allocation-1 allocation-2 allocation-3 allocation-4 || exit 1
  index=1
  for pid in $pids; do
    wait "$pid"
    code=$?
    pids=${pids#"$pid"}
    pids=${pids# }
    cat "/tmp/allocation-client-$index.log"
    echo "mem_service allocation-client: index=$index pid=$pid phase=exited code=$code"
    [ "$code" = "0" ] || exit 1
    index=$((index + 1))
  done
  /bin/linqu_mem_service retire-object --connect "$connect" --key obj-returned-1 \
    --idempotency-key allocation-barrier-release || exit 1
  echo "mem_service allocation-pressure: phase=complete"
)

