    echo "op=wait_state key=$done state=retired timeout_ms=60000 poll_ms=50"
    echo "op=stats"
  fi
)

mem_service_reference_reader_prepare() (
  round="$1"; connect="$2"
  receipt="/tmp/reference-ready-$round.receipt"
  read -r uptime ignored </proc/uptime
  deadline=$((${uptime%%.*} + 60))
  while true; do
    if /bin/linqu_mem_service inspect-allocation --connect "$connect" \
        --key "ref-ready-$round" --timeout-ms 1000 --max-attempts 1 >"$receipt"; then
      state="$(/bin/busybox sed -n 's/^state=//p' "$receipt")"
      case "$state" in active) break ;; allocating) ;; *) cat "$receipt"; exit 1 ;; esac
    elif ! /bin/busybox grep -qx 'status=not_found' "$receipt"; then
      cat "$receipt"; exit 1
    fi
    read -r uptime ignored </proc/uptime
    [ "${uptime%%.*}" -lt "$deadline" ] || exit 1
    sleep 0.05
  done
  for view in a b; do
    receipt="/tmp/reference-capture-$round-$view.receipt"
    /bin/linqu_mem_service reference-transition --connect "$connect" \
      --action resolve --key "obj-ref-$round/$view" --timeout-ms 30000 \
      --max-attempts 1 >"$receipt" || { cat "$receipt"; exit 1; }
    hex="$(/bin/busybox sed -n 's/^reference_hex=//p' "$receipt")"
    [ "${#hex}" = 512 ] || exit 1
    case "$hex" in *[!0-9a-f]*) exit 1 ;; esac
    echo "mem_service reference-capture: round=$round key=obj-ref-$round/$view reference_hex=$hex"
  done
  previous=$((round - 1))
  for view in a b; do
    [ "$round" -gt 1 ] || break
    old="/tmp/reference-capture-$previous-$view.receipt"
    hex="$(/bin/busybox sed -n 's/^reference_hex=//p' "$old")" || exit 1
    [ "${#hex}" = 512 ] || exit 1
    case "$hex" in *[!0-9a-f]*) exit 1 ;; esac
    for action in resolve acquire map-begin; do
      receipt="/tmp/reference-rejected-$round-$view-$action.receipt"
      set -- --connect "$connect" --action "$action" --timeout-ms 30000 --max-attempts 1
      if [ "$action" = resolve ]; then
        set -- "$@" --key "obj-ref-$previous/$view"
      else
        set -- "$@" --key "obj-ref-$previous" --reference-hex "$hex" --access 1 \
          --session-id client-1 --idempotency-key "ref-stale-$round-$view-$action"
      fi
      if /bin/linqu_mem_service reference-transition "$@" >"$receipt"; then
        cat "$receipt"
        echo "mem_service reference-rejection: unexpected_success round=$round action=$action"
        exit 1
      fi
      status="$(/bin/busybox sed -n 's/^status=//p' "$receipt")"
      case "$status" in stale_ref|not_found) ;; *) cat "$receipt"; exit 1 ;; esac
      /bin/busybox grep -qx "mem_service reference-transition: status=$status" "$receipt" || exit 1
      echo "mem_service reference-rejection: round=$round key=obj-ref-$previous/$view action=$action status=$status reference_hex=$hex"
    done
  done
  /bin/linqu_mem_service allocate-object --connect "$connect" \
    --key "ref-checked-$round" --idempotency-key "ref-checked-$round" \
    --session-id client-1 --size-bytes 65536 --capabilities 1 \
    >"/tmp/reference-checked-$round.receipt" || exit 1
)

mem_service_object_share_reference() (
  node="$1"; size="$2"; iterations="$3"; seed="$4"; incarnation="$5"; connect="$6"
  check_pid=""
  cleanup_reference_check() {
    if [ -n "$check_pid" ]; then
      kill "$check_pid" 2>/dev/null || true
      wait "$check_pid" 2>/dev/null || true
    fi
  }
  trap cleanup_reference_check EXIT
  # Both infrastructure registrations must exist before preallocating. The
  # subsequent two SDK endpoints still perform their own peer canary.
  read -r uptime ignored </proc/uptime
  deadline=$((${uptime%%.*} + 60))
  while true; do
    directory="$(/bin/linqu_mem_service provider-directory-status --connect "$connect" \
      --timeout-ms 1000 --max-attempts 1)" || exit 1
    # This control-plane process has no local payload provider. Its remote
    # worker registrations are reported by the directory readiness field.
    if printf '%s\n' "$directory" | /bin/busybox grep -qx 'provider_directory_ready=1'; then break; fi
    read -r uptime ignored </proc/uptime
    [ "${uptime%%.*}" -lt "$deadline" ] || exit 1
    sleep 0.05
  done
  round=1
  while [ "$round" -le "$iterations" ]; do
    generation=0; version=0
    if [ "$node" = "0" ]; then
      receipt="/tmp/reference-allocation-$round.receipt"
      /bin/linqu_mem_service allocate-object --connect "$connect" \
        --key "obj-ref-$round" --idempotency-key "ref-allocation-$round" \
        --session-id client-0 --size-bytes "$size" --capabilities 1 >"$receipt" || exit 1
      generation="$(/bin/busybox sed -n 's/^generation=//p' "$receipt")" || exit 1
      version="$(/bin/busybox sed -n 's/^version=//p' "$receipt")" || exit 1
      for value in "$generation" "$version"; do
        case "$value" in ''|0*|*[!0-9]*) exit 1 ;; esac
      done
      echo "mem_service reference-allocation: key=obj-ref-$round generation=$generation version=$version"
    fi
    config="/tmp/reference-session-$round.conf"
    {
      echo "session_id=client-$node"
      echo "connect=$connect"
      echo "request_timeout_ms=30000"
      echo "holder_node_id=guest-node-$node"
      echo "holder_provider_incarnation=$incarnation"
      echo "provider=obmm"
      echo "provider_node_id=$node"
      echo "provider_node_count=2"
      echo "provider_generation=$((incarnation + round))"
      echo "provider_import_region_bytes=2097152"
      mem_service_object_share_reference_ops "$node" "$size" "$round" "$(((seed + round - 1) % 256))" "$generation" "$version"
    } >"$config"
    if [ "$node" = "1" ]; then
      mem_service_reference_reader_prepare "$round" "$connect" &
      check_pid=$!
    fi
    if ! /bin/linqu_mem_service object-session --config "$config"; then
      echo "mem_service reference-capacity: node=$node round=$round phase=failed"
      /bin/linqu_mem_service allocation-stats --connect "$connect" || true
      exit 1
    fi
    if [ -n "$check_pid" ]; then
      wait "$check_pid" || exit 1
      check_pid=""
    fi
    round=$((round + 1))
  done
)

mem_service_object_share_retired_ops() {
  local node="$1" size="$2" seed="$3" key marker
  if [ "$node" = "0" ]; then
    for key in retired-old retired-new; do
      echo "op=allocate key=$key idempotency_key=alloc-$key size_bytes=$size capabilities=map"
      echo "op=wait_state key=$key state=active timeout_ms=60000 poll_ms=50"
      echo "op=acquire key=$key idempotency_key=write-acquire-$key"
      echo "op=map key=$key flags=readwrite"
      echo "op=write key=$key offset=0 len=$size seed=$seed"
      echo "op=publish_data key=$key offset=0 len=$size seed=$seed"
      echo "op=read key=$key offset=0 len=$size seed=$seed"
      echo "op=unmap key=$key probe_unmapped=1"
      echo "op=release key=$key idempotency_key=write-release-$key"
      echo "op=allocate key=$key-ready idempotency_key=ready-$key size_bytes=65536 capabilities=map"
      echo "op=wait_state key=$key-done state=active timeout_ms=60000 poll_ms=50"
      for marker in "$key" "$key-ready" "$key-done"; do
        echo "op=retire key=$marker idempotency_key=retire-$marker"
        echo "op=wait_state key=$marker state=retired timeout_ms=60000 poll_ms=50"
      done
      seed=$(((seed + 1) % 256))
    done
  else
    for key in retired-old retired-new; do
      echo "op=wait_state key=$key-ready state=active timeout_ms=60000 poll_ms=50"
      echo "op=acquire key=$key idempotency_key=read-acquire-$key"
      echo "op=map key=$key flags=read"
      echo "op=wait_visible key=$key offset=0 len=$size seed=$seed"
      echo "op=read key=$key offset=0 len=$size seed=$seed"
      if [ "$key" = "retired-old" ]; then
        echo "op=capture_mapping key=$key"
      fi
      echo "op=unmap key=$key probe_unmapped=1"
      if [ "$key" = "retired-new" ]; then
        echo "op=probe_retired_mapping key=retired-old"
        echo "op=stats"
        echo "op=map key=$key flags=read"
        echo "op=wait_visible key=$key offset=0 len=$size seed=$seed"
        echo "op=read key=$key offset=0 len=$size seed=$seed"
        echo "op=unmap key=$key probe_unmapped=1"
      fi
      echo "op=release key=$key idempotency_key=read-release-$key"
      echo "op=allocate key=$key-done idempotency_key=done-$key size_bytes=65536 capabilities=map"
      echo "op=wait_state key=$key-done state=retired timeout_ms=60000 poll_ms=50"
      seed=$(((seed + 1) % 256))
    done
  fi
  echo "op=stats"
}

