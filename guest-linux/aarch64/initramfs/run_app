  else
    echo "op=wait_state key=$ready state=active timeout_ms=60000 poll_ms=50"
    echo "op=wait_state key=ref-checked-$round state=active timeout_ms=60000 poll_ms=50"
    echo "op=stats"
    for view in a b; do
      echo "op=acquire_reference key=$key/$view idempotency_key=ref-reader-$round-$view"
      echo "op=map_reference key=$key"
      echo "op=stats"
