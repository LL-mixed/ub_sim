mem_service_object_share_holder_recovery() {
  local node="$1"
  local size="$2"
  local seed="$3"
  local incarnation="$4"
  local connect="$5"
  local worker="$6"
  local key="holder-recovery-object"
  local ready_key="holder-recovery-ready"
  local pto_ready_key="holder-recovery-pto-ready"
  local receipt_gate_key="holder-recovery-receipt-required"
  local generation=""
  local replacement=$((incarnation + 1))
  local attempt=0
  local result=0
  local session_pid=""
  local session_status=0
  local pto_pid=""
  local pto_status=0
  local pto_op=""
  local cpu_signal=""
  local remaining_holders=""

  {
    echo "connect=$connect"
    echo "key=$key"
    echo "node_id=$node"
    echo "generation=$incarnation"
    echo "requester_cna=$(cmdline_value lingqu_shmem_pto_requester_cna '')"
    echo "artifact_fingerprint=$(cmdline_value lingqu_shmem_pto_artifact_fingerprint '')"
    echo "timeout_ms=$(cmdline_value lingqu_shmem_pto_timeout_ms 120000)"
    echo "layout=$(cmdline_value lingqu_shmem_pto_layout cross-page)"
    echo "elements=$(cmdline_value lingqu_shmem_pto_elements 64)"
    echo "size_bytes=$size"
    echo "home_node=0"
    echo "holder_recovery_probe=1"
  } >/tmp/holder-recovery-pto.conf
  /bin/lingqu_shmem_pto_direct \
    --managed-config /tmp/holder-recovery-pto.conf \
    >/tmp/holder-recovery-pto.log 2>&1 &
  pto_pid=$!

  if [ "$node" = "0" ]; then
    generation="$(/bin/busybox sed -n \
      's/.*generation=\([0-9][0-9]*\).*/\1/p' \
      /tmp/holder-recovery-allocate.log | /bin/busybox head -n 1)"
    [ -n "$generation" ] || return 1
    {
      echo "session_id=holder-recovery-controller"
      echo "connect=$connect"
      echo "request_timeout_ms=30000"
      echo "op=wait_state key=$key state=active timeout_ms=60000 poll_ms=50"
      echo "op=wait_state key=$ready_key state=active timeout_ms=60000 poll_ms=50"
      echo "op=wait_state key=$pto_ready_key state=active timeout_ms=60000 poll_ms=50"
      echo "op=wait_state key=$receipt_gate_key state=active timeout_ms=60000 poll_ms=50"
    } >/tmp/holder-recovery-controller.conf
    /bin/linqu_mem_service object-session \
      --config /tmp/holder-recovery-controller.conf || return 1

    attempt=0
    while [ "$attempt" -lt 600 ]; do
      result=0
      /bin/linqu_mem_service provider-directory-status --connect "$connect" \
        >/tmp/holder-recovery-replacement.log 2>&1 || result=$?
      if [ "$result" -eq 0 ] &&
          /bin/busybox grep -q 'provider_active_count=2' \
          /tmp/holder-recovery-replacement.log &&
          /bin/busybox grep -q 'provider_directory_ready=1' \
          /tmp/holder-recovery-replacement.log &&
          /bin/busybox grep -Eq 'expired_count=[1-9][0-9]*' \
          /tmp/holder-recovery-replacement.log &&
          /bin/busybox grep -q \
          "provider=guest-node-1 incarnation=$replacement " \
          /tmp/holder-recovery-replacement.log; then
        break
      fi
      attempt=$((attempt + 1))
      /bin/busybox sleep 0.1
    done
    /bin/busybox cat /tmp/holder-recovery-replacement.log
    [ "$attempt" -lt 600 ] || return 1
    echo "mem_service holder-recovery: node=0 phase=replacement-directory status=ready incarnation=$replacement"

    attempt=0
    while [ "$attempt" -lt 600 ]; do
      result=0
      /bin/linqu_mem_service recover-allocation --connect "$connect" \
        --timeout-ms 1000 --max-attempts 1 \
        --key "$key" --node-id guest-node-0 --incarnation "$incarnation" \
        --generation "$generation" --fenced-incarnation "$incarnation" \
        --backing-gone 0 >/tmp/holder-recovery-receipt-required.log 2>&1 || result=$?
      /bin/busybox cat /tmp/holder-recovery-receipt-required.log
      if [ "$result" -eq 0 ]; then
        echo "mem_service holder-recovery: node=0 phase=receipt-required status=unexpected-success generation=$generation"
        return 1
      fi
      if /bin/busybox grep -q '^reason=holder_fence_receipt_required$' \
          /tmp/holder-recovery-receipt-required.log; then
        remaining_holders="$(/bin/busybox sed -n \
          's/^remaining_holders=\([1-9][0-9]*\)$/\1/p' \
          /tmp/holder-recovery-receipt-required.log | /bin/busybox head -n 1)"
        [ -n "$remaining_holders" ] || return 1
        break
      fi
      /bin/busybox grep -Eq \
        'reason=(state_conflict|recovery_providers_not_ready|managed_reconciliation_required)' \
        /tmp/holder-recovery-receipt-required.log || return 1
      attempt=$((attempt + 1))
      /bin/busybox sleep 0.1
    done
    [ "$attempt" -lt 600 ] || return 1
    echo "mem_service holder-recovery: node=0 phase=receipt-required status=confirmed generation=$generation remaining_holders=$remaining_holders"
    {
      echo "session_id=holder-recovery-receipt-gate"
      echo "connect=$connect"
      echo "request_timeout_ms=30000"
      echo "op=retire key=$receipt_gate_key idempotency_key=holder-recovery-receipt-required-retire"
      echo "op=wait_state key=$receipt_gate_key state=retired timeout_ms=60000 poll_ms=50"
    } >/tmp/holder-recovery-receipt-gate.conf
    /bin/linqu_mem_service object-session \
      --config /tmp/holder-recovery-receipt-gate.conf \
      >/tmp/holder-recovery-receipt-gate.log 2>&1 || {
        /bin/busybox cat /tmp/holder-recovery-receipt-gate.log
        return 1
      }
    /bin/busybox cat /tmp/holder-recovery-receipt-gate.log
    echo "mem_service holder-recovery: node=0 phase=receipt-required-gate status=retired generation=$generation"

    attempt=0
    while [ "$attempt" -lt 600 ]; do
      result=0
      /bin/linqu_mem_service recover-allocation --connect "$connect" \
        --timeout-ms 1000 --max-attempts 1 \
        --key "$key" --node-id guest-node-0 --incarnation "$incarnation" \
        --generation "$generation" --fenced-incarnation "$incarnation" \
        --backing-gone 0 >/tmp/holder-recovery-recover.log 2>&1 || result=$?
      /bin/busybox cat /tmp/holder-recovery-recover.log
      if [ "$result" -eq 0 ]; then
        /bin/busybox grep -q 'status=ok' /tmp/holder-recovery-recover.log || return 1
        /bin/busybox grep -q 'state=retiring' /tmp/holder-recovery-recover.log || return 1
        break
      fi
      /bin/busybox grep -Eq \
        'reason=(state_conflict|holder_fence_receipt_required|recovery_providers_not_ready|managed_reconciliation_required)' \
        /tmp/holder-recovery-recover.log || return 1
      attempt=$((attempt + 1))
      /bin/busybox sleep 0.1
    done
    [ "$attempt" -lt 600 ] || return 1
    {
      echo "session_id=holder-recovery-retire-wait"
      echo "connect=$connect"
      echo "request_timeout_ms=30000"
      echo "op=wait_state key=$key state=retired timeout_ms=60000 poll_ms=50"
    } >/tmp/holder-recovery-retire-wait.conf
    /bin/linqu_mem_service object-session \
      --config /tmp/holder-recovery-retire-wait.conf || return 1
    wait "$pto_pid" || pto_status=$?
    pto_pid=""
    /bin/busybox cat /tmp/holder-recovery-pto.log
    [ "$pto_status" -eq 0 ] || return 1
    /bin/busybox grep -q \
      'MANAGED_PTO_HOLDER_RECOVERY node=0 state=peer-retired' \
      /tmp/holder-recovery-pto.log || return 1
    /bin/busybox grep -q \
      'MANAGED_PTO_RESULT node=0 status=pass .*holder_recovery_probe=1 role=peer' \
      /tmp/holder-recovery-pto.log || return 1
    echo "mem_service holder-recovery: node=0 status=recovered key=$key generation=$generation state=retired"
    return 0
  fi

  {
    echo "session_id=holder-recovery-observer-1"
    echo "connect=$connect"
    echo "request_timeout_ms=30000"
    echo "op=wait_state key=$key state=active timeout_ms=60000 poll_ms=50"
    echo "op=wait_state key=$pto_ready_key state=active timeout_ms=60000 poll_ms=50"
    echo "op=wait_state key=$key state=retired timeout_ms=60000 poll_ms=50"
  } >/tmp/holder-recovery-observer.conf
  /bin/linqu_mem_service object-session \
    --config /tmp/holder-recovery-observer.conf \
    >/tmp/holder-recovery-observer.log 2>&1 &
  session_pid=$!

  attempt=0
  while [ "$attempt" -lt 300 ]; do
    if /bin/busybox grep -q \
        'MANAGED_PTO_HOLDER_RECOVERY node=1 state=prepared' \
        /tmp/holder-recovery-pto.log 2>/dev/null; then
      break
    fi
    kill -0 "$pto_pid" 2>/dev/null || {
      /bin/busybox cat /tmp/holder-recovery-pto.log
      return 1
    }
    attempt=$((attempt + 1))
    /bin/busybox sleep 0.1
  done
  if [ "$attempt" -ge 300 ]; then
    echo "mem_service holder-recovery: node=1 phase=pto-prepared-observed status=timeout"
    /bin/busybox cat /tmp/holder-recovery-pto.log
    kill -9 "$pto_pid" 2>/dev/null || true
    wait "$pto_pid" 2>/dev/null || true
    pto_pid=""
    return 1
  fi
  pto_op="$(/bin/busybox sed -n \
    's/.*state=prepared op_id=\([0-9][0-9]*\).*/\1/p' \
    /tmp/holder-recovery-pto.log | /bin/busybox head -n 1)"
  [ -n "$pto_op" ] || return 1
  echo "mem_service holder-recovery: node=1 phase=pto-prepared-observed op_id=$pto_op"
  /bin/linqu_mem_service allocate-object --connect "$connect" \
    --key "$ready_key" --idempotency-key holder-recovery-ready \
    --session-id holder-recovery-pto-controller --home-node guest-node-0 \
    --size-bytes 65536 --capabilities 1 \
    >/tmp/holder-recovery-ready.log 2>&1 || return 1
  /bin/busybox cat /tmp/holder-recovery-ready.log
  /bin/linqu_mem_service allocate-object --connect "$connect" \
    --key "$pto_ready_key" --idempotency-key holder-recovery-pto-ready \
    --session-id holder-recovery-pto-controller --home-node guest-node-0 \
    --size-bytes 65536 --capabilities 1 \
    >/tmp/holder-recovery-pto-ready.log 2>&1 || return 1
  /bin/busybox cat /tmp/holder-recovery-pto-ready.log
  /bin/linqu_mem_service allocate-object --connect "$connect" \
    --key "$receipt_gate_key" \
    --idempotency-key holder-recovery-receipt-required \
    --session-id holder-recovery-pto-controller --home-node guest-node-0 \
    --size-bytes 65536 --capabilities 1 \
    >/tmp/holder-recovery-receipt-gate-allocate.log 2>&1 || return 1
  /bin/busybox cat /tmp/holder-recovery-receipt-gate-allocate.log

  kill -9 "$worker" 2>/dev/null || return 1
  wait "$worker" 2>/dev/null || true
  worker_pid=""
  attempt=0
  while [ "$attempt" -lt 60 ]; do
    result=0
    /bin/linqu_mem_service provider-directory-status --connect "$connect" \
      >/tmp/holder-recovery-loss.log 2>&1 || result=$?
    if [ "$result" -eq 0 ] &&
        /bin/busybox grep -q 'provider_active_count=1' \
        /tmp/holder-recovery-loss.log &&
        /bin/busybox grep -Eq 'expired_count=[1-9][0-9]*' \
        /tmp/holder-recovery-loss.log; then
      break
    fi
    attempt=$((attempt + 1))
    /bin/busybox sleep 1
  done
  /bin/busybox cat /tmp/holder-recovery-loss.log
  [ "$attempt" -lt 60 ] || return 1
  {
    echo "connect=$connect"
    echo "node_id=guest-node-1"
    echo "incarnation=$replacement"
    echo "readiness_generation=$replacement"
    echo "state_file=/tmp/managed-share.worker.state"
    echo "allocation_granularity_bytes=2097152"
  } >/tmp/managed-share.worker.replacement.conf
  /bin/linqu_mem_service provider-register --connect "$connect" \
    --node-id guest-node-1 --incarnation "$replacement" \
    --readiness-generation "$replacement" --capabilities 1 \
    >/tmp/holder-recovery-register.log 2>&1 || return 1
  /bin/busybox cat /tmp/holder-recovery-register.log
  /bin/busybox grep -q 'replaced=0' /tmp/holder-recovery-register.log || return 1
  {
    echo "session_id=holder-recovery-receipt-observer"
    echo "connect=$connect"
    echo "request_timeout_ms=30000"
    echo "op=wait_state key=$receipt_gate_key state=retired timeout_ms=60000 poll_ms=50"
  } >/tmp/holder-recovery-receipt-observer.conf
  /bin/linqu_mem_service object-session \
    --config /tmp/holder-recovery-receipt-observer.conf \
    >/tmp/holder-recovery-receipt-observer.log 2>&1 || {
      /bin/busybox cat /tmp/holder-recovery-receipt-observer.log
      return 1
    }
  /bin/busybox cat /tmp/holder-recovery-receipt-observer.log
  /bin/busybox grep -q \
    "action=wait_state key=$receipt_gate_key status=ok state=retired" \
    /tmp/holder-recovery-receipt-observer.log || return 1
  echo "mem_service holder-recovery: node=1 phase=receipt-required-gate status=observed old_incarnation=$incarnation current_incarnation=$replacement"
  if ! /bin/linqu_mem_service_provider_obmm fence-holder-state \
      --config /tmp/managed-share.worker.conf \
      --replacement-config /tmp/managed-share.worker.replacement.conf \
      >/tmp/holder-recovery-fence.log 2>&1; then
    /bin/busybox cat /tmp/holder-recovery-fence.log
    return 1
  fi
  /bin/busybox cat /tmp/holder-recovery-fence.log
  /bin/busybox grep -q \
    'obmm-holder-fence: status=fenced key=holder-recovery-object' \
    /tmp/holder-recovery-fence.log || return 1
  /bin/busybox grep -q \
    "obmm-holder-fence: status=complete node=guest-node-1 old_incarnation=$incarnation current_incarnation=$replacement allocations=1" \
    /tmp/holder-recovery-fence.log || return 1

  wait "$session_pid" || session_status=$?
  /bin/busybox cat /tmp/holder-recovery-observer.log
  /bin/busybox grep -q \
    'action=wait_state key=holder-recovery-object status=ok state=retired' \
    /tmp/holder-recovery-observer.log || return 1
  [ "$session_status" -eq 0 ] || return 1

  attempt=0
  while [ "$attempt" -lt 300 ]; do
    if /bin/busybox grep -q \
        'MANAGED_PTO_HOLDER_RECOVERY node=1 state=rejected' \
        /tmp/holder-recovery-pto.log 2>/dev/null; then
      break
    fi
    kill -0 "$pto_pid" 2>/dev/null || break
    attempt=$((attempt + 1))
    /bin/busybox sleep 0.1
  done
  if [ "$attempt" -ge 300 ] || ! /bin/busybox grep -q \
      'MANAGED_PTO_HOLDER_RECOVERY node=1 state=rejected' \
      /tmp/holder-recovery-pto.log 2>/dev/null; then
    echo "mem_service holder-recovery: node=1 phase=pto-rejected-observed status=timeout op_id=$pto_op"
    /bin/busybox cat /tmp/holder-recovery-pto.log
    kill -9 "$pto_pid" 2>/dev/null || true
    wait "$pto_pid" 2>/dev/null || true
    pto_pid=""
    return 1
  fi
  echo "mem_service holder-recovery: node=1 phase=pto-rejected-observed status=ok op_id=$pto_op"

  attempt=0
  while [ "$attempt" -lt 50 ]; do
    if /bin/busybox grep -q \
        'MANAGED_PTO_HOLDER_RECOVERY node=1 state=cpu-probe-start' \
        /tmp/holder-recovery-pto.log 2>/dev/null; then
      break
    fi
    kill -0 "$pto_pid" 2>/dev/null || break
    attempt=$((attempt + 1))
    /bin/busybox sleep 0.1
  done
  if ! /bin/busybox grep -q \
      'MANAGED_PTO_HOLDER_RECOVERY node=1 state=cpu-probe-start' \
      /tmp/holder-recovery-pto.log 2>/dev/null; then
    echo "mem_service holder-recovery: node=1 phase=cpu-probe-start-observed status=missing op_id=$pto_op"
    /bin/busybox cat /tmp/holder-recovery-pto.log
    kill -9 "$pto_pid" 2>/dev/null || true
    wait "$pto_pid" 2>/dev/null || true
    pto_pid=""
    return 1
  fi
  echo "mem_service holder-recovery: node=1 phase=cpu-probe-start-observed status=ok op_id=$pto_op"

  attempt=0
  while [ "$attempt" -lt 50 ]; do
    if /bin/busybox grep -q \
        'MANAGED_PTO_HOLDER_RECOVERY node=1 state=cpu-rejected' \
        /tmp/holder-recovery-pto.log 2>/dev/null; then
      break
    fi
    kill -0 "$pto_pid" 2>/dev/null || break
    attempt=$((attempt + 1))
    /bin/busybox sleep 0.1
  done
  if [ "$attempt" -ge 50 ] || ! /bin/busybox grep -q \
      'MANAGED_PTO_HOLDER_RECOVERY node=1 state=cpu-rejected' \
      /tmp/holder-recovery-pto.log 2>/dev/null; then
    if kill -0 "$pto_pid" 2>/dev/null; then
      result="timeout"
    else
      result="failed"
    fi
    echo "mem_service holder-recovery: node=1 phase=cpu-rejected-observed status=$result op_id=$pto_op"
    /bin/busybox cat /tmp/holder-recovery-pto.log
    kill -9 "$pto_pid" 2>/dev/null || true
    wait "$pto_pid" 2>/dev/null || true
    pto_pid=""
    return 1
  fi
  echo "mem_service holder-recovery: node=1 phase=cpu-rejected-observed status=ok op_id=$pto_op"

  wait "$pto_pid" || pto_status=$?
  pto_pid=""
  /bin/busybox cat /tmp/holder-recovery-pto.log
  [ "$pto_status" -eq 0 ] || return 1
  /bin/busybox grep -Eq \
    'MANAGED_PTO_HOLDER_RECOVERY node=1 state=cpu-rejected .*signal=(7|11)' \
    /tmp/holder-recovery-pto.log || return 1
  /bin/busybox grep -q \
    'MANAGED_PTO_HOLDER_RECOVERY node=1 state=rejected .*error=pto_ub_gm_' \
    /tmp/holder-recovery-pto.log || return 1
  /bin/busybox grep -q \
    'MANAGED_PTO_RESULT node=1 status=pass .*holder_recovery_probe=1 role=stale-holder old_cpu_access=rejected old_pto_access=rejected' \
    /tmp/holder-recovery-pto.log || return 1
  cpu_signal="$(/bin/busybox sed -n \
    's/.*state=cpu-rejected .* signal=\([0-9][0-9]*\) .*/\1/p' \
    /tmp/holder-recovery-pto.log | /bin/busybox head -n 1)"
  case "$cpu_signal" in 7|11) ;; *) return 1 ;; esac
  echo "mem_service holder-recovery: node=1 status=fenced old_cpu_access=rejected old_pto_access=rejected old_cpu_signal=$cpu_signal old_incarnation=$incarnation current_incarnation=$replacement"
  return 0
}

mem_service_object_share_holder_rejoin() {
  local node="$1"
  local size="$2"
  local seed="$3"
  local incarnation="$4"
  local connect="$5"
  local replacement=$((incarnation + 1))
  local bootstrap_generation=$((replacement + 1048576))
  local key="holder-recovery-rejoin-object"
  local ready_key="holder-recovery-rejoin-ready"
  local consumed_key="holder-recovery-rejoin-consumed"
  local generation=""

  if [ "$node" = "0" ]; then
    {
      echo "session_id=holder-recovery-rejoin-reader"
      echo "connect=$connect"
      echo "request_timeout_ms=30000"
      echo "holder_node_id=guest-node-0"
      echo "holder_provider_incarnation=$incarnation"
      echo "provider=obmm"
      echo "provider_node_id=0"
      echo "provider_node_count=2"
      echo "provider_generation=$bootstrap_generation"
      echo "provider_import_region_bytes=2097152"
      echo "op=wait_state key=$ready_key state=active timeout_ms=60000 poll_ms=50"
      echo "op=acquire key=$key idempotency_key=holder-rejoin-reader-acquire"
      echo "op=map key=$key flags=read"
      echo "op=wait_visible key=$key offset=0 len=$size seed=$seed"
      echo "op=read key=$key offset=0 len=$size seed=$seed"
      echo "op=unmap key=$key probe_unmapped=1"
      echo "op=release key=$key idempotency_key=holder-rejoin-reader-release"
      echo "op=allocate key=$consumed_key idempotency_key=holder-rejoin-consumed size_bytes=65536 capabilities=map"
      echo "op=wait_state key=$key state=retired timeout_ms=60000 poll_ms=50"
    } >/tmp/holder-recovery-rejoin-reader.conf
    /bin/linqu_mem_service object-session \
      --config /tmp/holder-recovery-rejoin-reader.conf \
      >/tmp/holder-recovery-rejoin-reader.log 2>&1 || {
        /bin/busybox cat /tmp/holder-recovery-rejoin-reader.log
        return 1
      }
    /bin/busybox cat /tmp/holder-recovery-rejoin-reader.log
    generation="$(/bin/busybox sed -n \
      "s/.*action=acquire key=$key status=ok state=active generation=\([0-9][0-9]*\).*/\1/p" \
      /tmp/holder-recovery-rejoin-reader.log | /bin/busybox head -n 1)"
    [ -n "$generation" ] || return 1
    echo "mem_service holder-recovery: node=0 phase=rejoin-read status=pass key=$key generation=$generation holder_incarnation=$incarnation home_incarnation=$replacement"
    return 0
  fi

  if ! /bin/linqu_mem_service_provider_obmm prepare-holder-rejoin \
      --config /tmp/managed-share.worker.conf \
      --replacement-config /tmp/managed-share.worker.replacement.conf \
      >/tmp/holder-recovery-rejoin-prepare.log 2>&1; then
    /bin/busybox cat /tmp/holder-recovery-rejoin-prepare.log
    return 1
  fi
  /bin/busybox cat /tmp/holder-recovery-rejoin-prepare.log
  /bin/busybox grep -q \
    "obmm-holder-rejoin: status=prepared node=guest-node-1 old_incarnation=$incarnation current_incarnation=$replacement ledger_entries=1 home_obligations=0 holder_obligations=0" \
    /tmp/holder-recovery-rejoin-prepare.log || return 1

  /bin/linqu_mem_service_provider_obmm serve-allocations \
    --config /tmp/managed-share.worker.replacement.conf \
    >/tmp/holder-recovery-rejoin-worker.log 2>&1 &
  worker_pid=$!
  echo "mem_service holder-recovery: node=1 phase=rejoin-worker status=started incarnation=$replacement state_file=/tmp/managed-share.worker.state"

  /bin/linqu_mem_service allocate-object --connect "$connect" \
    --key "$key" --idempotency-key holder-rejoin-allocate \
    --session-id holder-recovery-rejoin-controller --home-node guest-node-1 \
    --size-bytes "$size" --capabilities 1 \
    >/tmp/holder-recovery-rejoin-allocate.log 2>&1 || {
      /bin/busybox cat /tmp/holder-recovery-rejoin-worker.log
      /bin/busybox cat /tmp/holder-recovery-rejoin-allocate.log
      return 1
    }
  /bin/busybox cat /tmp/holder-recovery-rejoin-allocate.log
  generation="$(/bin/busybox sed -n 's/^generation=//p' \
    /tmp/holder-recovery-rejoin-allocate.log | /bin/busybox head -n 1)"
  case "$generation" in ''|0*|*[!0-9]*) return 1 ;; esac
  /bin/busybox grep -q '^home_node=guest-node-1$' \
    /tmp/holder-recovery-rejoin-allocate.log || return 1
  /bin/busybox grep -q "^provider_incarnation=$replacement$" \
    /tmp/holder-recovery-rejoin-allocate.log || return 1
  {
    echo "session_id=holder-recovery-rejoin-active"
    echo "connect=$connect"
    echo "request_timeout_ms=30000"
    echo "op=wait_state key=$key state=active timeout_ms=60000 poll_ms=50"
  } >/tmp/holder-recovery-rejoin-active.conf
  /bin/linqu_mem_service object-session \
    --config /tmp/holder-recovery-rejoin-active.conf \
    >/tmp/holder-recovery-rejoin-active.log 2>&1 || {
      /bin/busybox cat /tmp/holder-recovery-rejoin-worker.log
      /bin/busybox cat /tmp/holder-recovery-rejoin-active.log
      return 1
    }
  /bin/busybox cat /tmp/holder-recovery-rejoin-active.log
  echo "mem_service holder-recovery: node=1 phase=rejoin-allocation status=active key=$key generation=$generation home_incarnation=$replacement"

  if /bin/linqu_mem_service acquire-object --connect "$connect" \
      --key "$key" --session-id holder-recovery-rejoin-stale \
      --idempotency-key holder-rejoin-stale-acquire \
      --expected-generation "$generation" --holder-node-id guest-node-1 \
      --holder-provider-incarnation "$incarnation" \
      >/tmp/holder-recovery-rejoin-stale.log 2>&1; then
    /bin/busybox cat /tmp/holder-recovery-rejoin-stale.log
    return 1
  fi
  /bin/busybox cat /tmp/holder-recovery-rejoin-stale.log
  /bin/busybox grep -q '^status=version_conflict$' \
    /tmp/holder-recovery-rejoin-stale.log || return 1
  /bin/busybox grep -q '^reason=holder_provider_mismatch$' \
    /tmp/holder-recovery-rejoin-stale.log || return 1
  echo "mem_service holder-recovery: node=1 phase=rejoin-stale-identity status=rejected old_incarnation=$incarnation current_incarnation=$replacement reason=holder_provider_mismatch"

  {
    echo "session_id=holder-recovery-rejoin-writer"
    echo "connect=$connect"
    echo "request_timeout_ms=30000"
    echo "holder_node_id=guest-node-1"
    echo "holder_provider_incarnation=$replacement"
    echo "provider=obmm"
    echo "provider_node_id=1"
    echo "provider_node_count=2"
    echo "provider_generation=$bootstrap_generation"
    echo "provider_import_region_bytes=2097152"
    echo "op=acquire key=$key idempotency_key=holder-rejoin-writer-acquire expected_generation=$generation"
    echo "op=map key=$key flags=readwrite"
    echo "op=write key=$key offset=0 len=$size seed=$seed"
    echo "op=publish_data key=$key offset=0 len=$size seed=$seed"
    echo "op=allocate key=$ready_key idempotency_key=holder-rejoin-ready size_bytes=65536 capabilities=map"
    echo "op=wait_state key=$consumed_key state=active timeout_ms=60000 poll_ms=50"
    echo "op=unmap key=$key probe_unmapped=1"
    echo "op=release key=$key idempotency_key=holder-rejoin-writer-release"
    echo "op=retire key=$key idempotency_key=holder-rejoin-retire"
    echo "op=wait_state key=$key state=retired timeout_ms=60000 poll_ms=50"
    echo "op=retire key=$ready_key idempotency_key=holder-rejoin-ready-retire"
    echo "op=wait_state key=$ready_key state=retired timeout_ms=60000 poll_ms=50"
    echo "op=retire key=$consumed_key idempotency_key=holder-rejoin-consumed-retire"
    echo "op=wait_state key=$consumed_key state=retired timeout_ms=60000 poll_ms=50"
  } >/tmp/holder-recovery-rejoin-writer.conf
  /bin/linqu_mem_service object-session \
    --config /tmp/holder-recovery-rejoin-writer.conf \
    >/tmp/holder-recovery-rejoin-writer.log 2>&1 || {
      /bin/busybox cat /tmp/holder-recovery-rejoin-worker.log
      /bin/busybox cat /tmp/holder-recovery-rejoin-writer.log
      return 1
    }
  /bin/busybox cat /tmp/holder-recovery-rejoin-writer.log
  /bin/busybox cat /tmp/holder-recovery-rejoin-worker.log
  /bin/busybox grep -q \
    "obmm-worker work key=$key generation=$generation state=allocating" \
    /tmp/holder-recovery-rejoin-worker.log || return 1
  /bin/busybox grep -q \
    "obmm-worker generation=$generation phase=published " \
    /tmp/holder-recovery-rejoin-worker.log || return 1
  /bin/busybox grep -q \
    "obmm-worker generation=$generation phase=reclaimed " \
    /tmp/holder-recovery-rejoin-worker.log || return 1
  kill -0 "$worker_pid" 2>/dev/null || return 1
  echo "mem_service holder-recovery: node=1 phase=rejoin-write status=pass key=$key generation=$generation home_incarnation=$replacement"
  echo "mem_service holder-recovery: node=1 status=rejoined old_incarnation=$incarnation current_incarnation=$replacement key=$key generation=$generation"
  return 0
}

mem_service_object_share_manager_recovery() {
  local node="$1"
  local size="$2"
  local incarnation="$3"
  local connect="$4"
  local daemon="$5"
  local worker="$6"
  local key="recovery-fault-manager-crash"
  local generation=""
  local manager_status=0
  local worker_status=0
  local attempt=0
  local field=""
  local before=""
  local after=""
  local backing_bytes=""
  local address_bytes=""
  local quarantined_bytes=""

  attempt=0
  while [ "$attempt" -lt 1200 ]; do
    if /bin/linqu_mem_service provider-directory-status --connect "$connect" \
        --timeout-ms 1000 --max-attempts 1 \
        >/tmp/manager-recovery-directory-ready.log 2>&1 &&
        /bin/busybox grep -qx 'provider_active_count=2' \
          /tmp/manager-recovery-directory-ready.log &&
        /bin/busybox grep -qx 'provider_directory_ready=1' \
          /tmp/manager-recovery-directory-ready.log; then
      break
    fi
    attempt=$((attempt + 1))
    /bin/busybox sleep 0.05
  done
  [ "$attempt" -lt 1200 ] || return 1

  if [ "$node" = "1" ]; then
    attempt=0
    while [ "$attempt" -lt 1200 ]; do
      if /bin/linqu_mem_service inspect-allocation --connect "$connect" \
          --key "$key" >/tmp/manager-recovery-peer-before.log 2>&1 &&
          /bin/busybox grep -qx 'state=active' \
            /tmp/manager-recovery-peer-before.log; then
        break
      fi
      attempt=$((attempt + 1))
      /bin/busybox sleep 0.05
    done
    [ "$attempt" -lt 1200 ] || return 1
    generation="$(/bin/busybox sed -n 's/^generation=//p' \
      /tmp/manager-recovery-peer-before.log | /bin/busybox head -n 1)"
    case "$generation" in ''|0*|*[!0-9]*) return 1 ;; esac
    /bin/linqu_mem_service acquire-object --connect "$connect" \
      --key "$key" --session-id manager-recovery-holder \
      --idempotency-key manager-recovery-holder-acquire \
      --expected-generation "$generation" --holder-node-id guest-node-1 \
      --holder-provider-incarnation "$incarnation" \
      >/tmp/manager-recovery-holder.log 2>&1 || {
        /bin/busybox cat /tmp/manager-recovery-holder.log
        return 1
      }
    /bin/busybox cat /tmp/manager-recovery-holder.log
    echo "mem_service manager-recovery: node=1 phase=holder status=ready fault=manager_crash key=$key generation=$generation live_refs=1"

    mem_service_object_share_wait_control_plane_state "$connect" down || return 1
    echo "mem_service manager-recovery: node=1 phase=manager-transition status=down restart=1"
    attempt=0
    while kill -0 "$worker" 2>/dev/null && [ "$attempt" -lt 200 ]; do
      attempt=$((attempt + 1))
      /bin/busybox sleep 0.05
    done
    kill -0 "$worker" 2>/dev/null && return 1
    wait "$worker" || worker_status=$?
    [ "$worker_status" -ne 0 ] || return 1
    worker_pid=""
    echo "mem_service manager-recovery: node=1 phase=worker-exit status=expected exit_code=$worker_status"
    mem_service_object_share_wait_control_plane_state "$connect" up || return 1
    echo "mem_service manager-recovery: node=1 phase=manager-transition status=up restart=1"
    mem_service_object_share_wait_control_plane_state "$connect" down || return 1
    echo "mem_service manager-recovery: node=1 phase=manager-transition status=down restart=2"
    mem_service_object_share_wait_control_plane_state "$connect" up || return 1
    echo "mem_service manager-recovery: node=1 phase=manager-transition status=up restart=2"

    /bin/linqu_mem_service provider-register --connect "$connect" \
      --node-id guest-node-1 --incarnation "$incarnation" \
      --readiness-generation "$incarnation" --capabilities 1 || return 1
    attempt=0
    while [ "$attempt" -lt 1200 ]; do
      if /bin/linqu_mem_service provider-directory-status --connect "$connect" \
          >/tmp/manager-recovery-peer-directory.log 2>&1 &&
          /bin/busybox grep -qx 'provider_active_count=2' \
            /tmp/manager-recovery-peer-directory.log &&
          /bin/busybox grep -qx 'provider_directory_ready=1' \
            /tmp/manager-recovery-peer-directory.log &&
          /bin/busybox grep -qx 'data_plane_ready=0' \
            /tmp/manager-recovery-peer-directory.log; then
        break
      fi
      attempt=$((attempt + 1))
      /bin/busybox sleep 0.05
    done
    [ "$attempt" -lt 1200 ] || return 1
    /bin/busybox cat /tmp/manager-recovery-peer-directory.log
    /bin/linqu_mem_service inspect-allocation --connect "$connect" --key "$key" \
      >/tmp/manager-recovery-peer-after.log 2>&1 || return 1
    /bin/busybox cat /tmp/manager-recovery-peer-after.log
    /bin/busybox grep -qx 'state=quarantined' \
      /tmp/manager-recovery-peer-after.log || return 1
    /bin/busybox grep -qx "generation=$generation" \
      /tmp/manager-recovery-peer-after.log || return 1
    /bin/busybox grep -qx 'live_refs=1' \
      /tmp/manager-recovery-peer-after.log || return 1
    /bin/linqu_mem_service allocation-stats --connect "$connect" \
      >/tmp/manager-recovery-peer-stats.log 2>&1 || return 1
    /bin/busybox cat /tmp/manager-recovery-peer-stats.log
    /bin/busybox grep -qx 'managed_recovery_required=1' \
      /tmp/manager-recovery-peer-stats.log || return 1
    echo "mem_service manager-recovery: node=1 phase=observation status=pass fault=manager_crash key=$key generation=$generation state=quarantined live_refs=1 restarts=2"
    return 0
  fi

  /bin/linqu_mem_service allocate-object --connect "$connect" \
    --key "$key" --idempotency-key manager-recovery-allocate \
    --session-id manager-recovery-controller --home-node guest-node-0 \
    --size-bytes "$size" --capabilities 1 \
    >/tmp/manager-recovery-allocate.log 2>&1 || return 1
  /bin/busybox cat /tmp/manager-recovery-allocate.log
  generation="$(/bin/busybox sed -n 's/^generation=//p' \
    /tmp/manager-recovery-allocate.log | /bin/busybox head -n 1)"
  case "$generation" in ''|0*|*[!0-9]*) return 1 ;; esac
  attempt=0
  while [ "$attempt" -lt 1200 ]; do
    if /bin/linqu_mem_service inspect-allocation --connect "$connect" \
        --key "$key" >/tmp/manager-recovery-before.log 2>&1 &&
        /bin/busybox grep -qx 'state=active' /tmp/manager-recovery-before.log &&
        /bin/busybox grep -qx 'provider_backed=1' \
          /tmp/manager-recovery-before.log &&
        /bin/busybox grep -qx 'live_refs=1' \
          /tmp/manager-recovery-before.log; then
      break
    fi
    attempt=$((attempt + 1))
    /bin/busybox sleep 0.05
  done
  [ "$attempt" -lt 1200 ] || return 1
  /bin/busybox cat /tmp/manager-recovery-before.log
  echo "mem_service manager-recovery: node=0 phase=active status=ready fault=manager_crash key=$key generation=$generation live_refs=1"

  kill -9 "$daemon" 2>/dev/null || return 1
  wait "$daemon" || manager_status=$?
  [ "$manager_status" -eq 137 ] || return 1
  daemon_pid=""
  echo "mem_service manager-recovery: node=0 phase=manager-exit status=expected restart=1 signal=9 exit_code=$manager_status"
  attempt=0
  while kill -0 "$worker" 2>/dev/null && [ "$attempt" -lt 200 ]; do
    attempt=$((attempt + 1))
    /bin/busybox sleep 0.05
  done
  kill -0 "$worker" 2>/dev/null && return 1
  wait "$worker" || worker_status=$?
  [ "$worker_status" -ne 0 ] || return 1
  worker_pid=""
  /bin/busybox cat /tmp/managed-share.worker.log
  echo "mem_service manager-recovery: node=0 phase=worker-exit status=expected exit_code=$worker_status"
  /bin/busybox grep -q '^mem_service_store_managed_v2$' \
    /tmp/managed-share.store || return 1
  /bin/busybox grep -q '^managed_store_complete=1$' \
    /tmp/managed-share.store || return 1
  /bin/busybox sleep 1

  /bin/linqu_mem_service serve --config /tmp/managed-share.daemon.conf &
  daemon_pid=$!
  daemon="$daemon_pid"
  mem_service_object_share_wait_daemon "$connect" "$daemon" || return 1
  /bin/linqu_mem_service inspect-allocation --connect "$connect" --key "$key" \
    >/tmp/manager-recovery-after-1.log 2>&1 || return 1
  /bin/linqu_mem_service allocation-stats --connect "$connect" \
    >/tmp/manager-recovery-stats-1.log 2>&1 || return 1
  /bin/linqu_mem_service provider-directory-status --connect "$connect" \
    >/tmp/manager-recovery-directory-1.log 2>&1 || return 1
  for field in key generation home_node provider_incarnation descriptor_hex address address_len live_refs; do
    before="$(/bin/busybox sed -n "s/^$field=//p" \
      /tmp/manager-recovery-before.log | /bin/busybox head -n 1)"
    after="$(/bin/busybox sed -n "s/^$field=//p" \
      /tmp/manager-recovery-after-1.log | /bin/busybox head -n 1)"
    [ -n "$before" ] && [ "$before" = "$after" ] || return 1
  done
  /bin/busybox grep -qx 'state=quarantined' \
    /tmp/manager-recovery-after-1.log || return 1
  /bin/busybox grep -qx 'provider_backed=1' \
    /tmp/manager-recovery-after-1.log || return 1
  /bin/busybox grep -qx 'managed_recovery_required=1' \
    /tmp/manager-recovery-stats-1.log || return 1
  /bin/busybox grep -qx 'quarantined_objects=1' \
    /tmp/manager-recovery-stats-1.log || return 1
  /bin/busybox grep -qx 'live_refs=1' \
    /tmp/manager-recovery-stats-1.log || return 1
  /bin/busybox grep -qx 'provider_active_count=0' \
    /tmp/manager-recovery-directory-1.log || return 1
  /bin/busybox grep -qx 'provider_directory_ready=0' \
    /tmp/manager-recovery-directory-1.log || return 1
  /bin/busybox grep -qx 'data_plane_ready=0' \
    /tmp/manager-recovery-directory-1.log || return 1
  /bin/busybox cat /tmp/manager-recovery-after-1.log
  /bin/busybox cat /tmp/manager-recovery-stats-1.log
  /bin/busybox cat /tmp/manager-recovery-directory-1.log
  echo "mem_service manager-recovery: node=0 phase=restart status=isolated restart=1 key=$key generation=$generation state=quarantined provider_backed=1 live_refs=1 identity_preserved=1 managed_recovery_required=1"
  /bin/busybox sleep 1

  manager_status=0
  kill -9 "$daemon" 2>/dev/null || return 1
  wait "$daemon" || manager_status=$?
  [ "$manager_status" -eq 137 ] || return 1
  daemon_pid=""
  echo "mem_service manager-recovery: node=0 phase=manager-exit status=expected restart=2 signal=9 exit_code=$manager_status"
  /bin/busybox sleep 1
  /bin/linqu_mem_service serve --config /tmp/managed-share.daemon.conf &
  daemon_pid=$!
  daemon="$daemon_pid"
  mem_service_object_share_wait_daemon "$connect" "$daemon" || return 1
  /bin/linqu_mem_service inspect-allocation --connect "$connect" --key "$key" \
    >/tmp/manager-recovery-after-2.log 2>&1 || return 1
  /bin/linqu_mem_service allocation-stats --connect "$connect" \
    >/tmp/manager-recovery-stats-2.log 2>&1 || return 1
  /bin/linqu_mem_service provider-directory-status --connect "$connect" \
    >/tmp/manager-recovery-directory-2.log 2>&1 || return 1
  for field in key generation home_node provider_incarnation descriptor_hex address address_len live_refs; do
    before="$(/bin/busybox sed -n "s/^$field=//p" \
      /tmp/manager-recovery-before.log | /bin/busybox head -n 1)"
    after="$(/bin/busybox sed -n "s/^$field=//p" \
      /tmp/manager-recovery-after-2.log | /bin/busybox head -n 1)"
    [ -n "$before" ] && [ "$before" = "$after" ] || return 1
  done
  /bin/busybox grep -qx 'state=quarantined' \
    /tmp/manager-recovery-after-2.log || return 1
  /bin/busybox grep -qx 'provider_backed=1' \
    /tmp/manager-recovery-after-2.log || return 1
  /bin/busybox grep -qx 'managed_recovery_required=1' \
    /tmp/manager-recovery-stats-2.log || return 1
  /bin/busybox grep -qx 'quarantined_objects=1' \
    /tmp/manager-recovery-stats-2.log || return 1
  /bin/busybox grep -qx 'live_refs=1' \
    /tmp/manager-recovery-stats-2.log || return 1
  /bin/busybox grep -Eq '^provider_active_count=(0|1)$' \
    /tmp/manager-recovery-directory-2.log || return 1
  /bin/busybox grep -qx 'provider_directory_ready=0' \
    /tmp/manager-recovery-directory-2.log || return 1
  /bin/busybox grep -qx 'data_plane_ready=0' \
    /tmp/manager-recovery-directory-2.log || return 1
  echo "mem_service manager-recovery: node=0 phase=restart status=isolated restart=2 key=$key generation=$generation state=quarantined provider_backed=1 live_refs=1 identity_preserved=1 managed_recovery_required=1"

  /bin/linqu_mem_service provider-register --connect "$connect" \
    --node-id guest-node-0 --incarnation "$incarnation" \
    --readiness-generation "$incarnation" --capabilities 1 || return 1
  attempt=0
  while [ "$attempt" -lt 1200 ]; do
    if /bin/linqu_mem_service provider-directory-status --connect "$connect" \
        >/tmp/manager-recovery-directory-final.log 2>&1 &&
        /bin/busybox grep -qx 'provider_active_count=2' \
          /tmp/manager-recovery-directory-final.log &&
        /bin/busybox grep -qx 'provider_directory_ready=1' \
          /tmp/manager-recovery-directory-final.log &&
        /bin/busybox grep -qx 'data_plane_ready=0' \
          /tmp/manager-recovery-directory-final.log; then
      break
    fi
    attempt=$((attempt + 1))
    /bin/busybox sleep 0.05
  done
  [ "$attempt" -lt 1200 ] || return 1
  /bin/busybox cat /tmp/manager-recovery-directory-final.log
  echo "mem_service manager-recovery: node=0 phase=directory status=isolated provider_active_count=2 provider_directory_ready=1 data_plane_ready=0"

  if /bin/linqu_mem_service acquire-object --connect "$connect" \
      --key "$key" --session-id manager-recovery-holder \
      --idempotency-key manager-recovery-holder-acquire \
      --expected-generation "$generation" --holder-node-id guest-node-1 \
      --holder-provider-incarnation "$incarnation" \
      >/tmp/manager-recovery-old-replay.log 2>&1; then
    return 1
  fi
  /bin/busybox cat /tmp/manager-recovery-old-replay.log
  /bin/busybox grep -qx 'reason=managed_reconciliation_required' \
    /tmp/manager-recovery-old-replay.log || return 1
  echo "mem_service manager-recovery: node=0 phase=old-replay status=rejected reason=managed_reconciliation_required key=$key generation=$generation"
  if /bin/linqu_mem_service allocate-object --connect "$connect" \
      --key manager-recovery-new --idempotency-key manager-recovery-new-allocate \
      --session-id manager-recovery-controller --home-node guest-node-0 \
      --size-bytes "$size" --capabilities 1 \
      >/tmp/manager-recovery-new.log 2>&1; then
    return 1
  fi
  /bin/busybox cat /tmp/manager-recovery-new.log
  /bin/busybox grep -qx 'reason=managed_reconciliation_required' \
    /tmp/manager-recovery-new.log || return 1
  echo "mem_service manager-recovery: node=0 phase=new-allocation status=rejected reason=managed_reconciliation_required"

  backing_bytes="$(/bin/busybox sed -n 's/^backing_allocated_bytes=//p' \
    /tmp/manager-recovery-stats-2.log | /bin/busybox head -n 1)"
  address_bytes="$(/bin/busybox sed -n 's/^address_reserved_bytes=//p' \
    /tmp/manager-recovery-stats-2.log | /bin/busybox head -n 1)"
  quarantined_bytes="$(/bin/busybox sed -n 's/^quarantined_bytes=//p' \
    /tmp/manager-recovery-stats-2.log | /bin/busybox head -n 1)"
  [ "$backing_bytes" = "0" ] || return 1
  [ "$address_bytes" = "0" ] || return 1
  case "$quarantined_bytes" in ''|0|*[!0-9]*) return 1 ;; esac
  echo "mem_service manager-recovery: node=0 phase=observation status=pass fault=manager_crash key=$key generation=$generation state=quarantined live_refs=1 backing_allocated_bytes=$backing_bytes address_reserved_bytes=$address_bytes quarantined_bytes=$quarantined_bytes restarts=2"
  return 0
}

mem_service_object_share_guest_recovery() {
  local node="$1"
  local size="$2"
  local home_incarnation="$3"
  local current_incarnation="$4"
  local connect="$5"
  local role="$6"
  local cycle="$7"
  local aperture_size="$8"
  local cycle_suffix=""
  local key=""
  local generation=""
  local attempt=0
  local session_pid=""
  local peer_pid=""
  local before=""
  local after=""
  local field=""
  local address=""
  local result=0
  local old_incarnation=0
  local replacement_incarnation=0
  local terminated_kernel_instance=""
  local replacement_kernel_instance=""
  local rejoin_key=""
  local rejoin_ready_key=""
  local rejoin_consumed_key=""
  local rejoin_generation=""
  local rejoin_seed=0
  local bootstrap_generation=0
  local holder_canary_generation=0

  case "$role" in holder|replacement|home) ;; *) return 2 ;; esac
  case "$cycle" in ''|0|*[!0-9]*) return 2 ;; esac
  [ "$cycle" -le 8 ] || return 2
  if [ "$node" = "0" ]; then
    [ "$role" = "home" ] || return 2
  elif [ "$node" = "1" ]; then
    [ "$role" != "home" ] || return 2
  else
    return 2
  fi
  [ "$cycle" = "1" ] || cycle_suffix="-$cycle"
  key="recovery-fault-guest-crash$cycle_suffix"
  rejoin_key="guest-recovery-rejoin-object$cycle_suffix"
  rejoin_ready_key="guest-recovery-rejoin-ready$cycle_suffix"
  rejoin_consumed_key="guest-recovery-rejoin-consumed$cycle_suffix"
  old_incarnation=$((home_incarnation + cycle - 1))
  replacement_incarnation=$((old_incarnation + 1))
  rejoin_seed=$((90 + cycle))
  bootstrap_generation=$((replacement_incarnation + 1048576))
  holder_canary_generation=$((old_incarnation + 101))

  attempt=0
  while [ "$attempt" -lt 1200 ]; do
    if /bin/linqu_mem_service provider-directory-status --connect "$connect" \
        >/tmp/guest-recovery-directory-ready.log 2>&1 &&
        /bin/busybox grep -qx 'provider_active_count=2' \
          /tmp/guest-recovery-directory-ready.log &&
        /bin/busybox grep -qx 'provider_directory_ready=1' \
          /tmp/guest-recovery-directory-ready.log; then
      break
    fi
    attempt=$((attempt + 1))
    /bin/busybox sleep 0.05
  done
  [ "$attempt" -lt 1200 ] || return 1

  if [ "$role" = "holder" ]; then
    attempt=0
    while [ "$attempt" -lt 1200 ]; do
      if /bin/linqu_mem_service inspect-allocation --connect "$connect" \
          --key "$key" >/tmp/guest-recovery-holder-before.log 2>&1 &&
          /bin/busybox grep -qx 'state=active' \
            /tmp/guest-recovery-holder-before.log; then
        break
      fi
      attempt=$((attempt + 1))
      /bin/busybox sleep 0.05
    done
    [ "$attempt" -lt 1200 ] || return 1
    generation="$(/bin/busybox sed -n 's/^generation=//p' \
      /tmp/guest-recovery-holder-before.log | /bin/busybox head -n 1)"
    case "$generation" in ''|0*|*[!0-9]*) return 1 ;; esac
    {
      echo "session_id=guest-recovery-holder$cycle_suffix"
      echo "connect=$connect"
      echo "request_timeout_ms=30000"
      echo "holder_node_id=guest-node-1"
      echo "holder_provider_incarnation=$old_incarnation"
      echo "provider=obmm"
      echo "provider_node_id=1"
      echo "provider_node_count=2"
      echo "provider_generation=$holder_canary_generation"
      echo "provider_import_region_bytes=2097152"
      echo "op=acquire key=$key idempotency_key=guest-recovery-holder-acquire$cycle_suffix expected_generation=$generation"
      echo "op=map key=$key flags=read"
      echo "op=wait_state key=$key state=quarantined timeout_ms=60000 poll_ms=100"
    } >/tmp/guest-recovery-holder.conf
    /bin/linqu_mem_service object-session \
      --config /tmp/guest-recovery-holder.conf \
      >/tmp/guest-recovery-holder.log 2>&1 &
    session_pid=$!
    attempt=0
    while [ "$attempt" -lt 1200 ]; do
      if /bin/linqu_mem_service inspect-allocation --connect "$connect" \
          --key "$key" >/tmp/guest-recovery-holder-active.log 2>&1 &&
          /bin/busybox grep -qx 'state=active' \
            /tmp/guest-recovery-holder-active.log &&
          /bin/busybox grep -qx 'live_refs=1' \
            /tmp/guest-recovery-holder-active.log &&
          /bin/linqu_mem_service allocation-stats --connect "$connect" \
            >/tmp/guest-recovery-holder-stats.log 2>&1 &&
          /bin/busybox grep -qx 'import_mappings=1' \
            /tmp/guest-recovery-holder-stats.log; then
        break
      fi
      kill -0 "$session_pid" 2>/dev/null || {
        /bin/busybox cat /tmp/guest-recovery-holder.log
        return 1
      }
      attempt=$((attempt + 1))
      /bin/busybox sleep 0.05
    done
    [ "$attempt" -lt 1200 ] || {
      /bin/busybox cat /tmp/guest-recovery-holder.log
      /bin/busybox cat /tmp/guest-recovery-holder-active.log
      /bin/busybox cat /tmp/guest-recovery-holder-stats.log
      return 1
    }
    address="$(/bin/busybox sed -n 's/^address=//p' \
      /tmp/guest-recovery-holder-active.log | /bin/busybox head -n 1)"
    case "$address" in ''|0|*[!0-9]*) return 1 ;; esac
    /bin/linqu_gva_manager --dump-segments \
      >/tmp/guest-recovery-terminated-kernel.log 2>&1 || return 1
    terminated_kernel_instance="$(/bin/busybox sed -n \
      's/.* kernel_instance=\([0-9a-f][0-9a-f]*\) .*/\1/p' \
      /tmp/guest-recovery-terminated-kernel.log | /bin/busybox head -n 1)"
    case "$terminated_kernel_instance" in
      ''|*[!0-9a-f]*) return 1 ;;
    esac
    [ "${#terminated_kernel_instance}" -eq 32 ] || return 1
    /bin/busybox cat /tmp/guest-recovery-holder-active.log
    /bin/busybox cat /tmp/guest-recovery-holder-stats.log
    /bin/busybox cat /tmp/guest-recovery-terminated-kernel.log
    echo "mem_service guest-recovery: node=1 phase=crash-ready status=ready fault=guest_crash cycle=$cycle key=$key generation=$generation incarnation=$old_incarnation address=$address live_refs=1 import_mappings=1 mapping=active kernel_instance=$terminated_kernel_instance"
    while kill -0 "$session_pid" 2>/dev/null; do
      /bin/busybox sleep 1
    done
    /bin/busybox cat /tmp/guest-recovery-holder.log
    return 1
  fi

  if [ "$role" = "replacement" ]; then
    terminated_kernel_instance="$(cmdline_value \
      mem_service.object_share_terminated_kernel_instance '')"
    case "$terminated_kernel_instance" in
      ''|*[!0-9a-f]*) return 1 ;;
    esac
    [ "${#terminated_kernel_instance}" -eq 32 ] || return 1
    [ "$current_incarnation" = "$replacement_incarnation" ] || return 2
    attempt=0
    while [ "$attempt" -lt 1200 ]; do
      if /bin/linqu_mem_service inspect-allocation --connect "$connect" \
          --key "$key" >/tmp/guest-recovery-replacement.log 2>&1 &&
          /bin/busybox grep -qx 'state=quarantined' \
            /tmp/guest-recovery-replacement.log &&
          /bin/linqu_mem_service allocation-stats --connect "$connect" \
            >/tmp/guest-recovery-replacement-stats.log 2>&1 &&
          /bin/busybox grep -qx 'managed_recovery_required=1' \
            /tmp/guest-recovery-replacement-stats.log &&
          /bin/linqu_mem_service provider-directory-status --connect "$connect" \
            >/tmp/guest-recovery-replacement-directory.log 2>&1 &&
          /bin/busybox grep -qx 'provider_active_count=2' \
            /tmp/guest-recovery-replacement-directory.log &&
          /bin/busybox grep -qx 'provider_directory_ready=1' \
            /tmp/guest-recovery-replacement-directory.log &&
          /bin/busybox grep -qx 'data_plane_ready=0' \
            /tmp/guest-recovery-replacement-directory.log &&
          /bin/busybox grep -q \
            "^provider=guest-node-1 incarnation=$replacement_incarnation " \
            /tmp/guest-recovery-replacement-directory.log; then
        break
      fi
      attempt=$((attempt + 1))
      /bin/busybox sleep 0.05
    done
    [ "$attempt" -lt 1200 ] || return 1
    generation="$(/bin/busybox sed -n 's/^generation=//p' \
      /tmp/guest-recovery-replacement.log | /bin/busybox head -n 1)"
    case "$generation" in ''|0*|*[!0-9]*) return 1 ;; esac
    /bin/busybox cat /tmp/guest-recovery-replacement.log
    /bin/busybox cat /tmp/guest-recovery-replacement-stats.log
    /bin/busybox cat /tmp/guest-recovery-replacement-directory.log
    echo "mem_service guest-recovery: node=1 phase=replacement status=isolated fault=guest_crash cycle=$cycle key=$key generation=$generation incarnation=$replacement_incarnation state=quarantined managed_recovery_required=1 data_plane_ready=0"

    {
      echo "connect=$connect"
      echo "node_id=guest-node-1"
      echo "incarnation=$old_incarnation"
      echo "readiness_generation=$old_incarnation"
      echo "state_file=/tmp/managed-share.worker.state"
      echo "allocation_granularity_bytes=2097152"
    } >/tmp/guest-recovery-terminated-holder.conf
    if ! /bin/linqu_mem_service_provider_obmm \
        fence-terminated-holder-state \
        --config /tmp/guest-recovery-terminated-holder.conf \
        --replacement-config /tmp/managed-share.worker.resume.conf \
        --terminated-kernel-instance "$terminated_kernel_instance" \
        >/tmp/guest-recovery-terminated-fence.log 2>&1; then
      /bin/busybox cat /tmp/guest-recovery-terminated-fence.log
      return 1
    fi
    /bin/busybox cat /tmp/guest-recovery-terminated-fence.log
    /bin/busybox grep -q \
      "obmm-terminated-holder-fence: status=fenced key=$key generation=$generation old_incarnation=$old_incarnation current_incarnation=$replacement_incarnation route_state=absent-after-kernel-replacement" \
      /tmp/guest-recovery-terminated-fence.log || return 1
    /bin/busybox grep -q \
      "obmm-terminated-holder-fence: status=complete node=guest-node-1 old_incarnation=$old_incarnation current_incarnation=$replacement_incarnation allocations=1 inventory_records=0" \
      /tmp/guest-recovery-terminated-fence.log || return 1
    replacement_kernel_instance="$(/bin/busybox sed -n \
      's/.* current_kernel_instance=\([0-9a-f][0-9a-f]*\)$/\1/p' \
      /tmp/guest-recovery-terminated-fence.log | /bin/busybox head -n 1)"
    case "$replacement_kernel_instance" in
      ''|*[!0-9a-f]*) return 1 ;;
    esac
    [ "${#replacement_kernel_instance}" -eq 32 ] || return 1
    [ "$replacement_kernel_instance" != "$terminated_kernel_instance" ] || return 1
    echo "mem_service guest-recovery: node=1 phase=holder-fenced status=complete fault=guest_crash cycle=$cycle key=$key generation=$generation old_incarnation=$old_incarnation new_incarnation=$replacement_incarnation old_kernel_instance=$terminated_kernel_instance new_kernel_instance=$replacement_kernel_instance route_state=absent-after-kernel-replacement receipt=complete"

    {
      echo "session_id=guest-recovery-retired-observer$cycle_suffix"
      echo "connect=$connect"
      echo "request_timeout_ms=30000"
      echo "op=wait_state key=$key state=retired timeout_ms=60000 poll_ms=50"
    } >/tmp/guest-recovery-retired-observer.conf
    /bin/linqu_mem_service object-session \
      --config /tmp/guest-recovery-retired-observer.conf \
      >/tmp/guest-recovery-retired-observer.log 2>&1 || {
        /bin/busybox cat /tmp/guest-recovery-retired-observer.log
        return 1
      }
    /bin/busybox cat /tmp/guest-recovery-retired-observer.log

    /bin/linqu_mem_service_provider_obmm serve-allocations \
      --config /tmp/managed-share.worker.resume.conf \
      >/tmp/guest-recovery-rejoin-worker.log 2>&1 &
    worker_pid=$!
    /bin/linqu_mem_service allocate-object --connect "$connect" \
      --key "$rejoin_key" --idempotency-key "guest-recovery-rejoin-allocate$cycle_suffix" \
      --session-id "guest-recovery-rejoin-controller$cycle_suffix" \
      --home-node guest-node-1 --size-bytes "$size" --capabilities 1 \
      >/tmp/guest-recovery-rejoin-allocate.log 2>&1 || {
        /bin/busybox cat /tmp/guest-recovery-rejoin-worker.log
        /bin/busybox cat /tmp/guest-recovery-rejoin-allocate.log
        return 1
      }
    /bin/busybox cat /tmp/guest-recovery-rejoin-allocate.log
    rejoin_generation="$(/bin/busybox sed -n 's/^generation=//p' \
      /tmp/guest-recovery-rejoin-allocate.log | /bin/busybox head -n 1)"
    case "$rejoin_generation" in ''|0*|*[!0-9]*) return 1 ;; esac
    /bin/busybox grep -qx 'home_node=guest-node-1' \
      /tmp/guest-recovery-rejoin-allocate.log || return 1
    /bin/busybox grep -qx "provider_incarnation=$replacement_incarnation" \
      /tmp/guest-recovery-rejoin-allocate.log || return 1
    {
      echo "session_id=guest-recovery-rejoin-active$cycle_suffix"
      echo "connect=$connect"
      echo "request_timeout_ms=30000"
      echo "op=wait_state key=$rejoin_key state=active timeout_ms=60000 poll_ms=50"
    } >/tmp/guest-recovery-rejoin-active.conf
    /bin/linqu_mem_service object-session \
      --config /tmp/guest-recovery-rejoin-active.conf \
      >/tmp/guest-recovery-rejoin-active.log 2>&1 || {
        /bin/busybox cat /tmp/guest-recovery-rejoin-worker.log
        /bin/busybox cat /tmp/guest-recovery-rejoin-active.log
        return 1
      }
    /bin/busybox cat /tmp/guest-recovery-rejoin-active.log
    if /bin/linqu_mem_service acquire-object --connect "$connect" \
        --key "$rejoin_key" --session-id "guest-recovery-rejoin-stale$cycle_suffix" \
        --idempotency-key "guest-recovery-rejoin-stale-acquire$cycle_suffix" \
        --expected-generation "$rejoin_generation" \
        --holder-node-id guest-node-1 \
        --holder-provider-incarnation "$old_incarnation" \
        >/tmp/guest-recovery-rejoin-stale.log 2>&1; then
      return 1
    fi
    /bin/busybox cat /tmp/guest-recovery-rejoin-stale.log
    /bin/busybox grep -qx 'reason=holder_provider_mismatch' \
      /tmp/guest-recovery-rejoin-stale.log || return 1
    {
      echo "session_id=guest-recovery-rejoin-writer$cycle_suffix"
      echo "connect=$connect"
      echo "request_timeout_ms=30000"
      echo "holder_node_id=guest-node-1"
      echo "holder_provider_incarnation=$replacement_incarnation"
      echo "provider=obmm"
      echo "provider_node_id=1"
      echo "provider_node_count=2"
      echo "provider_generation=$bootstrap_generation"
      echo "provider_import_region_bytes=2097152"
      echo "op=acquire key=$rejoin_key idempotency_key=guest-recovery-rejoin-writer-acquire$cycle_suffix expected_generation=$rejoin_generation"
      echo "op=map key=$rejoin_key flags=readwrite"
      echo "op=write key=$rejoin_key offset=0 len=$size seed=$rejoin_seed"
      echo "op=publish_data key=$rejoin_key offset=0 len=$size seed=$rejoin_seed"
      echo "op=allocate key=$rejoin_ready_key idempotency_key=guest-recovery-rejoin-ready$cycle_suffix size_bytes=65536 capabilities=map"
      echo "op=wait_state key=$rejoin_consumed_key state=active timeout_ms=60000 poll_ms=50"
      echo "op=unmap key=$rejoin_key probe_unmapped=1"
      echo "op=release key=$rejoin_key idempotency_key=guest-recovery-rejoin-writer-release$cycle_suffix"
      echo "op=retire key=$rejoin_key idempotency_key=guest-recovery-rejoin-retire$cycle_suffix"
      echo "op=wait_state key=$rejoin_key state=retired timeout_ms=60000 poll_ms=50"
      echo "op=retire key=$rejoin_ready_key idempotency_key=guest-recovery-rejoin-ready-retire$cycle_suffix"
      echo "op=wait_state key=$rejoin_ready_key state=retired timeout_ms=60000 poll_ms=50"
      echo "op=retire key=$rejoin_consumed_key idempotency_key=guest-recovery-rejoin-consumed-retire$cycle_suffix"
      echo "op=wait_state key=$rejoin_consumed_key state=retired timeout_ms=60000 poll_ms=50"
    } >/tmp/guest-recovery-rejoin-writer.conf
    /bin/linqu_mem_service object-session \
      --config /tmp/guest-recovery-rejoin-writer.conf \
      >/tmp/guest-recovery-rejoin-writer.log 2>&1 || {
        /bin/busybox cat /tmp/guest-recovery-rejoin-worker.log
        /bin/busybox cat /tmp/guest-recovery-rejoin-writer.log
        return 1
      }
    /bin/busybox cat /tmp/guest-recovery-rejoin-writer.log
    /bin/busybox cat /tmp/guest-recovery-rejoin-worker.log
    /bin/busybox grep -q \
      "obmm-worker generation=$rejoin_generation phase=published " \
      /tmp/guest-recovery-rejoin-worker.log || return 1
    /bin/busybox grep -q \
      "obmm-worker generation=$rejoin_generation phase=reclaimed " \
      /tmp/guest-recovery-rejoin-worker.log || return 1
    echo "mem_service guest-recovery: node=1 phase=rejoin-write status=pass fault=guest_crash cycle=$cycle key=$rejoin_key generation=$rejoin_generation old_incarnation=$old_incarnation new_incarnation=$replacement_incarnation seed=$rejoin_seed"
    return 0
  fi

  [ "$role" = "home" ] || return 2
  [ "$current_incarnation" = "$home_incarnation" ] || return 2
  /bin/linqu_mem_service allocate-object --connect "$connect" \
    --key "$key" --idempotency-key "guest-recovery-allocate$cycle_suffix" \
    --session-id "guest-recovery-controller$cycle_suffix" \
    --home-node guest-node-0 \
    --size-bytes "$size" --capabilities 1 \
    >/tmp/guest-recovery-allocate.log 2>&1 || return 1
  /bin/busybox cat /tmp/guest-recovery-allocate.log
  generation="$(/bin/busybox sed -n 's/^generation=//p' \
    /tmp/guest-recovery-allocate.log | /bin/busybox head -n 1)"
  case "$generation" in ''|0*|*[!0-9]*) return 1 ;; esac
  attempt=0
  while [ "$attempt" -lt 1200 ]; do
    if /bin/linqu_mem_service inspect-allocation --connect "$connect" \
        --key "$key" >/tmp/guest-recovery-before.log 2>&1 &&
        /bin/busybox grep -qx 'state=active' /tmp/guest-recovery-before.log &&
        /bin/busybox grep -qx 'provider_backed=1' \
          /tmp/guest-recovery-before.log; then
      break
    fi
    attempt=$((attempt + 1))
    /bin/busybox sleep 0.05
  done
  [ "$attempt" -lt 1200 ] || {
    /bin/busybox cat /tmp/guest-recovery-before.log
    /bin/busybox cat /tmp/managed-share.worker.log
    return 1
  }
  {
    echo "session_id=guest-recovery-home$cycle_suffix"
    echo "connect=$connect"
    echo "request_timeout_ms=30000"
    echo "holder_node_id=guest-node-0"
    echo "holder_provider_incarnation=$home_incarnation"
    echo "provider=obmm"
    echo "provider_node_id=0"
    echo "provider_node_count=2"
    echo "provider_generation=$holder_canary_generation"
    echo "provider_import_region_bytes=2097152"
    echo "op=wait_state key=$key state=quarantined timeout_ms=60000 poll_ms=100"
  } >/tmp/guest-recovery-home.conf
  /bin/linqu_mem_service object-session \
    --config /tmp/guest-recovery-home.conf \
    >/tmp/guest-recovery-home.log 2>&1 &
  peer_pid=$!

  attempt=0
  while [ "$attempt" -lt 1200 ]; do
    if /bin/linqu_mem_service inspect-allocation --connect "$connect" \
        --key "$key" >/tmp/guest-recovery-before.log 2>&1 &&
        /bin/busybox grep -qx 'state=active' /tmp/guest-recovery-before.log &&
        /bin/busybox grep -qx 'live_refs=1' /tmp/guest-recovery-before.log &&
        /bin/linqu_mem_service allocation-stats --connect "$connect" \
          >/tmp/guest-recovery-before-stats.log 2>&1 &&
        /bin/busybox grep -qx 'import_mappings=1' \
          /tmp/guest-recovery-before-stats.log; then
      break
    fi
    kill -0 "$peer_pid" 2>/dev/null || {
      /bin/busybox cat /tmp/guest-recovery-home.log
      return 1
    }
    attempt=$((attempt + 1))
    /bin/busybox sleep 0.05
  done
  [ "$attempt" -lt 1200 ] || {
    /bin/busybox cat /tmp/guest-recovery-home.log
    /bin/busybox cat /tmp/guest-recovery-before.log
    /bin/busybox cat /tmp/guest-recovery-before-stats.log
    /bin/busybox cat /tmp/managed-share.worker.log
    return 1
  }
  /bin/busybox cat /tmp/guest-recovery-before.log
  echo "mem_service guest-recovery: node=0 phase=active status=ready fault=guest_crash cycle=$cycle key=$key generation=$generation old_incarnation=$old_incarnation live_refs=1 import_mappings=1"

  attempt=0
  while [ "$attempt" -lt 1200 ]; do
    if /bin/linqu_mem_service provider-directory-status --connect "$connect" \
        >/tmp/guest-recovery-directory-down.log 2>&1 &&
        /bin/busybox grep -qx 'provider_active_count=1' \
          /tmp/guest-recovery-directory-down.log &&
        /bin/busybox grep -qx 'provider_directory_ready=0' \
          /tmp/guest-recovery-directory-down.log &&
        /bin/busybox grep -qx 'data_plane_ready=0' \
          /tmp/guest-recovery-directory-down.log &&
        /bin/busybox grep -qx "expired_count=$cycle" \
          /tmp/guest-recovery-directory-down.log &&
        /bin/linqu_mem_service inspect-allocation --connect "$connect" \
          --key "$key" >/tmp/guest-recovery-after-loss.log 2>&1 &&
        /bin/busybox grep -qx 'state=quarantined' \
          /tmp/guest-recovery-after-loss.log &&
        /bin/busybox grep -qx 'live_refs=1' \
          /tmp/guest-recovery-after-loss.log &&
        /bin/linqu_mem_service allocation-stats --connect "$connect" \
          >/tmp/guest-recovery-after-loss-stats.log 2>&1 &&
        /bin/busybox grep -qx 'managed_recovery_required=1' \
          /tmp/guest-recovery-after-loss-stats.log &&
        /bin/busybox grep -qx 'import_mappings=1' \
          /tmp/guest-recovery-after-loss-stats.log; then
      break
    fi
    attempt=$((attempt + 1))
    /bin/busybox sleep 0.05
  done
  [ "$attempt" -lt 1200 ] || return 1
  for field in key generation home_node provider_incarnation descriptor_hex address address_len live_refs; do
    before="$(/bin/busybox sed -n "s/^$field=//p" \
      /tmp/guest-recovery-before.log | /bin/busybox head -n 1)"
    after="$(/bin/busybox sed -n "s/^$field=//p" \
      /tmp/guest-recovery-after-loss.log | /bin/busybox head -n 1)"
    [ -n "$before" ] && [ "$before" = "$after" ] || return 1
  done
  /bin/busybox cat /tmp/guest-recovery-directory-down.log
  /bin/busybox cat /tmp/guest-recovery-after-loss.log
  /bin/busybox cat /tmp/guest-recovery-after-loss-stats.log
  echo "mem_service guest-recovery: node=0 phase=guest-down status=isolated fault=guest_crash cycle=$cycle key=$key generation=$generation old_incarnation=$old_incarnation state=quarantined live_refs=1 import_mappings=1 expired_count=$cycle managed_recovery_required=1 data_plane_ready=0 identity_preserved=1"

  echo "mem_service guest-recovery: node=0 phase=rejoin-bootstrap status=start generation=$replacement_incarnation"
  /bin/linqu_gva_manager --bootstrap --node-id "$node" --node-count 2 \
    --generation "$home_incarnation" \
    --bootstrap-generation "$replacement_incarnation" --reuse-aperture \
    --aperture-base 0x700000000000 --aperture-size "$aperture_size" || return 1
  /bin/linqu_mem_service_obmm_provider_conformance --node-id "$node" \
    --node-count 2 --generation "$replacement_incarnation" || return 1
  echo "mem_service guest-recovery: node=0 phase=rejoin-bootstrap status=ready generation=$replacement_incarnation"

  attempt=0
  while [ "$attempt" -lt 1200 ]; do
    if /bin/linqu_mem_service provider-directory-status --connect "$connect" \
        >/tmp/guest-recovery-directory-final.log 2>&1 &&
        /bin/busybox grep -qx 'provider_active_count=2' \
          /tmp/guest-recovery-directory-final.log &&
        /bin/busybox grep -qx 'provider_directory_ready=1' \
          /tmp/guest-recovery-directory-final.log &&
        /bin/busybox grep -qx 'data_plane_ready=0' \
          /tmp/guest-recovery-directory-final.log &&
        /bin/busybox grep -q \
          "^provider=guest-node-1 incarnation=$replacement_incarnation " \
          /tmp/guest-recovery-directory-final.log; then
      break
    fi
    attempt=$((attempt + 1))
    /bin/busybox sleep 0.05
  done
  [ "$attempt" -lt 1200 ] || return 1
  /bin/linqu_mem_service inspect-allocation --connect "$connect" --key "$key" \
    >/tmp/guest-recovery-final.log 2>&1 || return 1
  for field in key generation home_node provider_incarnation descriptor_hex address address_len live_refs; do
    before="$(/bin/busybox sed -n "s/^$field=//p" \
      /tmp/guest-recovery-before.log | /bin/busybox head -n 1)"
    after="$(/bin/busybox sed -n "s/^$field=//p" \
      /tmp/guest-recovery-final.log | /bin/busybox head -n 1)"
    [ -n "$before" ] && [ "$before" = "$after" ] || return 1
  done
  /bin/busybox grep -qx 'state=quarantined' \
    /tmp/guest-recovery-final.log || return 1
  /bin/busybox cat /tmp/guest-recovery-directory-final.log
  /bin/busybox cat /tmp/guest-recovery-final.log
  echo "mem_service guest-recovery: node=0 phase=replacement status=isolated fault=guest_crash cycle=$cycle key=$key generation=$generation old_incarnation=$old_incarnation new_incarnation=$replacement_incarnation state=quarantined provider_active_count=2 provider_directory_ready=1 data_plane_ready=0 identity_preserved=1"

  attempt=0
  while [ "$attempt" -lt 1200 ]; do
    result=0
    /bin/linqu_mem_service recover-allocation --connect "$connect" \
      --timeout-ms 1000 --max-attempts 1 \
      --key "$key" --node-id guest-node-0 --incarnation "$home_incarnation" \
      --generation "$generation" --fenced-incarnation "$old_incarnation" \
      --backing-gone 0 >/tmp/guest-recovery-reconcile.log 2>&1 || result=$?
    if [ "$result" -eq 0 ]; then
      /bin/busybox grep -q '^status=ok$' \
        /tmp/guest-recovery-reconcile.log || return 1
      /bin/busybox grep -q '^state=retiring$' \
        /tmp/guest-recovery-reconcile.log || return 1
      break
    fi
    /bin/busybox grep -Eq \
      'reason=(holder_fence_receipt_required|state_conflict|recovery_providers_not_ready|managed_reconciliation_required)' \
      /tmp/guest-recovery-reconcile.log || {
        /bin/busybox cat /tmp/guest-recovery-reconcile.log
        return 1
      }
    attempt=$((attempt + 1))
    /bin/busybox sleep 0.05
  done
  [ "$attempt" -lt 1200 ] || return 1
  /bin/busybox cat /tmp/guest-recovery-reconcile.log
  {
    echo "session_id=guest-recovery-reconciled$cycle_suffix"
    echo "connect=$connect"
    echo "request_timeout_ms=30000"
    echo "op=wait_state key=$key state=retired timeout_ms=60000 poll_ms=50"
  } >/tmp/guest-recovery-reconciled.conf
  /bin/linqu_mem_service object-session \
    --config /tmp/guest-recovery-reconciled.conf \
    >/tmp/guest-recovery-reconciled.log 2>&1 || {
      /bin/busybox cat /tmp/managed-share.worker.log
      /bin/busybox cat /tmp/guest-recovery-reconciled.log
      return 1
    }
  /bin/busybox cat /tmp/guest-recovery-reconciled.log
  echo "mem_service guest-recovery: node=0 phase=reconciled status=retired fault=guest_crash cycle=$cycle key=$key generation=$generation old_incarnation=$old_incarnation new_incarnation=$replacement_incarnation holder_receipt=complete home_reclaim=complete"

  bootstrap_generation=$((replacement_incarnation + 1048576))
  {
    echo "session_id=guest-recovery-rejoin-reader$cycle_suffix"
    echo "connect=$connect"
    echo "request_timeout_ms=30000"
    echo "holder_node_id=guest-node-0"
    echo "holder_provider_incarnation=$home_incarnation"
    echo "provider=obmm"
    echo "provider_node_id=0"
    echo "provider_node_count=2"
    echo "provider_generation=$bootstrap_generation"
    echo "provider_import_region_bytes=2097152"
    echo "op=wait_state key=$rejoin_ready_key state=active timeout_ms=60000 poll_ms=50"
    echo "op=acquire key=$rejoin_key idempotency_key=guest-recovery-rejoin-reader-acquire$cycle_suffix"
    echo "op=map key=$rejoin_key flags=read"
    echo "op=wait_visible key=$rejoin_key offset=0 len=$size seed=$rejoin_seed"
    echo "op=read key=$rejoin_key offset=0 len=$size seed=$rejoin_seed"
    echo "op=unmap key=$rejoin_key probe_unmapped=1"
    echo "op=release key=$rejoin_key idempotency_key=guest-recovery-rejoin-reader-release$cycle_suffix"
    echo "op=allocate key=$rejoin_consumed_key idempotency_key=guest-recovery-rejoin-consumed$cycle_suffix size_bytes=65536 capabilities=map"
    echo "op=wait_state key=$rejoin_key state=retired timeout_ms=60000 poll_ms=50"
    echo "op=wait_state key=$rejoin_ready_key state=retired timeout_ms=60000 poll_ms=50"
    echo "op=wait_state key=$rejoin_consumed_key state=retired timeout_ms=60000 poll_ms=50"
  } >/tmp/guest-recovery-rejoin-reader.conf
  /bin/linqu_mem_service object-session \
    --config /tmp/guest-recovery-rejoin-reader.conf \
    >/tmp/guest-recovery-rejoin-reader.log 2>&1 || {
      /bin/busybox cat /tmp/guest-recovery-rejoin-reader.log
      return 1
    }
  /bin/busybox cat /tmp/guest-recovery-rejoin-reader.log
  rejoin_generation="$(/bin/busybox sed -n \
    "s/.*action=acquire key=$rejoin_key status=ok state=active generation=\([0-9][0-9]*\).*/\1/p" \
    /tmp/guest-recovery-rejoin-reader.log | /bin/busybox head -n 1)"
  case "$rejoin_generation" in ''|0*|*[!0-9]*) return 1 ;; esac

  /bin/linqu_mem_service allocation-stats --connect "$connect" \
    >/tmp/guest-recovery-final-stats.log 2>&1 || return 1
  for field in backing_allocated_bytes address_reserved_bytes live_refs \
      import_mappings quarantined_objects quarantined_bytes; do
    /bin/busybox grep -qx "$field=0" \
      /tmp/guest-recovery-final-stats.log || return 1
  done
  /bin/busybox grep -qx 'managed_recovery_required=0' \
    /tmp/guest-recovery-final-stats.log || return 1
  kill "$peer_pid" 2>/dev/null || true
  wait "$peer_pid" 2>/dev/null || true
  echo "mem_service guest-recovery: node=0 phase=rejoin-read status=pass fault=guest_crash cycle=$cycle key=$rejoin_key generation=$rejoin_generation old_incarnation=$old_incarnation new_incarnation=$replacement_incarnation seed=$rejoin_seed"
  echo "mem_service guest-recovery: node=0 phase=observation status=pass fault=guest_crash cycle=$cycle key=$key generation=$generation old_incarnation=$old_incarnation new_incarnation=$replacement_incarnation state=retired live_refs=0 import_mappings=0 backing_allocated_bytes=0 address_reserved_bytes=0 quarantined_bytes=0 managed_recovery_required=0 data_plane_ready=0 rejoin=pass"
  return 0
}

mem_service_recovery_fault_supported() {
  case "$1" in
    reserve_intent_crash|torn_ledger_crash|address_reserved_crash|\
    backing_exported_crash|published_crash|release_intent_crash|\
    unexported_crash|retired_crash|reclaimed_crash|manager_crash|guest_crash)
      return 0
      ;;
    *) return 1 ;;
  esac
}

mem_service_object_share_recovery_fault() {
  local node="$1"
  local size="$2"
  local incarnation="$3"
  local connect="$4"
  local worker="$5"
  local fault="$6"
  local key="recovery-fault-$fault"
  local injection_phase=""
  local expected_mode=""
  local expected_integrity=""
  local recovery=""
  local resume_state=""
  local final_state=""
  local uptime="" ignored="" deadline=0 result=0 generation=""
  local attempt=0 worker_status=0 resumed_worker=""

  case "$fault" in
    reserve_intent_crash)
      injection_phase="reserve-intent"
      expected_mode="sync-exit"
      expected_integrity="complete"
      recovery="quarantined"
      final_state="quarantined"
      ;;
    torn_ledger_crash)
      injection_phase="reserve-intent"
      expected_mode="torn-exit"
      expected_integrity="torn"
      recovery="quarantined"
      final_state="quarantined"
      ;;
    address_reserved_crash)
      injection_phase="reserved"
      expected_mode="sync-exit"
      expected_integrity="complete"
      recovery="resumed"
      resume_state="active"
      final_state="retired"
      ;;
    backing_exported_crash)
      injection_phase="exported"
      expected_mode="sync-exit"
      expected_integrity="complete"
      recovery="resumed"
      resume_state="active"
      final_state="retired"
      ;;
    published_crash)
      injection_phase="published"
      expected_mode="sync-exit"
      expected_integrity="complete"
      recovery="resumed"
      resume_state="active"
      final_state="retired"
      ;;
    release_intent_crash)
      injection_phase="release-intent"
      expected_mode="sync-exit"
      expected_integrity="complete"
      recovery="resumed"
      resume_state="retired"
      final_state="retired"
      ;;
    unexported_crash)
      injection_phase="unexported"
      expected_mode="sync-exit"
      expected_integrity="complete"
      recovery="resumed"
      resume_state="retired"
      final_state="retired"
      ;;
    retired_crash)
      injection_phase="retired"
      expected_mode="sync-exit"
      expected_integrity="complete"
      recovery="resumed"
      resume_state="retired"
      final_state="retired"
      ;;
    reclaimed_crash)
      injection_phase="reclaimed"
      expected_mode="sync-exit"
      expected_integrity="complete"
      recovery="resumed"
      resume_state="retired"
      final_state="retired"
      ;;
    *) return 2 ;;
  esac

  # Do not consume the allocation until both provider registrations are
  # visible. The recovery case has no data-plane session whose peer canary
  # could otherwise provide this barrier.
  read -r uptime ignored </proc/uptime
  deadline=$((${uptime%%.*} + 60))
  while true; do
    result=0
    /bin/linqu_mem_service provider-directory-status --connect "$connect" \
      --timeout-ms 1000 --max-attempts 1 \
      >/tmp/recovery-fault-directory-ready.log 2>&1 || result=$?
    if [ "$result" -eq 0 ] &&
        /bin/busybox grep -qx 'provider_active_count=2' \
          /tmp/recovery-fault-directory-ready.log &&
        /bin/busybox grep -qx 'provider_directory_ready=1' \
          /tmp/recovery-fault-directory-ready.log; then
      break
    fi
    read -r uptime ignored </proc/uptime
    [ "${uptime%%.*}" -lt "$deadline" ] || {
      /bin/busybox cat /tmp/recovery-fault-directory-ready.log
      return 1
    }
    /bin/busybox sleep 0.05
  done

  if [ "$node" = "0" ]; then
    /bin/linqu_mem_service allocate-object --connect "$connect" \
      --key "$key" --idempotency-key "$key-allocate" \
      --session-id recovery-fault-controller --home-node guest-node-0 \
      --size-bytes "$size" --capabilities 1 \
      >/tmp/recovery-fault-allocate.log 2>&1 || return 1
    /bin/busybox cat /tmp/recovery-fault-allocate.log
    generation="$(/bin/busybox sed -n 's/^generation=//p' \
      /tmp/recovery-fault-allocate.log | /bin/busybox head -n 1)"
    case "$generation" in ''|0*|*[!0-9]*) return 1 ;; esac

    case "$injection_phase" in
      release-intent|unexported|retired|reclaimed)
        {
          echo "session_id=recovery-fault-trigger"
          echo "connect=$connect"
          echo "request_timeout_ms=30000"
          echo "op=wait_state key=$key state=active timeout_ms=60000 poll_ms=50"
          echo "op=retire key=$key idempotency_key=$key-retire"
        } >/tmp/recovery-fault-trigger.conf
        /bin/linqu_mem_service object-session \
          --config /tmp/recovery-fault-trigger.conf \
          >/tmp/recovery-fault-trigger.log 2>&1 || {
            /bin/busybox cat /tmp/recovery-fault-trigger.log
            return 1
          }
        /bin/busybox cat /tmp/recovery-fault-trigger.log
        ;;
    esac

    attempt=0
    while [ "$attempt" -lt 600 ]; do
      if /bin/busybox grep -q \
          "obmm-worker fault-injection=triggered phase=$injection_phase mode=$expected_mode ledger_bytes=[1-9][0-9]*" \
          /tmp/managed-share.worker.log 2>/dev/null; then
        break
      fi
      kill -0 "$worker" 2>/dev/null || break
      attempt=$((attempt + 1))
      /bin/busybox sleep 0.1
    done
    worker_status=0
    wait "$worker" || worker_status=$?
    /bin/busybox cat /tmp/managed-share.worker.log
    [ "$worker_status" -eq 86 ] || return 1
    /bin/busybox grep -q \
      "obmm-worker fault-injection=triggered phase=$injection_phase mode=$expected_mode ledger_bytes=[1-9][0-9]*" \
      /tmp/managed-share.worker.log || return 1
    echo "mem_service recovery-fault: node=0 phase=worker-exit status=expected fault=$fault injection_phase=$injection_phase mode=$expected_mode exit_code=$worker_status key=$key generation=$generation"

    if [ "$recovery" = "quarantined" ]; then
      /bin/linqu_mem_service_provider_obmm quarantine-allocation-state \
        --config /tmp/managed-share.worker.conf \
        >/tmp/recovery-fault-quarantine.log 2>&1 || {
          /bin/busybox cat /tmp/recovery-fault-quarantine.log
          return 1
        }
      /bin/busybox cat /tmp/recovery-fault-quarantine.log
      /bin/busybox grep -q \
        "obmm-worker-quarantine: status=complete node=guest-node-0 incarnation=$incarnation provider_state=isolated ledger_integrity=$expected_integrity scope=provider-control-plane backing_reconciled=0 resource_reconciliation_required=1" \
        /tmp/recovery-fault-quarantine.log || return 1
      worker_pid=""
    else
      /bin/linqu_mem_service_provider_obmm resume-allocations \
        --config /tmp/managed-share.worker.resume.conf \
        >/tmp/recovery-fault-resume.log 2>&1 &
      resumed_worker=$!
      attempt=0
      while [ "$attempt" -lt 600 ]; do
        if /bin/busybox grep -q \
            'obmm-worker-resume: status=ready ' \
            /tmp/recovery-fault-resume.log 2>/dev/null; then
          break
        fi
        kill -0 "$resumed_worker" 2>/dev/null || break
        attempt=$((attempt + 1))
        /bin/busybox sleep 0.1
      done
      /bin/busybox cat /tmp/recovery-fault-resume.log
      kill -0 "$resumed_worker" 2>/dev/null || return 1
      /bin/busybox grep -q 'obmm-worker-resume: status=ready ' \
        /tmp/recovery-fault-resume.log || return 1
      worker_pid="$resumed_worker"
      if [ "$resume_state" = "active" ]; then
        {
          echo "session_id=recovery-fault-resume-controller"
          echo "connect=$connect"
          echo "request_timeout_ms=30000"
          echo "op=wait_state key=$key state=active timeout_ms=60000 poll_ms=50"
          echo "op=inspect key=$key expect_state=active"
          echo "op=retire key=$key idempotency_key=$key-retire-after-resume"
          echo "op=wait_state key=$key state=retired timeout_ms=60000 poll_ms=50"
        } >/tmp/recovery-fault-resume-controller.conf
        /bin/linqu_mem_service object-session \
          --config /tmp/recovery-fault-resume-controller.conf \
          >/tmp/recovery-fault-resume-controller.log 2>&1 || {
            /bin/busybox cat /tmp/recovery-fault-resume-controller.log
            return 1
          }
        /bin/busybox cat /tmp/recovery-fault-resume-controller.log
      fi
    fi
  fi

  {
    echo "session_id=recovery-fault-observer-$node"
    echo "connect=$connect"
    echo "request_timeout_ms=30000"
    echo "op=wait_state key=$key state=$final_state timeout_ms=60000 poll_ms=50"
    echo "op=inspect key=$key expect_state=$final_state"
    echo "op=stats"
  } >/tmp/recovery-fault-observer.conf
  /bin/linqu_mem_service object-session \
    --config /tmp/recovery-fault-observer.conf \
    >/tmp/recovery-fault-observer.log 2>&1 || {
      /bin/busybox cat /tmp/recovery-fault-observer.log
      return 1
    }
  /bin/busybox cat /tmp/recovery-fault-observer.log
  if [ "$recovery" = "quarantined" ]; then
    /bin/busybox grep -q \
      'action=stats status=ok live_objects=0 backing_allocated_bytes=0 address_reserved_bytes=0 live_refs=0 in_flight=1 quarantined_objects=1 quarantined_bytes=0 import_mappings=0' \
      /tmp/recovery-fault-observer.log || return 1
  else
    /bin/busybox grep -q \
      'action=stats status=ok live_objects=0 backing_allocated_bytes=0 address_reserved_bytes=0 live_refs=0 in_flight=0 quarantined_objects=0 quarantined_bytes=0 import_mappings=0' \
      /tmp/recovery-fault-observer.log || return 1
  fi

  /bin/linqu_mem_service provider-directory-status --connect "$connect" \
    >/tmp/recovery-fault-directory-final.log 2>&1 || return 1
  /bin/busybox cat /tmp/recovery-fault-directory-final.log
  if [ "$recovery" = "quarantined" ]; then
    /bin/busybox grep -qx 'provider_active_count=1' \
      /tmp/recovery-fault-directory-final.log || return 1
    /bin/busybox grep -qx 'provider_directory_ready=0' \
      /tmp/recovery-fault-directory-final.log || return 1
  else
    /bin/busybox grep -qx 'provider_active_count=2' \
      /tmp/recovery-fault-directory-final.log || return 1
    /bin/busybox grep -qx 'provider_directory_ready=1' \
      /tmp/recovery-fault-directory-final.log || return 1
  fi
  /bin/busybox grep -qx 'data_plane_ready=0' \
    /tmp/recovery-fault-directory-final.log || return 1
  echo "mem_service recovery-fault: node=$node phase=observation status=pass fault=$fault injection_phase=$injection_phase mode=$expected_mode ledger_integrity=$expected_integrity recovery=$recovery final_state=$final_state key=$key"
}

mem_service_object_share_managed() (
  node="$1"
  size="$2"
  iterations="$3"
  seed="$4"
  port="$5"
  incarnation="$6"
  base_incarnation="$incarnation"
  aperture_generation="$incarnation"
  bootstrap_generation="$incarnation"
  fault="$7"
  access="${8:-cpu}"
  guest_restart="$(cmdline_value mem_service.object_share_guest_restart 0)"
  guest_restart_index="$(cmdline_value \
    mem_service.object_share_guest_restart_index 0)"
  guest_crash_cycles="$(cmdline_value \
    mem_service.object_share_guest_crash_cycles 1)"
  home_node=0
  if [ "$access" = "cpu-pto" ]; then
    home_node="$(cmdline_value lingqu_shmem_pto.home_node 0)"
    case "$home_node" in 0|1) ;; *) exit 2 ;; esac
  fi
  connect="tcp:10.0.0.1:$port"
  daemon_pid=""
  worker_pid=""
  capacity_pid=""
  pressure_barrier=0
  aperture_size=0x1000000
  case "$fault" in
    capacity|address_capacity|backing_capacity|allocation_pressure) pressure_barrier=1 ;;
  esac
  [ "$fault" != "backing_capacity" ] || aperture_size=0x100000000
  [ "$fault" != "allocation_pressure" ] || aperture_size=0x4000000
  case "$guest_restart" in 0|1) ;; *) exit 2 ;; esac
  case "$guest_restart_index" in ''|*[!0-9]*) exit 2 ;; esac
  case "$guest_crash_cycles" in ''|0|*[!0-9]*) exit 2 ;; esac
  [ "$guest_crash_cycles" -le 8 ] || exit 2
  if [ "$guest_restart" = "1" ] && [ "$guest_restart_index" = "0" ]; then
    guest_restart_index=1
  fi
  if [ "$guest_restart_index" -gt 0 ]; then
    [ "$fault" = "guest_crash" ] && [ "$node" = "1" ] || exit 2
    [ "$guest_restart_index" -le "$guest_crash_cycles" ] || exit 2
    incarnation=$((base_incarnation + guest_restart_index))
    bootstrap_generation="$incarnation"
  fi
  requested_aperture="$(cmdline_value mem_service.object_share_aperture_size "$(cmdline_value mem_service_object_share_aperture_size auto)")"
  if [ "$requested_aperture" != "auto" ]; then
    [ "$fault" = "none" ] || exit 2
    aperture_size="$requested_aperture"
  fi
  echo "mem_service address-pool: aperture_size=$aperture_size policy=kernel-selected"
  cleanup_managed_share() {
    client_result=$?
    if [ "$client_result" -ne 0 ]; then
      mem_service_object_share_failure_snapshot "$connect" "$node" before-worker-stop
    fi
    if [ -n "$capacity_pid" ]; then
      kill "$capacity_pid" 2>/dev/null || true
      wait "$capacity_pid" 2>/dev/null || true
    fi
    if [ -n "$worker_pid" ]; then
      kill "$worker_pid" 2>/dev/null || true
      wait "$worker_pid" 2>/dev/null || true
    fi
    if [ "$client_result" -ne 0 ]; then
      mem_service_object_share_failure_snapshot "$connect" "$node" after-worker-stop
    fi
    if [ -n "$daemon_pid" ]; then
      kill "$daemon_pid" 2>/dev/null || true
      wait "$daemon_pid" 2>/dev/null || true
    fi
    return "$client_result"
  }
  trap cleanup_managed_share EXIT
  # Self-connections to the node's configured address use the local route.
  # BusyBox initramfs does not bring loopback up automatically.
  /bin/busybox ip link set lo up || exit 1
  if [ "$node" = "0" ]; then
    {
      echo "listen=$connect"
      echo "store=/tmp/managed-share.store"
      echo "node_id=guest-node-0"
      echo "cluster_id=managed-share"
      echo "auth_mode=trusted-guest-network"
      echo "network_peer=guest-node-0@10.0.0.1"
      echo "network_peer=guest-node-1@10.0.0.2"
      echo "required_provider=guest-node-0"
      echo "required_provider=guest-node-1"
      echo "allocation_home_provider=guest-node-$home_node"
      if [ "$fault" = "guest_crash" ]; then
        echo "provider_lease_ms=3000"
      else
        echo "provider_lease_ms=30000"
      fi
    } >/tmp/managed-share.daemon.conf
    /bin/linqu_mem_service serve --config /tmp/managed-share.daemon.conf &
    daemon_pid=$!
  fi
  /bin/linqu_gva_manager --bootstrap --node-id "$node" --node-count 2 \
    --generation "$aperture_generation" \
    --bootstrap-generation "$bootstrap_generation" \
    --aperture-base 0x700000000000 --aperture-size "$aperture_size" || exit 1
  /bin/linqu_mem_service_obmm_provider_conformance --node-id "$node" \
    --node-count 2 --generation "$bootstrap_generation" || exit 1
  echo "mem_service kernel-regions: phase=baseline"
  /bin/linqu_gva_manager --dump-obmm-regions || exit 1
  mem_service_object_share_wait_daemon "$connect" "$daemon_pid" || exit 1
  /bin/linqu_mem_service provider-register --connect "$connect" \
    --node-id "guest-node-$node" --incarnation "$incarnation" \
    --readiness-generation "$incarnation" --capabilities 1 || exit 1
  {
    echo "connect=$connect"
    echo "node_id=guest-node-$node"
    echo "incarnation=$incarnation"
    echo "readiness_generation=$incarnation"
    echo "state_file=/tmp/managed-share.worker.state"
    echo "allocation_granularity_bytes=2097152"
    [ "$fault" != "backing_capacity" ] || echo "fast_allocation=1"
  } >/tmp/managed-share.worker.resume.conf
  /bin/busybox cp /tmp/managed-share.worker.resume.conf \
    /tmp/managed-share.worker.conf || exit 1
  if [ "$node" = "0" ] && [ "$access" = "cpu-recovery-fault" ] &&
      [ "$fault" != "manager_crash" ] && [ "$fault" != "guest_crash" ]; then
    case "$fault" in
      reserve_intent_crash)
        echo "fault_injection_phase=reserve-intent"
        echo "fault_injection_mode=sync-exit"
        ;;
      torn_ledger_crash)
        echo "fault_injection_phase=reserve-intent"
        echo "fault_injection_mode=torn-exit"
        ;;
      address_reserved_crash) echo "fault_injection_phase=reserved" ;;
      backing_exported_crash) echo "fault_injection_phase=exported" ;;
      published_crash) echo "fault_injection_phase=published" ;;
      release_intent_crash) echo "fault_injection_phase=release-intent" ;;
      unexported_crash) echo "fault_injection_phase=unexported" ;;
      retired_crash) echo "fault_injection_phase=retired" ;;
      reclaimed_crash) echo "fault_injection_phase=reclaimed" ;;
      *) exit 2 ;;
    esac >>/tmp/managed-share.worker.conf
    case "$fault" in
      torn_ledger_crash) ;;
      reserve_intent_crash) ;;
      *) echo "fault_injection_mode=sync-exit" \
           >>/tmp/managed-share.worker.conf ;;
    esac
  fi
  if [ "$fault" = "guest_crash" ] && [ "$guest_restart_index" -gt 0 ] &&
      [ "$node" = "1" ]; then
    worker_pid=""
    echo "mem_service guest-recovery: node=1 phase=replacement-worker status=deferred cycle=$guest_restart_index incarnation=$incarnation reason=holder-reconciliation-required"
  elif [ "$node" = "0" ] && [ "$access" = "cpu-recovery-fault" ]; then
    /bin/linqu_mem_service_provider_obmm serve-allocations \
      --config /tmp/managed-share.worker.conf \
      >/tmp/managed-share.worker.log 2>&1 &
    worker_pid=$!
  else
    /bin/linqu_mem_service_provider_obmm serve-allocations \
      --config /tmp/managed-share.worker.conf &
    worker_pid=$!
  fi
  if [ "$access" = "cpu-recovery-fault" ]; then
    if [ "$fault" = "manager_crash" ]; then
      mem_service_object_share_manager_recovery "$node" "$size" "$incarnation" \
        "$connect" "$daemon_pid" "$worker_pid" || exit 1
    elif [ "$fault" = "guest_crash" ]; then
      if [ "$node" = "0" ]; then
        cycle=1
        while [ "$cycle" -le "$guest_crash_cycles" ]; do
          mem_service_object_share_guest_recovery "$node" "$size" \
            "$base_incarnation" "$incarnation" "$connect" home "$cycle" \
            "$aperture_size" || exit 1
          cycle=$((cycle + 1))
        done
      else
        if [ "$guest_restart_index" -gt 0 ]; then
          mem_service_object_share_guest_recovery "$node" "$size" \
            "$base_incarnation" "$incarnation" "$connect" replacement \
            "$guest_restart_index" "$aperture_size" || exit 1
        fi
        cycle=$((guest_restart_index + 1))
        if [ "$cycle" -le "$guest_crash_cycles" ]; then
          mem_service_object_share_guest_recovery "$node" "$size" \
            "$base_incarnation" "$incarnation" "$connect" holder "$cycle" \
            "$aperture_size" || exit 1
        fi
      fi
    else
      mem_service_object_share_recovery_fault "$node" "$size" "$incarnation" \
        "$connect" "$worker_pid" "$fault" || exit 1
    fi
  fi
  if [ "$access" = "cpu-holder-recovery" ]; then
    mem_service_object_share_holder_barrier "$node" "$size" "$connect" || exit 1
    mem_service_object_share_holder_recovery "$node" "$size" "$seed" \
      "$incarnation" "$connect" "$worker_pid" || exit 1
    mem_service_object_share_holder_rejoin "$node" "$size" "$seed" \
      "$incarnation" "$connect" || exit 1
  fi
  if [ "$access" = "cpu-retired" ]; then
    mem_service_object_share_retired "$node" "$size" "$seed" "$incarnation" "$connect" || exit 1
  fi
  if [ "$access" = "cpu-reference" ]; then
    mem_service_object_share_reference "$node" "$size" "$iterations" "$seed" \
      "$incarnation" "$connect" || exit 1
  fi
  if [ "$access" = "cpu-pto" ]; then
    {
      echo "connect=$connect"
      echo "key=managed-pto-$incarnation"
      echo "node_id=$node"
      echo "home_node=$home_node"
      echo "concurrent_requests=$(cmdline_value lingqu_shmem_pto.concurrent_requests 1)"
      echo "generation=$(cmdline_value lingqu_shmem_pto_generation '')"
      echo "requester_cna=$(cmdline_value lingqu_shmem_pto_requester_cna '')"
      echo "artifact_fingerprint=$(cmdline_value lingqu_shmem_pto_artifact_fingerprint '')"
      echo "timeout_ms=$(cmdline_value lingqu_shmem_pto_timeout_ms 120000)"
      submit_timeout_ms=$(cmdline_value lingqu_shmem_pto_submit_timeout_ms 0)
      [ "$submit_timeout_ms" = "0" ] || echo "submit_timeout_ms=$submit_timeout_ms"
      echo "access_threads=$(cmdline_value lingqu_shmem_pto_access_threads 0)"
      echo "negative_checks=$(cmdline_value lingqu_shmem_pto_negative_checks 0)"
      echo "readonly_inputs=$(cmdline_value lingqu_shmem_pto_readonly_inputs 0)"
      echo "reference_inputs=$(cmdline_value lingqu_shmem_pto.reference_inputs 0)"
      if [ "$(cmdline_value lingqu_shmem_pto.model_probe 0)" = "1" ]; then
        echo "model_probe=1"
        echo "model_publish=$(cmdline_value lingqu_shmem_pto.model_publish 0)"
        echo "model_output_bytes=$(cmdline_value lingqu_shmem_pto.model_output_bytes '')"
        echo "model_output_checksum=$(cmdline_value lingqu_shmem_pto.model_output_checksum '')"
      fi
      echo "layout=$(cmdline_value lingqu_shmem_pto_layout cross-page)"
      echo "elements=$(cmdline_value lingqu_shmem_pto_elements 64)"
      echo "size_bytes=$size"
    } >/tmp/managed-share.pto.conf
    /bin/lingqu_shmem_pto_direct --managed-config /tmp/managed-share.pto.conf \
      --validate-only || exit 1
    /bin/lingqu_shmem_pto_direct --managed-config /tmp/managed-share.pto.conf || exit 1
  fi
  if [ "$node" = "0" ] && [ "$fault" = "capacity" ]; then
    mem_service_object_share_capacity_pressure "$connect" &
    capacity_pid=$!
  fi
  if [ "$node" = "0" ] && [ "$fault" = "address_capacity" ]; then
    mem_service_object_share_address_pressure "$connect" &
    capacity_pid=$!
  fi
  if [ "$node" = "0" ] && [ "$fault" = "backing_capacity" ]; then
    mem_service_object_share_backing_pressure "$connect" &
    capacity_pid=$!
  fi
  if [ "$node" = "0" ] && [ "$fault" = "allocation_pressure" ]; then
    mem_service_object_share_allocation_pressure "$connect" &
    capacity_pid=$!
  fi
  if [ "$access" = "cpu" ]; then
  i=1
  while [ "$i" -le "$iterations" ]; do
    config="/tmp/managed-share.session.$i.conf"
    key="obj-share-$i"
    sent="obj-sent-$i"
    returned="obj-returned-$i"
    {
      echo "session_id=client-$node"
      echo "connect=$connect"
      echo "request_timeout_ms=30000"
      echo "holder_node_id=guest-node-$node"
      echo "holder_provider_incarnation=$incarnation"
      echo "provider=obmm"
      echo "provider_node_id=$node"
      echo "provider_node_count=2"
      echo "provider_generation=$((incarnation + i))"
      echo "provider_import_region_bytes=2097152"
      if [ "$node" = "0" ]; then
        alignment=0
        [ "$fault" != "address_capacity" ] || alignment=4194304
        echo "op=allocate key=$key idempotency_key=alloc-$i size_bytes=$size alignment_bytes=$alignment capabilities=map"
        echo "op=wait_state key=$key state=active timeout_ms=60000 poll_ms=50"
        echo "op=acquire key=$key idempotency_key=acq-a-$i"
        mem_service_object_share_contract_ops "$fault" acquired "$key" "$size" "$seed" "acq-a-$i"
        echo "op=stats"
        echo "op=map key=$key flags=read"
        echo "op=stats"
        echo "op=probe_readonly key=$key"
        mem_service_object_share_contract_ops "$fault" readonly "$key" "$size" "$seed" "acq-a-$i"
        echo "op=unmap key=$key"
        echo "op=map key=$key flags=readwrite"
        mem_service_object_share_contract_ops "$fault" writable "$key" "$size" "$seed" "acq-a-$i"
        echo "op=stats"
        # Leave at least one full page even on a 64 KiB-page deployment.
        if [ "$size" -le 2031616 ]; then
          echo "op=probe_guard key=$key"
        fi
        echo "op=write key=$key offset=0 len=$size seed=$seed"
        mem_service_object_share_contract_ops "$fault" written "$key" "$size" "$seed" "acq-a-$i"
        echo "op=publish_data key=$key offset=0 len=$size seed=$seed"
        echo "op=allocate key=$sent idempotency_key=sent-$i size_bytes=65536 capabilities=map"
        if [ "$pressure_barrier" = "1" ]; then
          echo "op=wait_state key=$returned state=retired timeout_ms=60000 poll_ms=50"
        else
          echo "op=wait_state key=$returned state=active timeout_ms=60000 poll_ms=50"
        fi
        echo "op=wait_visible key=$key offset=0 len=$size seed=$((seed + 1))"
        echo "op=read key=$key offset=0 len=$size seed=$((seed + 1))"
        echo "op=unmap key=$key"
        echo "op=stats"
        echo "op=release key=$key idempotency_key=rel-a-$i"
        mem_service_object_share_contract_ops "$fault" released "$key" "$size" "$seed" "rel-a-$i"
        echo "op=retire key=$key idempotency_key=retire-$i"
        echo "op=wait_state key=$key state=retired timeout_ms=60000 poll_ms=50"
        echo "op=retire key=$sent idempotency_key=retire-sent-$i"
        echo "op=wait_state key=$sent state=retired timeout_ms=60000 poll_ms=50"
        if [ "$pressure_barrier" = "0" ]; then
          echo "op=retire key=$returned idempotency_key=retire-returned-$i"
        fi
        echo "op=wait_state key=$returned state=retired timeout_ms=60000 poll_ms=50"
        echo "op=stats"
      else
        echo "op=wait_state key=$sent state=active timeout_ms=60000 poll_ms=50"
        echo "op=acquire key=$key idempotency_key=acq-b-$i"
        mem_service_object_share_contract_ops "$fault" acquired "$key" "$size" "$((seed + 1))" "acq-b-$i"
        echo "op=stats"
        echo "op=map key=$key flags=read"
        echo "op=stats"
        echo "op=probe_readonly key=$key"
        mem_service_object_share_contract_ops "$fault" readonly "$key" "$size" "$((seed + 1))" "acq-b-$i"
        echo "op=unmap key=$key"
        echo "op=map key=$key flags=readwrite"
        mem_service_object_share_contract_ops "$fault" writable "$key" "$size" "$((seed + 1))" "acq-b-$i"
        echo "op=stats"
        if [ "$size" -le 2031616 ]; then
          echo "op=probe_guard key=$key"
        fi
        echo "op=wait_visible key=$key offset=0 len=$size seed=$seed"
        echo "op=read key=$key offset=0 len=$size seed=$seed"
        echo "op=write key=$key offset=0 len=$size seed=$((seed + 1))"
        mem_service_object_share_contract_ops "$fault" written "$key" "$size" "$((seed + 1))" "acq-b-$i"
        echo "op=publish_data key=$key offset=0 len=$size seed=$((seed + 1))"
        if [ "$pressure_barrier" = "1" ]; then
          echo "op=allocate key=$returned idempotency_key=returned-$i size_bytes=65536 capabilities=map"
          echo "op=wait_state key=$returned state=retired timeout_ms=60000 poll_ms=50"
        fi
        echo "op=unmap key=$key"
        echo "op=stats"
        echo "op=release key=$key idempotency_key=rel-b-$i"
        mem_service_object_share_contract_ops "$fault" released "$key" "$size" "$((seed + 1))" "rel-b-$i"
        if [ "$pressure_barrier" = "0" ]; then
          echo "op=allocate key=$returned idempotency_key=returned-$i size_bytes=65536 capabilities=map"
        fi
        echo "op=wait_state key=$returned state=retired timeout_ms=60000 poll_ms=50"
      fi
    } >"$config"
    /bin/linqu_mem_service object-session --config "$config" || exit 1
    i=$((i + 1))
  done
  fi
  if [ -n "$capacity_pid" ]; then
    wait "$capacity_pid" || exit 1
    capacity_pid=""
  fi
  /bin/linqu_mem_service health --connect "$connect" || exit 1
  /bin/linqu_mem_service allocation-stats --connect "$connect" || exit 1
  if [ "$access" = "cpu-pto" ]; then
    /bin/linqu_mem_service metrics --connect "$connect" || exit 1
  fi
  if [ "$fault" = "manager_crash" ] || [ "$fault" = "guest_crash" ]; then
    echo "mem_service kernel-regions: phase=isolated"
  else
    echo "mem_service kernel-regions: phase=drained"
  fi
  /bin/linqu_gva_manager --dump-obmm-regions || exit 1
  role=provider
  [ "$node" = "0" ] || role=consumer
  if [ "$access" = "cpu-pto" ]; then
    role=consumer
    [ "$node" != "$home_node" ] || role=provider
  fi
  log "mem_service object-share: status=ok node=$node role=$role backend=obmm"
  if [ "$access" = "cpu-holder-recovery" ] && [ "$node" = "1" ]; then
    return 0
  fi
  # The headless runner owns infrastructure shutdown after both clients pass.
  # Keep home exports and the daemon alive independently of client sessions.
  if [ "$access" = "cpu-recovery-fault" ] && [ "$node" = "0" ]; then
    mem_service_object_share_wait_infrastructure "$node" "$daemon_pid"
  elif [ "$fault" = "manager_crash" ]; then
    return 0
  else
    mem_service_object_share_wait_infrastructure "$node" "$worker_pid"
  fi
)

run_mem_service_object_share() {
  local node_idx=""
  local node_count=""
  local backend=""
  local size=""
  local fault=""
  local iterations=""
  local seed=""
  local port=""
  local incarnation=""
  local address=""
  local descriptor_hex=""
  local connect=""
  local access=""

  node_idx="$(cmdline_value linqu_node_idx 0)"
  node_count="$(cmdline_value linqu_node_count 2)"
  backend="$(cmdline_value mem_service.object_share_backend "$(cmdline_value mem_service_object_share_backend loopback)")"
  access="$(cmdline_value mem_service.object_share_access "$(cmdline_value mem_service_object_share_access cpu)")"
  size="$(cmdline_value mem_service.object_share_size "$(cmdline_value mem_service_object_share_size 4096)")"
  fault="$(cmdline_value mem_service.object_share_fault "$(cmdline_value mem_service_object_share_fault none)")"
  iterations="$(cmdline_value mem_service.object_share_iterations "$(cmdline_value mem_service_object_share_iterations 1)")"
  seed="$(cmdline_value mem_service.object_share_seed "$(cmdline_value mem_service_object_share_seed 41)")"
  port="$(cmdline_value mem_service.object_share_port "$(cmdline_value mem_service_object_share_port 12347)")"
  incarnation="$(cmdline_value mem_service.object_share_incarnation "$(cmdline_value mem_service_object_share_incarnation 7)")"
  address="$(cmdline_value mem_service.object_share_address "$(cmdline_value mem_service_object_share_address 17179869184)")"
  descriptor_hex="$(cmdline_value mem_service.object_share_descriptor_hex "$(cmdline_value mem_service_object_share_descriptor_hex '')")"
  connect="tcp:10.0.0.1:$port"

  if { [ "$access" != "cpu" ] && [ "$access" != "cpu-pto" ] &&
       [ "$access" != "cpu-reference" ] && [ "$access" != "cpu-retired" ] &&
       [ "$access" != "cpu-holder-recovery" ] &&
       [ "$access" != "cpu-recovery-fault" ]; } ||
      { [ "$access" = "cpu-pto" ] &&
        { [ "$backend" != "obmm" ] ||
          [ "$iterations" != "1" ] || [ "$fault" != "none" ]; }; }; then
    log "mem_service object-share: status=fail node=$node_idx reason=access_config"
    return 2
  fi
  if [ "$access" = "cpu-retired" ] &&
      { [ "$backend" != "obmm" ] || [ "$size" != "65536" ] ||
        [ "$iterations" != "1" ] || [ "$fault" != "none" ]; }; then
    log "mem_service object-share: status=fail node=$node_idx reason=retired_config"
    return 2
  fi
  if [ "$access" = "cpu-reference" ] &&
      { [ "$backend" != "obmm" ] || [ "$size" != "65536" ] || [ "$fault" != "none" ] ||
        ! mem_service_reference_iterations_valid "$iterations"; }; then
    log "mem_service object-share: status=fail node=$node_idx reason=reference_config"
    return 2
  fi
  if [ "$access" = "cpu-holder-recovery" ] &&
      { [ "$backend" != "obmm" ] || [ "$iterations" != "1" ] ||
        [ "$fault" != "none" ]; }; then
    log "mem_service object-share: status=fail node=$node_idx reason=holder_recovery_config"
    return 2
  fi
  if [ "$access" = "cpu-recovery-fault" ] &&
      { [ "$backend" != "obmm" ] || [ "$size" != "65536" ] ||
        [ "$iterations" != "1" ] ||
        ! mem_service_recovery_fault_supported "$fault"; }; then
    log "mem_service object-share: status=fail node=$node_idx reason=recovery_fault_config"
    return 2
  fi
  if [ "$access" != "cpu-recovery-fault" ] &&
      mem_service_recovery_fault_supported "$fault"; then
    log "mem_service object-share: status=fail node=$node_idx reason=recovery_fault_access"
    return 2
  fi
  if [ "$access" = "cpu-holder-recovery" ]; then
    case "$(cmdline_value lingqu_shmem_pto_layout cross-page):$(cmdline_value lingqu_shmem_pto_elements 64):$size" in
      cross-page:64:65536|nd:16384:262144|tail:16256:262144) ;;
      *)
        log "mem_service object-share: status=fail node=$node_idx reason=holder_recovery_geometry"
        return 2
        ;;
    esac
  fi
  if [ "$access" = "cpu-pto" ]; then
    case "$(cmdline_value lingqu_shmem_pto.home_node 0)" in
      0|1) ;;
      *) log "mem_service object-share: status=fail node=$node_idx reason=access_home"; return 2 ;;
    esac
    case "$(cmdline_value lingqu_shmem_pto_layout cross-page):$(cmdline_value lingqu_shmem_pto_elements 64):$size" in
      cross-page:64:65536|nd:16384:262144|tail:16256:262144) ;;
      *)
        log "mem_service object-share: status=fail node=$node_idx reason=access_geometry"
        return 2
        ;;
    esac
  fi

  if [ ! -x /bin/linqu_mem_service ]; then
    log "mem_service object-share: status=fail node=$node_idx role=unknown backend=$backend reason=cli_missing"
    return 2
  fi
  if [ "$node_count" != "2" ]; then
    log "mem_service object-share: status=fail node=$node_idx role=unknown backend=$backend reason=node_count"
    return 2
  fi
  if [ "$backend" != "loopback" ] && [ "$backend" != "obmm" ]; then
    log "mem_service object-share: status=fail node=$node_idx role=unknown backend=$backend reason=backend"
    return 2
  fi
  if [ "$backend" = "obmm" ]; then
    if [ -n "$descriptor_hex" ] ||
        { [ "$fault" != "none" ] && [ "$fault" != "sdk_contract" ] &&
          [ "$fault" != "map_conflict" ] && [ "$fault" != "descriptor_contract" ] &&
          [ "$fault" != "capacity" ] && [ "$fault" != "address_capacity" ] &&
          [ "$fault" != "backing_capacity" ] && [ "$fault" != "allocation_pressure" ] &&
          ! mem_service_recovery_fault_supported "$fault"; } ||
        { { [ "$fault" = "capacity" ] || [ "$fault" = "address_capacity" ] ||
            [ "$fault" = "backing_capacity" ] || [ "$fault" = "allocation_pressure" ]; } &&
          [ "$iterations" != "1" ]; }; then
      log "mem_service object-share: status=fail node=$node_idx backend=obmm reason=unsupported_config"
      return 2
    fi
    if ! mem_service_object_share_managed "$node_idx" "$size" "$iterations" \
        "$seed" "$port" "$incarnation" "$fault" "$access"; then
      log "mem_service object-share: status=fail node=$node_idx backend=obmm reason=managed_session"
      return 1
    fi
    return 0
  fi

  case "$node_idx" in
    0)
      mem_service_object_share_run_provider "$backend" "$size" "$iterations" \
        "$port" "$incarnation" "$address" "$descriptor_hex" "$connect"
      return $?
      ;;
    1)
      mem_service_object_share_run_consumer "$backend" "$size" "$fault" \
        "$iterations" "$seed" "$connect"
      return $?
      ;;
    *)
      log "mem_service object-share: status=fail node=$node_idx role=unknown backend=$backend reason=node_index"
      return 2
      ;;
  esac
}

