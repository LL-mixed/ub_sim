    run_binary "linqu_mem_service_alert_fixtures" /bin/linqu_mem_service alert-fixtures || rc=$?
    run_binary "linqu_mem_service_alert_integration_fixtures" /bin/linqu_mem_service alert-integration-fixtures || rc=$?
    run_binary "linqu_mem_service_ops_certification_fixtures" /bin/linqu_mem_service ops-certification-fixtures || rc=$?
    run_binary "linqu_mem_service_ops_certification_evidence_fixtures" /bin/linqu_mem_service ops-certification-evidence-fixtures || rc=$?
    run_binary "linqu_mem_service_client_retry_fixtures" /bin/linqu_mem_service client-retry-fixtures || rc=$?
    run_binary "linqu_mem_service_api_abi_fixtures" /bin/linqu_mem_service api-abi-fixtures || rc=$?
    run_binary "linqu_mem_service_compat_fixtures" /bin/linqu_mem_service compat-fixtures || rc=$?
    run_binary "linqu_mem_service_compat_baseline_fixtures" /bin/linqu_mem_service compat-baseline-fixtures || rc=$?
    run_binary "linqu_mem_service_compat_old_new_fixtures" /bin/linqu_mem_service compat-old-new-fixtures || rc=$?
    run_binary "linqu_mem_service_package_fixtures" /bin/linqu_mem_service package-fixtures || rc=$?
    run_binary "linqu_mem_service_release_fixtures" /bin/linqu_mem_service release-fixtures || rc=$?
    ran_any="1"
  fi

  if has_flag "linqu_llm_infer=1"; then
    run_llm_infer || rc=$?
    ran_any="1"
  fi

  if [ "$rc" -ne 0 ]; then
    return "$rc"
  fi

  if [ "$ran_any" = "0" ]; then
    log "no app flags matched; nothing to run"
  fi

  return 0
}

run_single_action() {
  case "$1" in
    probe)
      run_binary "linqu_probe" /bin/linqu_probe
      ;;
    chat)
      run_binary "linqu_ub_chat" /bin/linqu_ub_chat
      ;;
    rpc)
      run_binary "linqu_ub_rpc" /bin/linqu_ub_rpc
      ;;
    tcp)
      run_binary "linqu_ub_tcp_each_server" /bin/linqu_ub_tcp_each_server
      ;;
    udma)
      run_binary "linqu_ub_udma" /bin/linqu_ub_udma
      ;;
    obmm_pool)
      run_obmm_pool
      ;;
    obmm_queue)
      run_obmm_queue
      ;;
    obmm_import_stress)
      run_obmm_import_stress
      ;;
    obmm_dataplane_microbench)
      run_obmm_dataplane_microbench
      ;;
    obmm_coh_test)
      run_obmm_coh_test
      ;;
    gva_manager)
      run_gva_manager
      ;;
    gva_direct)
      run_gva_direct
      ;;
    obmm_gsva)
      run_obmm_gsva
      ;;
    gsva_query)
      run_gsva_query
      ;;
    npu_test)
      run_binary "npu_test" /bin/npu_test
      ;;
    npu_gsva_test)
      run_binary "npu_gsva_test" /bin/npu_gsva_test
      ;;
    ssd_test)
      run_binary "ssd_test" /bin/ssd_test
      ;;
    ssd_gsva_test)
      run_binary "ssd_gsva_test" /bin/ssd_gsva_test
      ;;
    mem_service)
      run_binary "linqu_mem_service" /bin/linqu_mem_service --smoke &&
      run_binary "linqu_mem_service_wire_fixtures" /bin/linqu_mem_service wire-fixtures &&
      run_binary "linqu_mem_service_wire_schema_fixtures" /bin/linqu_mem_service wire-schema-fixtures &&
      run_binary "linqu_mem_service_store_fixtures" /bin/linqu_mem_service store-fixtures &&
      run_binary "linqu_mem_service_journal_fixtures" /bin/linqu_mem_service journal-fixtures &&
      run_binary "linqu_mem_service_config_fixtures" /bin/linqu_mem_service config-fixtures &&
      run_binary "linqu_mem_service_runtime_quota_fixtures" /bin/linqu_mem_service runtime-quota-fixtures &&
      run_binary "linqu_mem_service_retention_fixtures" /bin/linqu_mem_service retention-fixtures &&
      run_binary "linqu_mem_service_checkpoint_retention_fixtures" /bin/linqu_mem_service checkpoint-retention-fixtures &&
      run_binary "linqu_mem_service_payload_gc_fixtures" /bin/linqu_mem_service payload-gc-fixtures &&
      run_binary "linqu_mem_service_record_retention_fixtures" /bin/linqu_mem_service record-retention-fixtures &&
      run_binary "linqu_mem_service_encryption_fixtures" /bin/linqu_mem_service encryption-fixtures &&
      run_binary "linqu_mem_service_metrics_export_fixtures" /bin/linqu_mem_service metrics-export-fixtures &&
      run_binary "linqu_mem_service_collector_fixtures" /bin/linqu_mem_service collector-fixtures &&
      run_binary "linqu_mem_service_deployment_fixtures" /bin/linqu_mem_service deployment-fixtures &&
      run_binary "linqu_mem_service_admin_output_fixtures" /bin/linqu_mem_service admin-output-fixtures &&
      run_binary "linqu_mem_service_upgrade_rollback_fixtures" /bin/linqu_mem_service upgrade-rollback-fixtures &&
      run_binary "linqu_mem_service_alert_fixtures" /bin/linqu_mem_service alert-fixtures &&
      run_binary "linqu_mem_service_alert_integration_fixtures" /bin/linqu_mem_service alert-integration-fixtures &&
      run_binary "linqu_mem_service_ops_certification_fixtures" /bin/linqu_mem_service ops-certification-fixtures &&
      run_binary "linqu_mem_service_ops_certification_evidence_fixtures" /bin/linqu_mem_service ops-certification-evidence-fixtures &&
      run_binary "linqu_mem_service_client_retry_fixtures" /bin/linqu_mem_service client-retry-fixtures &&
      run_binary "linqu_mem_service_api_abi_fixtures" /bin/linqu_mem_service api-abi-fixtures &&
      run_binary "linqu_mem_service_compat_fixtures" /bin/linqu_mem_service compat-fixtures &&
      run_binary "linqu_mem_service_compat_baseline_fixtures" /bin/linqu_mem_service compat-baseline-fixtures &&
      run_binary "linqu_mem_service_compat_old_new_fixtures" /bin/linqu_mem_service compat-old-new-fixtures &&
      run_binary "linqu_mem_service_package_fixtures" /bin/linqu_mem_service package-fixtures &&
      run_binary "linqu_mem_service_release_fixtures" /bin/linqu_mem_service release-fixtures
      ;;
    mem_service_qwen3)
      run_binary "linqu_mem_service_qwen3" /bin/linqu_mem_service_qwen3 --inspect-qwen3
      ;;
    llm_infer)
      run_llm_infer
      ;;
    gsva_coh_test)
      gsva_test_mode=""
      read_cmdline
      for a in $cmdline; do
        case "$a" in
          gsva_test_mode=*) gsva_test_mode="${a#gsva_test_mode=}" ;;
        esac
      done
      run_binary "linqu_ub_gsva_coh_test" /bin/linqu_ub_gsva_coh_test --mode "${gsva_test_mode:-all}"
      ;;
    gsva_lifecycle_test)
      gsva_test_mode=""
      read_cmdline
      for a in $cmdline; do
        case "$a" in
          gsva_test_mode=*) gsva_test_mode="${a#gsva_test_mode=}" ;;
        esac
      done
      run_binary "linqu_ub_gsva_lifecycle_test" /bin/linqu_ub_gsva_lifecycle_test --mode "${gsva_test_mode:-all}"
      ;;
    gsva_query)
      gsva_query_mode="--caps"
      read_cmdline
      for a in $cmdline; do
        case "$a" in
          gsva_query_mode=*) gsva_query_mode="--${a#gsva_query_mode=}" ;;
        esac
      done
      run_binary "linqu_ub_gsva_query" /bin/linqu_ub_gsva_query "$gsva_query_mode"
      ;;
    all)
      run_default_actions
      ;;
    shell)
      if [ -x /bin/busybox ]; then
        exec /bin/busybox sh
      fi
      if [ -x /bin/sh ]; then
        exec /bin/sh
      fi
      return 1
      ;;
    *)
      log "unknown action: $1"
      return 1
      ;;
  esac
}

enter_shell() {
  if [ -x /bin/busybox ]; then
    exec /bin/busybox sh
  fi
  if [ -x /bin/sh ]; then
    exec /bin/sh
  fi
  log "no shell available (busybox missing)"
  return 1
}

bootstrap_fs

if [ "${UB_RUN_APP_FROM_INIT:-0}" != "1" ] && [ "${1-}" != "--resume" ]; then
  log "bootstrap phase: launching /bin/linqu_init"
  UB_RUN_APP_FROM_INIT=1
  export UB_RUN_APP_FROM_INIT
  exec /bin/linqu_init "$@"
fi

shift_args=0
if [ "${1-}" = "--resume" ]; then
  shift_args=1
fi

if [ "$shift_args" = "1" ]; then
  shift
fi

if [ "$#" -gt 0 ]; then
  for action in "$@"; do
    if ! run_single_action "$action"; then
      log "action failed: $action"
      exit 1
    fi
  done
else
  if ! run_default_actions; then
    exit 1
  fi
fi

log "entering interactive shell"
enter_shell
