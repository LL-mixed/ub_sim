  export SIM_QWEN3_GUEST_DECODE_STEP=0
  export SIM_QWEN3_GUEST_DECODE_STEPS="$decode_steps"

  run_binary "linqu_llm_infer" /bin/linqu_llm_infer
}

run_llm_infer_mem_service() {
  local socket="/tmp/linqu_llm_infer_mem_service.sock"
  local store="/tmp/linqu_llm_infer_mem_service.store"
  local pid=""
  local i=""

  /bin/busybox rm -f "$socket" "$store" "$store.journal"
  log "start linqu_mem_service for linqu_llm_infer"
  /bin/linqu_mem_service serve --listen "unix:$socket" --store "$store" \
    >/tmp/linqu_llm_infer_mem_service.daemon.stdout \
    2>/tmp/linqu_llm_infer_mem_service.daemon.stderr &
  pid=$!

  i=0
  while ! /bin/linqu_mem_service ready --connect "unix:$socket" >/dev/null 2>&1; do
    if ! kill -0 "$pid" >/dev/null 2>&1; then
      cat /tmp/linqu_llm_infer_mem_service.daemon.stderr >&2 || true
      log "linqu_mem_service exited before ready"
      return 1
    fi
    i=$((i + 1))
    if [ "$i" -ge 100 ]; then
      cat /tmp/linqu_llm_infer_mem_service.daemon.stderr >&2 || true
      log "linqu_mem_service did not become ready"
      kill "$pid" >/dev/null 2>&1 || true
      wait "$pid" >/dev/null 2>&1 || true
      return 1
    fi
    sleep 0.05
  done

  run_binary "linqu_llm_infer_mem_service_publish" \
    /bin/linqu_llm_infer --mem-service-serving-publish "unix:$socket" || {
    kill "$pid" >/dev/null 2>&1 || true
    wait "$pid" >/dev/null 2>&1 || true
    return 1
  }

  kill "$pid" >/dev/null 2>&1 || true
  wait "$pid" >/dev/null 2>&1 || true

  log "restart linqu_mem_service for linqu_llm_infer verify"
  /bin/busybox rm -f "$socket"
  /bin/linqu_mem_service serve --listen "unix:$socket" --store "$store" \
    >/tmp/linqu_llm_infer_mem_service.restart.stdout \
    2>/tmp/linqu_llm_infer_mem_service.restart.stderr &
  pid=$!

  i=0
  while ! /bin/linqu_mem_service ready --connect "unix:$socket" >/dev/null 2>&1; do
    if ! kill -0 "$pid" >/dev/null 2>&1; then
      cat /tmp/linqu_llm_infer_mem_service.restart.stderr >&2 || true
      log "restarted linqu_mem_service exited before ready"
      return 1
    fi
    i=$((i + 1))
    if [ "$i" -ge 100 ]; then
      cat /tmp/linqu_llm_infer_mem_service.restart.stderr >&2 || true
      log "restarted linqu_mem_service did not become ready"
      kill "$pid" >/dev/null 2>&1 || true
      wait "$pid" >/dev/null 2>&1 || true
      return 1
    fi
    sleep 0.05
  done

  run_binary "linqu_llm_infer_mem_service_verify" \
    /bin/linqu_llm_infer --mem-service-serving-verify "unix:$socket" || {
    kill "$pid" >/dev/null 2>&1 || true
    wait "$pid" >/dev/null 2>&1 || true
    return 1
  }

  kill "$pid" >/dev/null 2>&1 || true
  wait "$pid" >/dev/null 2>&1 || true
  log "linqu_llm_infer mem_service publish restart verify done"
  return 0
}

