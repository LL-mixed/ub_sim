run_binary() {
  local name="$1"
  local path="$2"
  shift 2

  if [ ! -x "$path" ]; then
    log "missing executable: $path"
    return 0
  fi

  log "run $name"
  "$path" "$@"
  local rc=$?
  if [ "$rc" -eq 0 ]; then
    log "$name done"
    return 0
  fi

  log "$name failed rc=$rc"
  return "$rc"
}

