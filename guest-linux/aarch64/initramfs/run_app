    echo "op=release key=$key idempotency_key=ref-release-$round expected_generation=$generation"
    echo "op=allocate key=$ready idempotency_key=ref-ready-$round size_bytes=65536 capabilities=map"
    echo "op=wait_state key=$done state=active timeout_ms=60000 poll_ms=50"
    for retired in "$key" "$ready" "ref-checked-$round" "$done"; do
      echo "op=retire key=$retired idempotency_key=retire-$retired"
      echo "op=wait_state key=$retired state=retired timeout_ms=60000 poll_ms=50"
    done
