run_default_actions() {
  local ran_any="0"
  local rc=0

  if ! has_flag "linqu_probe_skip=1"; then
    run_binary "linqu_probe" /bin/linqu_probe || rc=$?
    ran_any="1"
  fi

  if has_flag "linqu_ub_chat=1"; then
    run_binary "linqu_ub_chat" /bin/linqu_ub_chat || rc=$?
    ran_any="1"
  fi

  if has_flag "linqu_ub_rpc=1" || has_flag "linqu_ub_rpc_demo=1"; then
    run_binary "linqu_ub_rpc" /bin/linqu_ub_rpc || rc=$?
    ran_any="1"
  fi

  if has_flag "linqu_ub_tcp_each_server_demo=1"; then
    run_binary "linqu_ub_tcp_each_server" /bin/linqu_ub_tcp_each_server || rc=$?
    ran_any="1"
  fi

  if has_flag "linqu_ub_udma=1" || has_flag "linqu_ub_udma_demo=1"; then
    run_binary "linqu_ub_udma" /bin/linqu_ub_udma || rc=$?
    ran_any="1"
  fi

  if has_flag "linqu_obmm_demo=1"; then
    run_binary "linqu_ub_obmm_demo" /bin/linqu_ub_obmm_demo || rc=$?
    ran_any="1"
  fi

  if has_flag "linqu_obmm_queue=1" || has_flag "linqu_obmm_queue_demo=1"; then
    run_obmm_queue || rc=$?
    ran_any="1"
  fi

  if has_flag "linqu_gva_manager=1"; then
    run_gva_manager_bootstrap || rc=$?
    ran_any="1"
  fi

  if has_flag "linqu_gva_dump_routes=1"; then
    run_gva_manager_dump_routes || rc=$?
    ran_any="1"
  fi

  if has_flag "linqu_gva_direct=1" || has_flag "linqu_gva_direct_demo=1"; then
    run_gva_direct || rc=$?
    ran_any="1"
  fi

  if has_flag "linqu_obmm_gsva=1" || has_flag "linqu_obmm_gsva_demo=1"; then
    run_obmm_gsva || rc=$?
    ran_any="1"
  fi

  if [ "$rc" -ne 0 ]; then
    return "$rc"
  fi

  if [ "$ran_any" = "0" ]; then
    log "no demo flags matched; nothing to run"
  fi

  return 0
}

run_single_action() {
  case "$1" in
    probe)
      run_binary "linqu_probe" /bin/linqu_probe
      ;;
    chat)
      run_binary "linqu_ub_chat" /bin/linqu_ub_chat
      ;;
    rpc)
      run_binary "linqu_ub_rpc" /bin/linqu_ub_rpc
      ;;
    tcp)
      run_binary "linqu_ub_tcp_each_server" /bin/linqu_ub_tcp_each_server
      ;;
    udma)
      run_binary "linqu_ub_udma" /bin/linqu_ub_udma
      ;;
    obmm)
      run_binary "linqu_ub_obmm_demo" /bin/linqu_ub_obmm_demo
      ;;
    obmm_queue|obmm_queue_demo)
      run_obmm_queue
      ;;
    obmm_import_stress)
      run_obmm_import_stress
      ;;
    obmm_dataplane_microbench)
      run_obmm_dataplane_microbench
      ;;
    obmm_coh_test)
      run_obmm_coh_test
      ;;
    gva_manager_bootstrap)
      run_gva_manager_bootstrap
      ;;
    gva_manager_dump_routes)
      run_gva_manager_dump_routes
      ;;
    gva_manager_segment_cli)
      run_gva_manager_segment_cli
      ;;
    gva_direct|gva_direct_demo)
      run_gva_direct
      ;;
    obmm_gsva|obmm_gsva_demo)
      run_obmm_gsva
      ;;
    npu_test)
      run_binary "npu_test" /bin/npu_test
      ;;
    npu_gsva_test)
      run_binary "npu_gsva_test" /bin/npu_gsva_test
      ;;
    ssd_test)
      run_binary "ssd_test" /bin/ssd_test
      ;;
    ssd_gsva_test)
      run_binary "ssd_gsva_test" /bin/ssd_gsva_test
      ;;
    gsva_coh_test)
      gsva_test_mode=""
      read_cmdline
      for a in $cmdline; do
        case "$a" in
          gsva_test_mode=*) gsva_test_mode="${a#gsva_test_mode=}" ;;
        esac
      done
      run_binary "linqu_ub_gsva_coh_test" /bin/linqu_ub_gsva_coh_test --mode "${gsva_test_mode:-all}"
      ;;
    gsva_lifecycle_test)
      gsva_test_mode=""
      read_cmdline
      for a in $cmdline; do
        case "$a" in
          gsva_test_mode=*) gsva_test_mode="${a#gsva_test_mode=}" ;;
        esac
      done
      run_binary "linqu_ub_gsva_lifecycle_test" /bin/linqu_ub_gsva_lifecycle_test --mode "${gsva_test_mode:-all}"
      ;;
    gsva_query)
      gsva_query_mode="--caps"
      read_cmdline
      for a in $cmdline; do
        case "$a" in
          gsva_query_mode=*) gsva_query_mode="--${a#gsva_query_mode=}" ;;
        esac
      done
      run_binary "linqu_ub_gsva_query" /bin/linqu_ub_gsva_query "$gsva_query_mode"
      ;;
    all)
      run_default_actions
      ;;
    shell)
      if [ -x /bin/busybox ]; then
        exec /bin/busybox sh
      fi
      if [ -x /bin/sh ]; then
        exec /bin/sh
      fi
      return 1
      ;;
    *)
      log "unknown action: $1"
      return 1
      ;;
  esac
}

enter_shell() {
  if [ -x /bin/busybox ]; then
    exec /bin/busybox sh
  fi
  if [ -x /bin/sh ]; then
    exec /bin/sh
  fi
  log "no shell available (busybox missing)"
  return 1
}

bootstrap_fs

if [ "${UB_RUN_DEMO_FROM_INIT:-0}" != "1" ] && [ "${1-}" != "--resume" ]; then
  log "bootstrap phase: launching /bin/linqu_init"
  UB_RUN_DEMO_FROM_INIT=1
  export UB_RUN_DEMO_FROM_INIT
  exec /bin/linqu_init "$@"
fi

shift_args=0
if [ "${1-}" = "--resume" ]; then
  shift_args=1
fi

if [ "$shift_args" = "1" ]; then
  shift
fi

if [ "${UB_RUN_DEMO_FROM_INIT:-0}" = "1" ] && [ "$#" -eq 0 ]; then
  log "boot flow completed, dropping to shell"
  enter_shell
fi

if [ "$#" -gt 0 ]; then
  for action in "$@"; do
    if ! run_single_action "$action"; then
      log "action failed: $action"
      exit 1
    fi
  done
else
  if ! run_default_actions; then
    exit 1
  fi
fi

log "entering interactive shell"
enter_shell
