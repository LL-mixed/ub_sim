  if has_flag "linqu_obmm_queue_demo=1"; then
    run_binary "linqu_ub_obmm_queue_demo" /bin/linqu_ub_obmm_queue_demo || rc=$?
    ran_any="1"
  fi

  if has_flag "linqu_gva_manager=1"; then
    run_gva_manager_bootstrap || rc=$?
    ran_any="1"
  fi

  if has_flag "linqu_gva_dump_routes=1"; then
    run_gva_manager_dump_routes || rc=$?
    ran_any="1"
  fi

  if has_flag "linqu_gva_direct_demo=1"; then
    run_gva_direct_demo || rc=$?
    ran_any="1"
  fi

  if has_flag "linqu_obmm_gsva_demo=1"; then
    run_obmm_gsva_demo || rc=$?
    ran_any="1"
  fi

  if [ "$rc" -ne 0 ]; then
    return "$rc"
  fi

  if [ "$ran_any" = "0" ]; then
    log "no demo flags matched; nothing to run"
  fi

  return 0
}

run_single_action() {
  case "$1" in
    probe)
      run_binary "linqu_probe" /bin/linqu_probe
      ;;
    chat)
      run_binary "linqu_ub_chat" /bin/linqu_ub_chat
      ;;
    rpc)
      run_binary "linqu_ub_rpc" /bin/linqu_ub_rpc
      ;;
    tcp)
      run_binary "linqu_ub_tcp_each_server" /bin/linqu_ub_tcp_each_server
      ;;
    udma)
      run_binary "linqu_ub_udma_demo" /bin/linqu_ub_udma_demo
      ;;
    obmm)
      run_binary "linqu_ub_obmm_demo" /bin/linqu_ub_obmm_demo
      ;;
    obmm_queue)
      run_binary "linqu_ub_obmm_queue_demo" /bin/linqu_ub_obmm_queue_demo
      ;;
    obmm_import_stress)
      run_obmm_import_stress
      ;;
    obmm_coh_test)
      run_obmm_coh_test
      ;;
    gva_manager_bootstrap)
      run_gva_manager_bootstrap
      ;;
    gva_manager_dump_routes)
      run_gva_manager_dump_routes
      ;;
    gva_direct_demo)
      run_gva_direct_demo
      ;;
    obmm_gsva_demo)
      run_obmm_gsva_demo
      ;;
    gsva_coh_test)
      gsva_test_mode=gsva_test_mode=
      for a in $cmdline; do
        case "$a" in
          gsva_test_mode=*) gsva_test_mode="$a" ;;
        esac
      done
      run_binary "linqu_ub_gsva_coh_test" /bin/linqu_ub_gsva_coh_test --mode "${gsva_test_mode#gsva_test_mode=}"
      ;;
    gsva_lifecycle_test)
      gsva_test_mode=gsva_test_mode=
      for a in $cmdline; do
        case "$a" in
          gsva_test_mode=*) gsva_test_mode="$a" ;;
        esac
      done
      run_binary "linqu_ub_gsva_lifecycle_test" /bin/linqu_ub_gsva_lifecycle_test --mode "${gsva_test_mode#gsva_test_mode=}"
      ;;
    all)
      run_default_actions
      ;;
    shell)
      if [ -x /bin/busybox ]; then
        exec /bin/busybox sh
      fi
      if [ -x /bin/sh ]; then
        exec /bin/sh
      fi
      return 1
      ;;
    *)
      log "unknown action: $1"
      return 1
      ;;
  esac
}

enter_shell() {
  if [ -x /bin/busybox ]; then
    exec /bin/busybox sh
  fi
  if [ -x /bin/sh ]; then
    exec /bin/sh
  fi
  log "no shell available (busybox missing)"
  return 1
}

bootstrap_fs

if [ "${UB_RUN_DEMO_FROM_INIT:-0}" != "1" ] && [ "${1-}" != "--resume" ]; then
  log "bootstrap phase: launching /bin/linqu_init"
  UB_RUN_DEMO_FROM_INIT=1
  export UB_RUN_DEMO_FROM_INIT
  exec /bin/linqu_init "$@"
fi

shift_args=0
if [ "${1-}" = "--resume" ]; then
  shift_args=1
fi

if [ "$shift_args" = "1" ]; then
  shift
fi

if [ "${UB_RUN_DEMO_FROM_INIT:-0}" = "1" ] && [ "$#" -eq 0 ]; then
  log "boot flow completed, dropping to shell"
  enter_shell
fi

if [ "$#" -gt 0 ]; then
  for action in "$@"; do
    if ! run_single_action "$action"; then
      log "action failed: $action"
      exit 1
    fi
  done
else
  if ! run_default_actions; then
    exit 1
  fi
fi

log "entering interactive shell"
enter_shell
