run_default_actions() {
  local ran_any="0"
  local rc=0

  if ! has_flag "linqu_probe_skip=1"; then
    run_binary "linqu_probe" /bin/linqu_probe || rc=$?
    ran_any="1"
  fi

  if has_flag "linqu_ub_chat=1"; then
    run_binary "linqu_ub_chat" /bin/linqu_ub_chat || rc=$?
    ran_any="1"
  fi

  if has_flag "linqu_ub_rpc_demo=1"; then
    run_binary "linqu_ub_rpc" /bin/linqu_ub_rpc || rc=$?
    ran_any="1"
  fi

  if has_flag "linqu_ub_tcp_each_server_demo=1"; then
    run_binary "linqu_ub_tcp_each_server" /bin/linqu_ub_tcp_each_server || rc=$?
    ran_any="1"
  fi

  if has_flag "linqu_ub_udma_demo=1"; then
    run_binary "linqu_ub_udma_demo" /bin/linqu_ub_udma_demo || rc=$?
