#!/bin/busybox sh
set -u

log() {
  echo "[run_demo] $*"
}

mount_fs() {
  local fstype="$1"
  local target="$2"
  /bin/busybox mkdir -p "$target" >/dev/null 2>&1 || true
  /bin/busybox mount -t "$fstype" none "$target" >/dev/null 2>&1 || true
}

bootstrap_fs() {
  mount_fs proc /proc
  mount_fs sysfs /sys
  mount_fs devtmpfs /dev
  mount_fs devpts /dev/pts
}

read_cmdline() {
if [ -r /proc/cmdline ]; then
    cmdline="$(/bin/busybox cat /proc/cmdline)"
  else
    cmdline=""
  fi
}

has_flag() {
  local key="$1"
  read_cmdline
  case " $cmdline " in
    *" $key "*) return 0 ;;
    *) return 1 ;;
  esac
}

run_binary() {
  local name="$1"
  local path="$2"
  shift 2

  if [ ! -x "$path" ]; then
    log "missing executable: $path"
    return 0
  fi

  log "run $name"
  "$path" "$@"
  local rc=$?
  if [ "$rc" -eq 0 ]; then
    log "$name done"
    return 0
  fi

  log "$name failed rc=$rc"
  return "$rc"
}

